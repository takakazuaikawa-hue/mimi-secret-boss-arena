{
  "schemaVersion": 1,
  "id": "main.s1.w02",
  "kind": "opening",
  "title": "翌朝、名前が変わっている",
  "summary": "引継ぎ事故の翌朝。三つの扉と、勝手に点くオーナー手帳",
  "ownership": {
