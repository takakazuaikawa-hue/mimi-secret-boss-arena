      }
    ]
  },
  "nodes": [
    {
      "type": "direction",
      "id": "main.s1.w02.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "main.s1.w02.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "direction",
      "id": "main.s1.w02.node.direction.002",
      "command": {
        "type": "clearSprites"
      }
    },
    {
      "type": "direction",
      "id": "main.s1.w02.node.direction.mimi.opening",
      "command": {
        "type": "show",
        "assetId": "main.s1.w02.asset.sprite.mimi.confused",
        "actorId": "mimi",
        "slot": "left",
        "scale": "tall"
      }
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.001a",
      "lineId": "main.s1.w02.line.001a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "翌朝の受付、インクと紙の匂いが濃い。名札の隣に、真鍮の鍵がひと組。"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.001b",
      "lineId": "main.s1.w02.line.001b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "札の名前も、鍵の名前も、私。夜のうちに、書類が私に追いついてた。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.002a",
      "lineId": "main.s1.w02.line.002a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ゆうべの立ち会いを、何度も思い返す。マダムの返却手続き、「現場代理人」の欄、私の署名。"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.002b",
      "lineId": "main.s1.w02.line.002b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "三人とも、違う意味だと思っていた。誰も悪くないのに、名義だけが動いた。"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.003a",
      "lineId": "main.s1.w02.line.003a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「おはようございます、オーナーさん!」耳が、変な感じにぴくっと動いた。"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.003b",
      "lineId": "main.s1.w02.line.003b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "……その呼び方、心臓に悪い。"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.003c",
      "lineId": "main.s1.w02.line.003c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「今日、訂正しますからね」ノノさんは「はい!」と、気持ちいい返事をした。"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.003d",
      "lineId": "main.s1.w02.line.003d",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "小さく付け足す。「……書式、本社取り寄せなんですけど」",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.004a",
      "lineId": "main.s1.w02.line.004a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "マダムが朝一番で来た。「ごめんなさいねえ」とパンフを差し出す。"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.004b",
      "lineId": "main.s1.w02.line.004b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "表紙に、大きな金文字。『アットホームな闘技場経営権』。"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.004c",
      "lineId": "main.s1.w02.line.004c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "アットホームの根拠、どこにも書いてない。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.005a",
      "lineId": "main.s1.w02.line.005a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「宝くじの景品でねえ、返そうとしたら、こんなことに」"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.005b",
      "lineId": "main.s1.w02.line.005b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「……でもあなた、意外と似合うと思うのよ」似合うとかじゃ、ないんですよ、マダム。",
      "emotion": "comic"
    },
    {
      "type": "direction",
      "id": "main.s1.w02.node.direction.003",
      "command": {
        "type": "background",
        "assetId": "main.s1.w02.asset.background.002",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.006a",
      "lineId": "main.s1.w02.line.006a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "書式を待つあいだ、ノノさんが鍵の束を鳴らした。"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.006b",
      "lineId": "main.s1.w02.line.006b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「まず、現場を見ましょう」オーナーの管轄を、実物で教えてくれるらしい。"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.006c",
      "lineId": "main.s1.w02.line.006c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "一つ目の扉——選手の控室。長椅子と、砂の匂い。"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.006d",
      "lineId": "main.s1.w02.line.006d",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "今は、誰もいない。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.007a",
      "lineId": "main.s1.w02.line.007a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "二つ目、帳場。そろばんと、分厚い台帳。"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.007b",
      "lineId": "main.s1.w02.line.007b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「お金の出入りは、ぜんぶここです」台帳の最後の頁、見なかったことにしたい太さの数字。"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.007c",
      "lineId": "main.s1.w02.line.007c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "見なかったことにした。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.008a",
      "lineId": "main.s1.w02.line.008a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "……あれ、意外と分かる構造だ。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.009a",
      "lineId": "main.s1.w02.line.009a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "戻って、訂正の書式。三枚で、完璧だった。"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.009b",
      "lineId": "main.s1.w02.line.009b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "提出先の欄にこうある。「アルデバラン本社(片道五日)」受理は早くて数週間。"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.009c",
      "lineId": "main.s1.w02.line.009c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "私の派遣は、一日の予定だったのに。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.010a",
      "lineId": "main.s1.w02.line.010a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "帰り際、鞄の中で手帳が勝手に点いた。"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.010b",
      "lineId": "main.s1.w02.line.010b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "今日開けた扉の順に、頁が増えてる。「控室」"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.010c",
      "lineId": "main.s1.w02.line.010c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「帳場」「登録窓口——登録選手: 〇名」〇名。"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.010d",
      "lineId": "main.s1.w02.line.010d",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "選手がいなきゃ、興行はできない。私の最初の仕事、たぶんこれだ。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.011a",
      "lineId": "main.s1.w02.line.011a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "負債の頁だけ、数字の代わりに「照会中」とある。"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.011b",
      "lineId": "main.s1.w02.line.011b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ノノさん曰く「数字になるまで誰にも分かりません」とのこと。"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.011c",
      "lineId": "main.s1.w02.line.011c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "分からないことだけ正式な職場らしい。",
      "emotion": "comic"
    },
    {
      "type": "direction",
      "id": "main.s1.w02.node.direction.mimi.shift.012",
      "command": {
        "type": "show",
        "assetId": "main.s1.w02.asset.sprite.mimi.smile",
        "actorId": "mimi",
        "slot": "left",
        "scale": "tall"
      }
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.012a",
      "lineId": "main.s1.w02.line.012a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "帰り道、鍵が鞄の中で重かった。金物の重さじゃない気がする。"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.012b",
      "lineId": "main.s1.w02.line.012b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "気のせいってことにして、二回失敗した。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "main.s1.w02.node.line.013a",
      "lineId": "main.s1.w02.line.013a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "寮の枕元で、手帳がもう一度光った。「明日の予定: 詫びの来客(甘味あり)」……甘味?",
      "emotion": "tension"
    },
    {
      "type": "effect",
      "id": "main.s1.w02.node.effect.001",
      "effects": [
        {
          "type": "sharedPoints",
          "amount": 2
        }
      ]
    },
    {
      "type": "end",
      "id": "main.s1.w02.node.end.001",
      "mode": "return-to-week"
    }
  ],
