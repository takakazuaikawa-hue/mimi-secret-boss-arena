  "presentation": {
    "location": "契約保管庫",
    "assets": [
      {
        "id": "amara.power.asset.background.001",
        "kind": "background",
        "path": "/assets/story/bg-observation-deck-night.png",
        "alt": "契約保管庫の背景"
      }
