  "nodes": [
    {
      "type": "line",
      "id": "amara.power.node.line.001",
      "lineId": "amara.power.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "練習のあと、アマラに呼ばれて契約保管庫まで来た。いつもの力では足りない理由を、見せたいらしい。"
    },
    {
      "type": "line",
      "id": "amara.power.node.line.002",
      "lineId": "amara.power.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "警報より先に、相手の声が私の名を呼んだ。いつもと同じ呼び方なのに、その一音だけで足が止まる。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "amara.power.node.line.003",
      "lineId": "amara.power.line.003",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "法廷を模した訓練室で、天井から白い線が何百本も降りた。線の内側だけ、重力さえ証言を待っている。"
    },
    {
      "type": "line",
      "id": "amara.power.node.line.004",
      "lineId": "amara.power.line.004",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "神罰は規則違反へ下すものではない。規則が人を害した時に下す。"
    },
    {
      "type": "direction",
      "id": "amara.power.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "amara.power.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "direction",
      "id": "amara.power.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "flash"
      }
    },
    {
      "type": "line",
      "id": "amara.power.node.line.005",
      "lineId": "amara.power.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "彼女が異議を唱えると、重力や昨日の判決まで被告席へ呼び出される。そんな力が、目の前で息をしている。逃げる理由なら十分だった。それでも私は、力の大きさよりアマラが最初にどこを見るのかを確かめたかった。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "amara.power.node.line.006",
      "lineId": "amara.power.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "アマラが私と危険の間へ立つ。触れてはいない。それでも、こちらへ届くはずだった圧力だけがきれいに二つへ割れた。"
    },
    {
      "type": "line",
      "id": "amara.power.node.line.007",
      "lineId": "amara.power.line.007",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "私が本来裁くのは違反者ではない。正しさを名乗り、疑われることを拒んだ仕組みだ。"
    },
    {
      "type": "line",
      "id": "amara.power.node.line.008",
      "lineId": "amara.power.line.008",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "それ、会社に聞かれたら困るやつです。"
    },
    {
      "type": "line",
      "id": "amara.power.node.line.009",
      "lineId": "amara.power.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "どんな相手にも判決と根拠を崩さない裁定者。けれど今見せている力は、勝つためではなく、私を怖がらせないために抑えられている。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "amara.power.node.line.010",
      "lineId": "amara.power.line.010",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "この闘技場を裁いたら、建物ごと被告席へ入りませんか。"
    },
    {
      "type": "line",
      "id": "amara.power.node.line.011",
      "lineId": "amara.power.line.011",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "記録してください。聞かせるために言いました。"
    },
    {
      "type": "line",
      "id": "amara.power.node.line.012",
      "lineId": "amara.power.line.012",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "本気を見たいと思っていた。実際に目の前へ現れると、知りたかったのは強さではなく、その力を本人がどう恐れているかだった。"
    },
    {
      "type": "line",
      "id": "amara.power.node.line.013",
      "lineId": "amara.power.line.013",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "安心しろ。傍聴席は残す。あなたには最後まで見届けてもらう。"
    },
    {
      "type": "line",
      "id": "amara.power.node.line.014",
      "lineId": "amara.power.line.014",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "彼女が異議を唱えると、重力や昨日の判決まで被告席へ呼び出される。闘技場の安全基準は一瞬で役に立たなくなり、担当者は私の顔を見て計測を諦めた。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "amara.power.node.line.015",
      "lineId": "amara.power.line.015",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "世界を壊せることより、壊さないために何を選んだかが胸へ残った。彼女が探していたのは正解ではなく、結論を出せない自分の隣に残る相手だった。その理解が正しいか、いつか本人の言葉で確かめたい。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "amara.power.node.line.016",
      "lineId": "amara.power.line.016",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "力の中心にあったのは、正しさを守るために、目の前の一人の痛みを証拠へ変えてしまうこと。最強であることが、本人にとって一番古い傷なのだと分かる。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "amara.power.node.line.017",
      "lineId": "amara.power.line.017",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "怖さが消えたわけではない。だからこそ、使うかどうかを本人と決める必要がある。"
    },
    {
      "type": "line",
      "id": "amara.power.node.line.018",
      "lineId": "amara.power.line.018",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "大丈夫とは言えない。怖いものは怖い。それでも、次に力を使う時は一人で決めなくていいと伝えた。",
      "emotion": "resolve"
    },
    {
      "type": "line",
      "id": "amara.power.node.line.019",
      "lineId": "amara.power.line.019",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "箸袋の裏へ書かれた最初の異議申立てだけが元の大きさで残り、さっきまで世界の終わりがいた場所に、帰り道の灯りが戻った。"
    },
    {
      "type": "choice",
      "id": "amara.power.node.choice.001",
      "choices": [
        {
          "id": "amara.power.choice.001",
          "label": "古い天秤へ、アルデバラン社の契約原本を載せる",
          "result": "天秤は会社側へ傾き、そのまま机を突き抜けた。重かったのは紙ではなく、紙に従わせてきた年月だった。",
          "intent": "本来の力を一気に取り戻す",
          "promise": "失敗時の危険を引き受け、この人専用の成長を最大まで進める。",
          "memory": "力を恐れたまま任せたことを、相手は危機の場面で思い出す。",
          "tone": "heroic",
          "effects": [
            {
              "type": "relationship",
