      "id": "main.s3.w15.node.direction.001",
      "command": { "type": "background", "assetId": "main.s3.w15.asset.background.001", "transition": "dissolve" }
    },
    {
      "type": "direction",
      "id": "main.s3.w15.node.direction.002",
