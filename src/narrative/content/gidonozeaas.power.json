    {
      "type": "line",
      "id": "gidonozeaas.power.node.line.006",
      "lineId": "gidonozeaas.power.line.006",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "近づけたら、どうなりますか。"
