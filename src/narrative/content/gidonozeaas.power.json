      "speakerId": "legacy.speaker.1jmq03z",
      "speakerName": "ギドノゼアース",
      "mode": "dialogue",
      "text": "お前は、私が来ることより、私が来たせいで誰かが壊れることを恐れている。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "gidonozeaas.power.node.line.010",
      "lineId": "gidonozeaas.power.line.010",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "どっちも怖いです。普通に。"
    },
    {
      "type": "direction",
      "id": "gidonozeaas.power.node.direction.005",
      "command": {
        "type": "show",
        "assetId": "gidonozeaas.power.asset.sprite.003",
