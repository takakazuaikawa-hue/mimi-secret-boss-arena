                "type": "fighter",
                "fighterId": "gidonozeaas"
              },
              "amount": 5
            }
          ],
          "goto": "gidonozeaas.power.node.effect.001"
        },
        {
          "id": "gidonozeaas.power.choice.002",
          "label": "街を傷つけない出力まで測る",
          "result": "翼一枚ずつ、慎重に出力を測った。二枚で街灯が瞬き、三枚で雲が割れ、四枚で新人くんが「六枚は無理」と記録した。結論、試合では二枚まで。「残りは、あなたの傘にします」雨の日の約束が、一つ増えた。",
          "intent": "全力ではなく、安全な上限を決める",
          "promise": "本来の力は一部に留め、チーム全体の成長へ成果を持ち帰る。",
          "memory": "翼二枚の上限と、残り四枚の使い道を、チームは知っている。",
          "tone": "comic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "gidonozeaas"
              },
              "mode": "add",
              "trust": 0,
              "ownership": 9
            },
            {
              "type": "sharedPoints",
              "amount": 5
            }
          ],
          "goto": "gidonozeaas.power.node.effect.001"
        }
      ]
    },
    {
      "type": "effect",
      "id": "gidonozeaas.power.node.effect.001",
      "effects": [
        {
