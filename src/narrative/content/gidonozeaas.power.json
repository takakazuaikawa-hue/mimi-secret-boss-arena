      "id": "gidonozeaas.power.node.line.007",
      "lineId": "gidonozeaas.power.line.007",
      "speakerId": "legacy.speaker.1jmq03z",
      "speakerName": "ギドノゼアース",
      "mode": "dialogue",
      "text": "試合には勝つ。展望台と、その下の街が残るかは分からない。"
    },
    {
      "type": "line",
      "id": "gidonozeaas.power.node.line.008",
      "lineId": "gidonozeaas.power.line.008",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "冗談の声ではない。翼が閉じたあと、街の明かりが急に頼りなく見えた。"
    },
    {
      "type": "line",
      "id": "gidonozeaas.power.node.line.009",
