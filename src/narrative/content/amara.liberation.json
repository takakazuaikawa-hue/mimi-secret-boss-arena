{
  "schemaVersion": 1,
  "id": "amara.liberation",
  "kind": "liberation",
  "title": "解除届の適法性について",
  "summary": "自由になる書類ほど細かく読む人と、初めての「異議なし」",
  "ownership": {
    "arcId": "character.amara",
    "characterId": "amara",
    "stage": "liberation"
  },
