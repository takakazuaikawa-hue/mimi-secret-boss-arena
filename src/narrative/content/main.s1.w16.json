{
  "schemaVersion": 1,
  "id": "main.s1.w16",
  "kind": "opening",
  "title": "黄金ジャックポット杯、開演前",
  "summary": "夜の賭け興行。リハーサルの暴発と、闇の主の食レポ",
  "ownership": {
