  "presentation": {
    "location": "整備室",
    "assets": [
      {
        "id": "teirei.bond.asset.background.001",
        "kind": "background",
        "path": "/assets/story/bg-casino-cafe-rain.png",
        "alt": "整備室の背景"
      }
