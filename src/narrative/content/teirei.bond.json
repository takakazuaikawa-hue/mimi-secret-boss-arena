              },
              "amount": 3
            }
          ],
          "goto": "teirei.bond.node.effect.001"
        },
        {
          "id": "teirei.bond.choice.002",
          "label": "三人分の行動条件を、丁零と一緒に書き直す",
          "result": "命令表は短くなり、拒否条件だけが増えた。できないことが明確になるほど、できる動きは速くなった。",
          "intent": "チームの新しい連携を試す",
          "promise": "本人の流儀は崩すが、全員へ配れる成長ポイントを得る。",
          "memory": "成功した作戦と短くなった会話の両方が、次の判断まで残る。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "teirei"
              },
              "mode": "add",
