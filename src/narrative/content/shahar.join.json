    ],
    "when": {
      "all": [],
      "any": [],
      "none": []
    },
    "repeat": {
      "mode": "once-per-run"
    },
    "priority": 400,
    "weight": 1
  },
  "presentation": {
    "location": "配送ヤード",
    "assets": [
      {
        "id": "shahar.join.asset.background.001",
        "kind": "background",
