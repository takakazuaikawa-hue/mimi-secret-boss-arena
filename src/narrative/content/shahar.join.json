              },
              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "shahar",
              "decision": "join"
            }
          ],
          "goto": "shahar.join.node.end.001"
        },
        {
          "id": "shahar.join.choice.002",
          "label": "鱗一枚を選手、本体を応援席として登録する",
          "result": "出場は鱗一枚、本体は「応援席(上空)」として届け出た。大会運営から「応援の声量にご配慮ください」という通達が来たのは、三日後である。前例のない通達だが、まあ、前例のない応援席である。",
          "intent": "規定に収まる形で、確実に登録する",
          "promise": "本人の全力は温存し、誰にでも使える成長ポイントを得る。",
          "memory": "声量注意の通達を、シャハルは記念に額装したがっている。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "shahar"
              },
              "mode": "add",
              "trust": 0,
              "ownership": 8
            },
            {
              "type": "sharedPoints",
