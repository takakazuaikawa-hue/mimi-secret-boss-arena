{
  "schemaVersion": 1,
  "id": "shahar.join",
  "kind": "character",
  "title": "配送区分・古竜(一頭)",
  "summary": "選手登録のはずが、配送ヤードの伝票と戦うことになる",
  "ownership": {
    "arcId": "character.shahar",
    "characterId": "shahar",
