{
  "schemaVersion": 1,
  "id": "main.s1.w14",
  "kind": "opening",
  "title": "戻れるのに、戻らない",
  "summary": "名義の例外承認が、いまさら下りる。ミミは申請を取り下げる",
  "ownership": {
