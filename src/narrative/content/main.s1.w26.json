{
  "schemaVersion": 1,
  "id": "main.s1.w26",
  "kind": "opening",
  "title": "決勝、空の王者",
  "summary": "復興した闘技場の決勝の朝。制御された全開と、続きの一日",
  "ownership": {
    "arcId": "main.stage1"
  },
