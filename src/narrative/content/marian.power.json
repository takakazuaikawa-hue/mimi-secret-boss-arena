            }
          ],
          "goto": "marian.power.node.effect.001"
        },
        {
          "id": "marian.power.choice.002",
          "label": "傷だけを巻き戻し、命には触れない練習をする",
          "result": "奇跡は小さくなったが、誰も余分に生き返らなかった。試合で使える治療としては、その方がずっと偉かった。",
          "intent": "安全な段階解除で確実に進む",
          "promise": "本来の力は一部に留め、チーム全体の成長へ成果を持ち帰る。",
          "memory": "全員で帰ると決めた手順が、危機で使える安全策として残る。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
