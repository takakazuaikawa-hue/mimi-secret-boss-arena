              },
              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "rinne",
              "decision": "join"
            }
          ],
          "goto": "rinne.join.node.end.001"
        },
        {
          "id": "rinne.join.choice.002",
          "label": "契約金を最初の元手として渡す",
          "result": "「じゃあ、増やしてくる」——契約金は一時間で消え、閉店までに少し増えて戻った。領収書の日付は、なぜか来週。「未来の店で両替したから」だそうだ。経理課だけは最後まで信じなかった。正解だと思う。",
          "intent": "次の公式戦へ間に合わせる",
          "promise": "本人の詳細は後回しになるが、誰にでも使える成長ポイントを得る。",
          "memory": "先に席を確保した判断は、チームの始まり方として記録に残る。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "rinne"
              },
              "mode": "add",
              "trust": 0,
              "ownership": 8
            },
            {
              "type": "sharedPoints",
              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "rinne",
              "decision": "join"
            }
          ],
          "goto": "rinne.join.node.end.001"
        },
        {
          "id": "rinne.join.choice.003",
          "label": "今回はリンネを誘わず、別の機会を待つ",
          "result": "「今回は、見送りましょう」——リンネは頷いて、契約書を畳んだ。「その未来も見えてた。でも口で聞くと、ちょっと違う音がするね」と笑った。断られた人の顔じゃない。空のコインが、ポケットで小さく鳴った。",
          "intent": "今回はチームへ誘わない",
          "promise": "今回の所属は見送るが、人物の物語と再会の可能性は失わない。",
          "memory": "勧誘しない選択も尊重されたことを、相手は覚えている。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "recruitmentDecision",
