{
  "schemaVersion": 1,
  "id": "night-eater.bond",
  "kind": "character",
  "title": "明かり品評会の夜",
  "summary": "夜市の食べ歩きが、街を巻き込む祭りになる",
  "ownership": {
    "arcId": "character.night-eater",
    "characterId": "night-eater",
