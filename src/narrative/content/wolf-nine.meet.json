        { "type": "markEncountered", "fighterId": "wolf-nine", "encountered": true },
        { "type": "setStoryStage", "fighterId": "wolf-nine", "stage": 1 }
      ]
    },
    {
      "type": "end",
      "id": "wolf-nine.meet.node.end.001",
      "mode": "return-to-week"
    }
  ],
