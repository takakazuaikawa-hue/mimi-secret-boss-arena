  "nodes": [
    {
      "type": "direction",
      "id": "wolf-nine.meet.node.direction.001",
      "command": { "type": "background", "assetId": "wolf-nine.meet.asset.background.001", "transition": "dissolve" }
    },
    {
      "type": "line",
      "id": "wolf-nine.meet.node.line.001",
      "lineId": "wolf-nine.meet.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "郵便受取所の応援当番の日。窓口係さんから、申し送りがあった。「毎週金曜、耳の立派なお客様が来ます。受け取るのは、毎回同じ八通です」。"
    },
    {
      "type": "line",
      "id": "wolf-nine.meet.node.line.002",
      "lineId": "wolf-nine.meet.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "金曜の午後、その人は来た。狼の耳、旗みたいに立派なマント、封蝋の匂い。カウンターに置かれた「お受け取り」は、宛先不明で戻ってきた手紙、八通。全部、几帳面な封蝋つきの——挑戦状だった。",
      "emotion": "tension"
    },
    {
      "type": "direction",
      "id": "wolf-nine.meet.node.direction.002",
      "command": { "type": "still", "assetId": "wolf-nine.meet.asset.still.001" }
    },
    {
      "type": "direction",
      "id": "wolf-nine.meet.node.direction.003",
      "command": { "type": "effect", "effectId": "pulse" }
    },
    {
      "type": "line",
      "id": "wolf-nine.meet.node.line.003",
      "lineId": "wolf-nine.meet.line.003",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "確認する。八通、全部戻ったな？　……よし。今週も、全員不在か。"
    },
    {
      "type": "line",
      "id": "wolf-nine.meet.node.line.004",
      "lineId": "wolf-nine.meet.line.004",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "あの、これ、毎週出して毎週戻ってるんですよね。宛先の方々は、その……"
    },
    {
      "type": "line",
      "id": "wolf-nine.meet.node.line.005",
      "lineId": "wolf-nine.meet.line.005",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "俺の生涯戦績は、八戦八敗だ。八人の強敵に、八回負けた。……再戦を誓った頃には、あいつらの物語は、全部終わっていた。国ごと、伝説ごと、地図ごとな。"
    },
    {
      "type": "line",
      "id": "wolf-nine.meet.node.line.006",
      "lineId": "wolf-nine.meet.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "宛先不明の意味が、重かった。八人のライバルは、もうこの世のどの住所にもいない。それでも彼は毎週、挑戦状を書いて、出して、戻ってきたのを確認しに来る。それが彼の、再戦の続け方だった。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "wolf-nine.meet.node.line.007",
      "lineId": "wolf-nine.meet.line.007",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "笑っていいぞ。宛先のない手紙を出し続ける狼だ。……だが、出すのをやめたら、俺の八敗が、ただの負けっぱなしになる。"
    },
    {
      "type": "line",
      "id": "wolf-nine.meet.node.line.008",
      "lineId": "wolf-nine.meet.line.008",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "笑えなかった。代わりに、受取所の中で一番きれいな消印を、八通ぶん、切手の横にそっと押し直した。「本日も、確かにお預かりしました」の判だ。彼の耳が、ぴんと立った。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "wolf-nine.meet.node.line.009",
      "lineId": "wolf-nine.meet.line.009",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "……いい判の押し方だ。真剣勝負の音がした。あんた、名前は。"
    },
    {
      "type": "line",
      "id": "wolf-nine.meet.node.line.010",
      "lineId": "wolf-nine.meet.line.010",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "判の押し方で真剣勝負を見抜く人に、私は初めて会った。聞けば、彼の世界ではすべてが勝負であるらしい。便箋選びも、封蝋の温度も、席取りも、朝食も。真剣に競うことが、彼の礼儀で、彼の愛情表現なのだ。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "wolf-nine.meet.node.line.011",
      "lineId": "wolf-nine.meet.line.011",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "実はな、九通目を書きたいんだ。九戦目の挑戦状を。……だが、宛先がいない。この時代に、俺と真剣に競ってくれる奴の住所を、俺は知らない。"
    },
    {
      "type": "line",
      "id": "wolf-nine.meet.node.line.012",
      "lineId": "wolf-nine.meet.line.012",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "九通目の宛先。心当たりなら、なくもない。うちの闘技場は、真剣に競いたい規格外の巣窟である。窓口で、続きの話をするかどうかだ。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "wolf-nine.meet.node.choice.001",
      "choices": [
        {
          "id": "wolf-nine.meet.choice.001",
          "label": "八通分の挑戦状へ返事を書く",
          "result": "「宛先の代わりに、返事を書きませんか。八人ぶん」。彼は目を丸くした。私たちは閉店後の受取所で、八人のライバルになったつもりで、返事を書いた。彼が語る八人の口癖、決め台詞、負けず嫌いの度合いを聞きながら。八通目の返事を書き終えた時、彼は静かに言った。「……全員、こういう返事を書く奴らだった。あんた、代筆の天才だな」。八敗が、八つの思い出になった夜だった。",
          "intent": "戻ってきた手紙に、行き先を作る",
          "promise": "目先の報酬は得ない代わりに、この人が何を待っていたかを知る。",
          "memory": "八通の返事の代筆を、ヴォルフは「九戦目の前哨戦」と呼ぶ。",
          "tone": "tender",
          "effects": [
            { "type": "relationship", "target": { "type": "fighter", "fighterId": "wolf-nine" }, "mode": "add", "trust": 7, "ownership": -2 }
          ],
          "goto": "wolf-nine.meet.node.effect.001"
        },
        {
          "id": "wolf-nine.meet.choice.002",
          "label": "今日はヴォルフ・ナインを誘わず、用事へ戻る",
          "result": "八通を渡して、業務へ戻った。翌週の金曜、受取所に私宛ての封書が一通届いていた。立派な封蝋つき。中身は挑戦状——ではなく、果たし状みたいな筆致の礼状だった。「先週の消印の押し方、見事だった。次は俺が、受け取りの作法で勝つ」。受け取りの作法で勝負を挑まれたのは、受取所史上初だという。",
          "intent": "今日は窓口業務に徹する",
          "promise": "所属選手にはならないが、後の出来事で再会できる。",
          "memory": "果たし状みたいな礼状を、受取所が記念に飾りたがっている。",
          "tone": "pragmatic",
          "effects": [],
          "goto": "wolf-nine.meet.node.effect.001"
        }
      ]
    },
    {
      "type": "effect",
      "id": "wolf-nine.meet.node.effect.001",
