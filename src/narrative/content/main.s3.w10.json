{
  "schemaVersion": 1,
  "id": "main.s3.w10",
  "kind": "opening",
  "title": "値札の街",
  "summary": "数えごとが街へ出て、焼き餅屋の鉄板に値段が付く",
  "ownership": {
    "arcId": "main.stage3"
  },
