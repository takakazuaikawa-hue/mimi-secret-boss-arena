              "target": {
                "type": "fighter",
                "fighterId": "mumyo"
              },
              "amount": 5
            }
          ],
          "goto": "mumyo.power.node.effect.001"
        },
        {
          "id": "mumyo.power.choice.002",
          "label": "鞘を開かず、剣圧だけを安全に取り出す",
          "result": "本来の一撃は鞘の中に眠らせたまま、鞘越しに漏れる剣圧だけを、三人で扱える「風」として整えた。地味で、安全で、誰の伝説にもならない力。調整を終えた無銘は、その風で名簿室の埃を払ってみせた。「……十四代で、一番平和な使い道だ」。少し、誇らしそうだった。",
          "intent": "安全な段階解除で確実に進む",
          "promise": "本来の力は一部に留め、チーム全体の成長へ成果を持ち帰る。",
          "memory": "全員で帰ると決めた手順が、危機で使える安全策として残る。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "mumyo"
              },
              "mode": "add",
              "trust": 0,
              "ownership": 9
            },
            {
