  "nodes": [
    {
      "type": "direction",
      "id": "mumyo.meet.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "mumyo.meet.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "mumyo.meet.node.line.001",
      "lineId": "mumyo.meet.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "景品展示室の一番奥に、豪華な景品たちから少し離れて、飾り気のない剣が一本ある。台座の説明書きは「景品番号・零」。名前の欄は、空白だった。"
    },
    {
      "type": "line",
      "id": "mumyo.meet.node.line.002",
      "lineId": "mumyo.meet.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "気づいたのは、ケースの背面の鏡を見た時だ。鏡の中には、剣が映っていなかった。代わりに、黒髪の人物が一人、静かに立っていた。現実には剣。鏡の中には、人。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "mumyo.meet.node.line.003",
      "lineId": "mumyo.meet.line.003",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "……こんにちは。えっと、どちらに向かって話せば、失礼じゃないですか。剣の方? 鏡の方?"
    },
    {
      "type": "line",
      "id": "mumyo.meet.node.line.004",
      "lineId": "mumyo.meet.line.004",
      "speakerId": "legacy.speaker.1whk6fw",
      "speakerName": "無銘",
      "mode": "dialogue",
      "text": "……初めてだ。その質問は。皆、剣に話す。命令は、剣にするものだから。"
    },
    {
      "type": "direction",
      "id": "mumyo.meet.node.direction.002",
      "command": {
        "type": "still",
        "assetId": "mumyo.meet.asset.still.001"
      }
    },
    {
      "type": "direction",
      "id": "mumyo.meet.node.direction.003",
      "command": {
        "type": "effect",
        "effectId": "pulse"
      }
    },
    {
      "type": "line",
      "id": "mumyo.meet.node.line.005",
      "lineId": "mumyo.meet.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "声は鏡の方から来た。低く、静かで、長く使われていない声だった。名前を聞くと、鏡の人物は首を横に振った。「名はない」。それから、鞘を手で隠すようにした。鞘には、びっしりと名前が刻まれていた——歴代の、所有者の名前が。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "mumyo.meet.node.line.006",
      "lineId": "mumyo.meet.line.006",
      "speakerId": "legacy.speaker.1whk6fw",
      "speakerName": "無銘",
      "mode": "dialogue",
      "text": "彼らの名は、ある。私を握った者の名は、全部ここに残る。……私の名を彫る場所は、この鞘のどこにもない。"
    },
    {
      "type": "line",
      "id": "mumyo.meet.node.line.007",
      "lineId": "mumyo.meet.line.007",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "好奇心で、ケースの説明書きを読み上げてしまった。「持ち主の望む姿と名を映し、最強の武器として完成する——」。読み終わる前に、鏡の人物が目を伏せた。褒め言葉のはずの一文が、この人には、たぶん一番長い呪いだった。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "mumyo.meet.node.line.008",
      "lineId": "mumyo.meet.line.008",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "その時、隣の団体客がケースにぶつかって、剣が台座の上で一寸だけ揺れた。刃が、ほんの一寸、鞘から覗く。——瞬間、展示室中の鏡という鏡に、燃える王都と、沈む城と、月を噛む竜が同時に映った。十四の時代の、十四の最終決戦。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "mumyo.meet.node.line.009",
      "lineId": "mumyo.meet.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "刃が納まると、全部消えた。団体客は何も見ていない。私だけが腰を抜かしかけていて、鏡の人物は、世界の終わりを十四個しまい終えた顔で、私の方を見た。「……驚かせた。すまない」。謝る最強の武器を、私はこの日、初めて見た。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "mumyo.meet.node.line.010",
      "lineId": "mumyo.meet.line.010",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "怖くないと言えば嘘になる。でも、この人が最初に守ったのは自分の評判ではなく、通りすがりの団体客と、腰を抜かしかけた私だった。名札を直して、私は次に来る口実を考え始めていた。",
      "emotion": "tender"
    },
    {
      "type": "choice",
      "id": "mumyo.meet.node.choice.001",
      "choices": [
        {
          "id": "mumyo.meet.choice.001",
          "label": "鏡の中の本人へ先に名乗る",
          "result": "剣にではなく、鏡に向かって名乗った。「ミミです。闘技場の運営です。あなたは?」。答えは分かっていて、それでも聞いた。鏡の人物は少し考えて、答えた。「名はない。……が、覚えた。ミミ。私に名乗った、最初の人だ」。現実の剣は動かなかった。でも鏡の中で、黒髪の人が一歩、こちらへ近づいた。",
          "intent": "登録の前に、目の前の相手を知る",
          "promise": "目先の報酬は得ない代わりに、相手が何を望んでいるかを確かめる。",
          "memory": "手続きより先に話を聞いたことを、相手は最初の印象として覚えている。",
          "tone": "tender",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "mumyo"
              },
              "mode": "add",
              "trust": 7,
              "ownership": -2
            }
          ],
          "goto": "mumyo.meet.node.effect.001"
        },
        {
          "id": "mumyo.meet.choice.002",
          "label": "今日は無銘を誘わず、用事へ戻る",
          "result": "今日は名前の空白と、鏡の中の立ち姿だけを覚えて帰った。去り際に一度だけ振り返ると、鏡の人物はまだこちらを見ていた。展示ケースの中の存在に見送られたのは、初めてだった。",
          "intent": "今は勧誘せず、相手との距離を保つ",
          "promise": "所属選手にはならないが、後の出来事で再会できる。",
          "memory": "最初の出会いで急いで仲間にしなかったことが、次の再会へ残る。",
          "tone": "pragmatic",
          "effects": [],
          "goto": "mumyo.meet.node.effect.001"
        }
      ]
    },
    {
