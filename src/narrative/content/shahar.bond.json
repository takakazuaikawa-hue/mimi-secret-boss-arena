  "presentation": {
    "location": "配送ヤード",
    "assets": [
      {
        "id": "shahar.bond.asset.background.001",
        "kind": "background",
        "path": "/assets/story/bg-casino-cafe-rain.png",
        "alt": "配送ヤードの背景"
      }
