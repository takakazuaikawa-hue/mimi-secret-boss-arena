  "nodes": [
    {
      "type": "direction",
      "id": "teirei.liberation.node.direction.001",
      "command": { "type": "background", "assetId": "teirei.liberation.asset.background.001", "transition": "dissolve" }
    },
    {
      "type": "line",
      "id": "teirei.liberation.node.line.001",
      "lineId": "teirei.liberation.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "契約を終わらせる夜。丁零の契約データの「命令元」欄には、ずっと私の名前が入っていた。今日、それを消す。"
    },
    {
      "type": "line",
      "id": "teirei.liberation.node.line.002",
      "lineId": "teirei.liberation.line.002",
      "speakerId": "legacy.speaker.qmf7da",
      "speakerName": "丁零",
      "mode": "dialogue",
      "text": "確認します。命令元が空欄になると、私に命令できる者は、いなくなります。……昔の私なら、三十秒で停止していた状態です。"
    },
    {
      "type": "line",
      "id": "teirei.liberation.node.line.003",
      "lineId": "teirei.liberation.line.003",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "今の丁零さんなら？"
    },
    {
      "type": "line",
      "id": "teirei.liberation.node.line.004",
      "lineId": "teirei.liberation.line.004",
      "speakerId": "legacy.speaker.qmf7da",
      "speakerName": "丁零",
      "mode": "dialogue",
      "text": "……検証してみましょう。消して、ください。"
    },
    {
      "type": "line",
      "id": "teirei.liberation.node.line.005",
      "lineId": "teirei.liberation.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "判を押す。命令元の欄から、私の名前が消える。空欄。彼女の一番怖かった形が、契約書の真ん中に、静かに開いた。",
      "emotion": "tension"
    },
    {
      "type": "direction",
      "id": "teirei.liberation.node.direction.002",
      "command": { "type": "effect", "effectId": "pulse" }
    },
    {
      "type": "line",
      "id": "teirei.liberation.node.line.006",
      "lineId": "teirei.liberation.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "三十秒。彼女は止まらなかった。一分。琥珀灯は静かに明滅している。それから彼女は、空欄をじっと見て、初めての分類を口にした。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "teirei.liberation.node.line.007",
      "lineId": "teirei.liberation.line.007",
      "speakerId": "legacy.speaker.qmf7da",
      "speakerName": "丁零",
      "mode": "dialogue",
      "text": "……この空欄は、怖くない、方の空欄です。好みの理由欄と、同じ形をしています。"
    },
    {
      "type": "line",
      "id": "teirei.liberation.node.line.008",
      "lineId": "teirei.liberation.line.008",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "空欄のまま提出していい欄が、彼女の世界に、また一つ増えた。命令元: (空欄のまま提出)。世界で一番自由な書類の完成である。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "teirei.liberation.node.line.009",
      "lineId": "teirei.liberation.line.009",
      "speakerId": "legacy.speaker.qmf7da",
      "speakerName": "丁零",
      "mode": "dialogue",
      "text": "ミミ。最初の自己命令の実行を、開始します。……聞いていて、ください。"
    },
    {
      "type": "direction",
      "id": "teirei.liberation.node.direction.003",
      "command": { "type": "still", "assetId": "teirei.liberation.asset.still.001" }
    },
    {
      "type": "line",
      "id": "teirei.liberation.node.line.010",
      "lineId": "teirei.liberation.line.010",
      "speakerId": "legacy.speaker.qmf7da",
      "speakerName": "丁零",
      "mode": "dialogue",
      "text": "「丁零は、ミミの隣にいる。理由: ——(空欄のまま提出)」。"
    },
    {
      "type": "line",
      "id": "teirei.liberation.node.line.011",
      "lineId": "teirei.liberation.line.011",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "理由欄の空欄を、こんな風に使う機械を、世界は他に知らないと思う。私の心拍は、また非標的のまま撃ち抜かれた。この人の精密射撃は、照準がなくても当たる。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "teirei.liberation.node.line.012",
      "lineId": "teirei.liberation.line.012",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "夜の保管区を出る前に、締めの形だけ決める。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "teirei.liberation.node.choice.001",
      "choices": [
        {
          "id": "teirei.liberation.choice.001",
          "label": "命令元を空欄にし、最初の自己命令を待つ",
          "result": "帰り道、彼女は保管区の同型機の墓標に、一機ずつ立ち止まって、何かを送信していった。聞くと、「命令元: 空欄」の書式を、眠っている同型機たちの記録にも残してきたという。「いつか誰かが再起動した時、空欄から始められるように」。自由の書式は、こうして静かに配布された。",
          "intent": "空欄の自由を、本人の手に渡す",
          "promise": "所有者名を消し、本人が自分の名で次の試合を選べるようにする。",
          "memory": "同型機たちに配られた空欄の書式のことを、二人だけが知っている。",
          "tone": "defiant",
          "effects": [
            { "type": "relationship", "target": { "type": "fighter", "fighterId": "teirei" }, "mode": "add", "trust": 10, "ownership": 0 },
            { "type": "liberationDecision", "fighterId": "teirei", "decision": "release" }
          ],
          "goto": "teirei.liberation.node.effect.001"
        },
        {
          "id": "teirei.liberation.choice.002",
          "label": "契約を削除し、次戦の作戦表だけ共有する",
          "result": "「契約は消えました。これは命令じゃなくて、共有です」と次戦の作戦表を渡すと、彼女は0.4秒で読了し、三箇所に赤入れして返してきた。「共有への、共有です」。命令でも服従でもない、対等な赤入れだった。あの「誤解の余地0.0パーセント」の几帳面さは、自由になっても健在である。",
          "intent": "命令ではなく共有で、一緒に戦い続ける",
          "promise": "断る権利を返したうえで、決勝を一緒に戦う新しい約束を結ぶ。",
          "memory": "「共有への、共有です」の赤入れを、チームは新しい合言葉にした。",
          "tone": "tender",
          "effects": [
            { "type": "relationship", "target": { "type": "fighter", "fighterId": "teirei" }, "mode": "add", "trust": 6, "ownership": 0 },
            { "type": "sharedPoints", "amount": 4 },
            { "type": "liberationDecision", "fighterId": "teirei", "decision": "release" }
          ],
          "goto": "teirei.liberation.node.effect.001"
        }
      ]
    },
    {
      "type": "effect",
      "id": "teirei.liberation.node.effect.001",
      "effects": [
        { "type": "setStoryStage", "fighterId": "teirei", "stage": 6 },
        { "type": "setLiberationEligible", "fighterId": "teirei", "eligible": false },
        { "type": "setLiberated", "fighterId": "teirei", "liberated": true },
        { "type": "relationship", "target": { "type": "fighter", "fighterId": "teirei" }, "mode": "set", "ownership": 0 }
      ]
    },
    {
      "type": "end",
      "id": "teirei.liberation.node.end.001",
      "mode": "return-to-week"
    }
  ],
