{
  "schemaVersion": 1,
  "id": "amara.crisis",
  "kind": "character",
  "title": "回収通告と、雨の判例",
  "summary": "アルデバラン社の回収期限。雨の中へ消えようとするアマラの手を、初めてつかむ",
  "ownership": {
    "arcId": "character.amara",
    "characterId": "amara",
    "stage": "crisis"
  },
