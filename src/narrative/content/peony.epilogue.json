    "weight": 1
  },
  "presentation": {
    "location": "従業員食堂",
    "assets": [
      {
        "id": "peony.epilogue.asset.background.001",
        "kind": "background",
        "path": "/assets/story/bg-casino-cafe-morning.png",
        "alt": "従業員食堂の背景"
      },
      {
        "id": "peony.epilogue.asset.still.001",
        "kind": "still",
        "path": "/assets/story/events/peony-epilogue-chair-ceremony-v1.png",
        "alt": "くしゃみの風圧にも耐えた巨大椅子で、子どもたちと笑うピオニー"
      }
    ]
  },
  "nodes": [
    {
      "type": "line",
      "id": "peony.epilogue.node.line.001",
      "lineId": "peony.epilogue.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "最終大会の翌週、従業員食堂は臨時休業になった。理由は『椅子一脚の納品式』。椅子に式典がつくのは初めて見た。"
    },
    {
      "type": "line",
      "id": "peony.epilogue.node.line.002",
      "lineId": "peony.epilogue.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "中央には鉄骨、古竜用甲板、攻城兵器の車軸を使った巨大な椅子。価格は食堂の年間予算より高い。座る人は一人である。"
    },
    {
      "type": "line",
      "id": "peony.epilogue.node.line.003",
      "lineId": "peony.epilogue.line.003",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "背もたれには託児室の子どもたちが作った紙の冠が飾られ、技術者は距離を取り、保険担当者はさらに遠くから見守っていた。"
    },
    {
      "type": "line",
      "id": "peony.epilogue.node.line.004",
      "lineId": "peony.epilogue.line.004",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "闘技場で最も高価な備品、ピオニー専用椅子。その正式名称を読み上げるだけで、ピオニー本人が申し訳なさそうに小さくなった。小さくはならなかった。"
    },
    {
      "type": "direction",
      "id": "peony.epilogue.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "peony.epilogue.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "direction",
      "id": "peony.epilogue.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "pulse"
      }
    },
    {
      "type": "line",
      "id": "peony.epilogue.node.line.005",
      "lineId": "peony.epilogue.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "角の部分だけ立派に折られた紙の冠を見て、入口へ目をやる。待っていると認めるのは落ち着かない。でも、来なくても責められない関係になれたことは、少し誇らしかった。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "peony.epilogue.node.line.006",
      "lineId": "peony.epilogue.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "会う約束はしていない。だから待っているわけではない、と自分へ言い聞かせる朝ほど、入口の音によく気づいた。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "peony.epilogue.node.line.007",
      "lineId": "peony.epilogue.line.007",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "耐久試験は済んでます。あとは座るだけです。たぶん。"
    },
    {
      "type": "line",
      "id": "peony.epilogue.node.line.008",
      "lineId": "peony.epilogue.line.008",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "『たぶん』を気にしないで、どうぞ！"
    },
    {
      "type": "line",
      "id": "peony.epilogue.node.line.009",
      "lineId": "peony.epilogue.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ピオニーは右から座ろうとして床を心配し、左から座ろうとして壁を心配し、正面へ回って天井を見た。椅子より周囲の心配が多い。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "peony.epilogue.node.line.010",
      "lineId": "peony.epilogue.line.010",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "座るよ。壊れたら、今日はあたしが直す係だ。"
    },
    {
      "type": "line",
      "id": "peony.epilogue.node.line.011",
      "lineId": "peony.epilogue.line.011",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "でも、できれば壊れないでくれ。気に入ったから。"
    },
    {
      "type": "line",
      "id": "peony.epilogue.node.line.012",
      "lineId": "peony.epilogue.line.012",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "彼女が腰を下ろす。食堂中が息を止める。椅子は沈まず、軋まず、足一本ぶんも逃げなかった。技術者が泣き、保険担当者がその場へ座り込んだ。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "peony.epilogue.node.line.013",
      "lineId": "peony.epilogue.line.013",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ピオニーは背もたれへ身体を預けた。紙の冠だけがふるふる揺れ、子どもたちから試合優勝より大きな拍手が起きた。"
    },
    {
      "type": "line",
      "id": "peony.epilogue.node.line.014",
      "lineId": "peony.epilogue.line.014",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "その瞬間、花粉が舞った。ピオニーの鼻が動き、技術者が机の下へ入り、私は紙の冠だけを押さえた。守る順番は全員ばらばらだ。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "peony.epilogue.node.line.015",
      "lineId": "peony.epilogue.line.015",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "くしゃみは出た。普通の椅子が三十センチずつ後退し、食器が一斉に鳴り、窓の外の雲が丸く割れた。専用椅子だけは動かなかった。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "peony.epilogue.node.line.016",
      "lineId": "peony.epilogue.line.016",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "静寂のあと、ピオニーが恐る恐る座面を撫でた。傷はない。彼女は笑い、椅子の脚を抱え、技術者たちまでまとめて持ち上げかけた。そっちは下ろして。",
      "emotion": "tender"
    },
    {
      "type": "direction",
      "id": "peony.epilogue.node.direction.003",
      "command": {
        "type": "still",
        "assetId": "peony.epilogue.asset.still.001"
      }
    },
    {
      "type": "line",
      "id": "peony.epilogue.node.line.017",
      "lineId": "peony.epilogue.line.017",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "式典後、食堂の席は一つだけ指定席になった。ただし昼休みには子どもが十人ほど先に座っている。"
    },
    {
      "type": "line",
      "id": "peony.epilogue.node.line.018",
      "lineId": "peony.epilogue.line.018",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ピオニーは床へ正座せず、子どもたちごと椅子へ座った。冠が角へ引っかかり、本人より先に椅子が正式な居場所を得た。"
    },
    {
      "type": "line",
      "id": "peony.epilogue.node.line.019",
      "lineId": "peony.epilogue.line.019",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "請求書には『世界終末級着席設備・一式』とあった。私は金額を見なかったことにし、隣から差し出された特大サンドイッチを受け取った。今日はちゃんと、全員座って昼食である。",
      "emotion": "tender"
    },
    {
      "type": "end",
      "id": "peony.epilogue.node.end.001",
      "mode": "return-to-week"
    }
  ],
