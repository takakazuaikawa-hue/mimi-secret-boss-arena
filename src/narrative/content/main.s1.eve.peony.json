    "weight": 1
  },
  "presentation": {
    "location": "前夜祭の夜店通り",
    "assets": [
      {
        "id": "main.s1.eve.peony.asset.background.001",
        "kind": "background",
        "path": "/assets/story/bg-casino-cafe-night.png",
