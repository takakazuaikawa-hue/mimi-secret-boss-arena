  },
  "presentation": {
    "location": "記念撮影所",
    "assets": [
      {
        "id": "ushiro.meet.asset.background.001",
        "kind": "background",
        "path": "/assets/story/bg-arena-reception.png",
        "alt": "記念撮影所の背景"
      },
      {
        "id": "ushiro.meet.asset.still.001",
