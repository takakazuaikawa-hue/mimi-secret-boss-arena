      }
    ]
  },
  "nodes": [
    {
      "type": "direction",
      "id": "main.s2.w22.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "main.s2.w22.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "direction",
      "id": "main.s2.w22.node.direction.002",
      "command": {
        "type": "clearSprites"
      }
    },
    {
      "type": "direction",
      "id": "main.s2.w22.node.direction.mimi.opening",
      "command": {
        "type": "show",
        "assetId": "main.s2.w22.asset.sprite.mimi.serious",
        "actorId": "mimi",
        "slot": "left",
        "scale": "tall"
      }
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.001a",
      "lineId": "main.s2.w22.line.001a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "臨時の申立窓口は、開けた瞬間から行列だった。"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.001b",
      "lineId": "main.s2.w22.line.001b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ノノさんが徹夜で刷った書式の束が、午前中に尽きた。二度、刷り増した。"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.001c",
      "lineId": "main.s2.w22.line.001c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「監督資格停止への異議申立」申立人の欄は——何枚あっても、いい。",
      "emotion": "resolve"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.002a",
      "lineId": "main.s2.w22.line.002a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "列の顔ぶれに、涙腺が仕事をしかけた。剣士さん。仲居さん。"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.002b",
      "lineId": "main.s2.w22.line.002b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "計測係くん。座長さんと一座の全員。"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.002c",
      "lineId": "main.s2.w22.line.002c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "休止札を置いて署名する救護の人たち。外れ札に署名する胴元。"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.002d",
      "lineId": "main.s2.w22.line.002d",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "マダムは三枚書いた。一枚は、宝くじの裏だった。"
    },
    {
      "type": "direction",
      "id": "main.s2.w22.node.direction.mimi.shift.001",
      "command": {
        "type": "show",
        "assetId": "main.s2.w22.asset.sprite.mimi.smile",
        "actorId": "mimi",
        "slot": "left",
        "scale": "tall"
      }
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.003a",
      "lineId": "main.s2.w22.line.003a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "狼の目の人は、挑戦状の様式で申立書を書いてきた。様式自由とはいえ、封蝋つきは初めてだ。"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.003b",
      "lineId": "main.s2.w22.line.003b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "受付の外に、大きな板が一枚、立てかけられていた。"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.003c",
      "lineId": "main.s2.w22.line.003c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "——扉だ。あの部屋が、自分の扉を提出してきたのだ。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.004a",
      "lineId": "main.s2.w22.line.004a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "三日で、申立は千二百枚を超えた。台車二台ぶんだ。"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.004b",
      "lineId": "main.s2.w22.line.004b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ノノさんは一枚ずつ受理印を押しながら、声が震えていた。"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.004c",
      "lineId": "main.s2.w22.line.004c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「こんなに美しい書類の山、受付人生で初めてです」",
      "emotion": "tender"
    },
    {
      "type": "direction",
      "id": "main.s2.w22.node.direction.mimi.shift.002",
      "command": {
        "type": "show",
        "assetId": "main.s2.w22.asset.sprite.mimi.serious",
        "actorId": "mimi",
        "slot": "left",
        "scale": "tall"
      }
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.005a",
      "lineId": "main.s2.w22.line.005a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "会社の返答は、四日目に来た。"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.005b",
      "lineId": "main.s2.w22.line.005b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「資格停止を、撤回する」短い通告文の末尾に、負け惜しみが一行。"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.005c",
      "lineId": "main.s2.w22.line.005c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "耳が、ぴくっと動いた。「なお、決勝の対戦相手は、当社が指定する」",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.006a",
      "lineId": "main.s2.w22.line.006a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "同日、掲示板の「調整中」が、「歴代王者選抜(台帳再現)」に貼り替えられた。"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.006b",
      "lineId": "main.s2.w22.line.006b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "四百年の優勝者から選び抜かれた、全盛期の再現。"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.006c",
      "lineId": "main.s2.w22.line.006c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "監督の欄には、あの名前。再演企画室・室長。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.007a",
      "lineId": "main.s2.w22.line.007a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "控室が、静まった。誰かが、掠れた声で言った。"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.007b",
      "lineId": "main.s2.w22.line.007b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「……観たい」正直すぎる。でも、分かる。"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.007c",
      "lineId": "main.s2.w22.line.007c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "四百年の王者の全盛期が、一枚の砂場に並ぶのだ。"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.007d",
      "lineId": "main.s2.w22.line.007d",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "問題は——それと戦うのが、うちだということだ。",
      "emotion": "resolve"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.008a",
      "lineId": "main.s2.w22.line.008a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "会社の考えは、透けている。新作の頂点に、史上最強の再演をぶつける気だ。"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.008b",
      "lineId": "main.s2.w22.line.008b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "うちが負ければ「再演は新作に勝る」が実証される。"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.008c",
      "lineId": "main.s2.w22.line.008c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "……理屈は、いい理屈だ。理屈だけは。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.009a",
      "lineId": "main.s2.w22.line.009a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "受付の窓口を閉めながら、ノノさんが言った。"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.009b",
      "lineId": "main.s2.w22.line.009b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「相手が記録の再現なら——記録の続きを知るのは、こちらだけですね」"
    },
    {
      "type": "line",
      "id": "main.s2.w22.node.line.009c",
      "lineId": "main.s2.w22.line.009c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "……この人は、時々、審判より正確なことを言う。",
      "emotion": "revelation"
    },
    {
      "type": "choice",
      "id": "main.s2.w22.node.choice.001",
      "choices": [
        {
          "id": "main.s2.w22.choice.001",
          "label": "受けて立つ、と即日回答する",
          "result": "回答は一行、「対戦、お受けします」で終えた。号外が「新星、即答!」と刷り、賭け札の窓口に史上最長の列ができた。憧れと新星、どっちが強いか、街中まだ分からないらしい。",
          "intent": "動揺を見せず、興行として最高の形に乗る",
          "promise": "街の期待が最大化する代わりに、負ければ再演の勝利が実証される",
          "memory": "「対戦、お受けします」の一行回答が号外に載った",
          "tone": "heroic",
          "effects": [
            {
              "type": "sharedPoints",
              "amount": 2
            }
          ],
          "goto": "main.s2.w22.node.end.001"
        },
        {
          "id": "main.s2.w22.choice.002",
          "label": "再現できないものを、数え上げる",
          "result": "夜、全員で「記録に無くて、うちにあるもの」を数えた。この二年の続き、赤線、明日の約束。台帳は全盛期を再現できても、続きは再現できない。数え終えたら、恐れは消えていた。",
          "intent": "記録の再現との差分を、戦う前に言葉にする",
          "promise": "チームの軸が定まる代わりに、答え合わせは決勝の砂の上になる",
          "memory": "「記録に無くて、うちにあるもの」の一覧が控室に貼られた",
          "tone": "tender",
          "effects": [
            {
              "type": "sharedPoints",
              "amount": 2
            }
          ],
          "goto": "main.s2.w22.node.end.001"
        }
      ]
    },
    {
      "type": "end",
      "id": "main.s2.w22.node.end.001",
      "mode": "return-to-week"
    }
  ],
  "debug": {
    "status": "review",
    "sourceDocument": "docs/MAIN_STORY_SCRIPT.md",
    "authorNote": "語り口V2・二行枠で改稿。2周目・週22反転(9行→32ノード+選択)。署名の壁(壊したルールの数だけ味方が返ってくる回収。部屋は扉を提出)。決勝の相手=歴代王者選抜(台帳再現)・監督は室長、が判明。ノノさんの「記録の続きを知っているのはこちらだけ」が勝ち筋の種。",
    "legacyGeneratedIds": false
