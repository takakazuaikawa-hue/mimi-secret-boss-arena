{
  "schemaVersion": 1,
  "id": "main.s2.w22",
  "kind": "opening",
  "title": "署名の壁",
  "summary": "申立人の欄は、何枚あってもいい。そして決勝の相手が発表される",
  "ownership": {
    "arcId": "main.stage2"
  },
