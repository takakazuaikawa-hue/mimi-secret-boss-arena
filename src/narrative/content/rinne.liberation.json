{
  "schemaVersion": 1,
  "id": "rinne.liberation",
  "kind": "liberation",
  "title": "未来を見ない、署名",
  "summary": "目を閉じて名前を書く夜。空のコインは、次に会う場所の印",
  "ownership": {
