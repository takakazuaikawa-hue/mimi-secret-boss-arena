    },
    "priority": 400,
    "weight": 1
  },
  "presentation": {
    "location": "中央アトリウム撮影所",
    "assets": [
      {
        "id": "ushiro.epilogue.asset.background.001",
        "kind": "background",
        "path": "/assets/story/bg-central-atrium-photo-studio-day-v1.png",
