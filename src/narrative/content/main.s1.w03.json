{
  "schemaVersion": 1,
  "id": "main.s1.w03",
  "kind": "opening",
  "title": "八つ裂き大福と招待状",
  "summary": "詫びの銘菓は血の色で美味。空振りの質問と、温泉つきの招待状",
  "ownership": {
    "arcId": "main.stage1"
  },
