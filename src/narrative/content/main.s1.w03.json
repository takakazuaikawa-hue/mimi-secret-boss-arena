    "repeat": {
      "mode": "once-per-run"
    },
    "priority": 900,
    "weight": 1
  },
  "presentation": {
    "location": "カジノカフェ",
    "assets": [
      {
        "id": "main.s1.w03.asset.background.001",
        "kind": "background",
