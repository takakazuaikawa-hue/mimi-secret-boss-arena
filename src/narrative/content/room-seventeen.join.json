              },
              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "room-seventeen",
              "decision": "join"
            }
          ],
          "goto": "room-seventeen.join.node.end.001"
        },
        {
          "id": "room-seventeen.join.choice.002",
          "label": "扉そのものを、背番号十七で登録する",
          "result": "登録区分は「選手・扉(一枚)」、背番号は本人希望で十七。真鍮のプレートを、ユニフォーム代わりに磨いた。初練習、壁に生えた扉に審判が「……ノックするべきか?」したほうがいい、礼儀として。",
          "intent": "規定に収まる形で確実に登録する",
          "promise": "本人のもてなし論は後回しになるが、誰にでも使える成長ポイントを得る。",
          "memory": "背番号十七の真鍮プレートは、毎朝誰かが磨いている。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "room-seventeen"
              },
              "mode": "add",
              "trust": 0,
              "ownership": 8
            },
            {
              "type": "sharedPoints",
              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "room-seventeen",
              "decision": "join"
            }
          ],
          "goto": "room-seventeen.join.node.end.001"
        },
        {
          "id": "room-seventeen.join.choice.003",
          "label": "今回は十七号室を誘わず、別の機会を待つ",
          "result": "今回は見送ることにした。部屋はシャンデリアを一段暗くして、それでも覚えたてのお見送りを丁寧にやり切った。「お帰りは、こちらです。……またの、お越しを」出口は一発で通路に出た。成長は本物。",
          "intent": "今回はチームへ誘わない",
          "promise": "今回の所属は見送るが、人物の物語と再会の可能性は失わない。",
          "memory": "一発で成功したお見送りを、部屋は静かに誇っている。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "recruitmentDecision",
              "fighterId": "room-seventeen",
              "decision": "decline"
            }
          ],
          "goto": "room-seventeen.join.node.end.001"
        }
      ]
