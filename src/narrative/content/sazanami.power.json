  "nodes": [
    {
      "type": "line",
      "id": "sazanami.power.node.line.001",
      "lineId": "sazanami.power.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "練習のあと、さざなみに呼ばれて地下貯水槽まで来た。いつもの力では足りない理由を、見せたいらしい。"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.002",
      "lineId": "sazanami.power.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "警報より先に、相手の声が私の名を呼んだ。いつもと同じ呼び方なのに、その一音だけで足が止まる。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.003",
      "lineId": "sazanami.power.line.003",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "水槽の影が壁を越え、闘技場全体を海底へ沈めた。息はできるのに、耳の奥で何千メートルもの水圧が鳴る。"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.004",
      "lineId": "sazanami.power.line.004",
      "speakerId": "legacy.speaker.we7zqt",
      "speakerName": "さざなみ",
      "mode": "dialogue",
      "text": "水槽の底を開けば、目だけは出せる。"
    },
    {
      "type": "direction",
      "id": "sazanami.power.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "sazanami.power.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "direction",
      "id": "sazanami.power.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "flash"
      }
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.005",
      "lineId": "sazanami.power.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "寝返り一つで沿岸三県の潮位が変わるのに、青のりの質には細かい。そんな力が、目の前で息をしている。逃げる理由なら十分だった。それでも私は、力の大きさよりさざなみが最初にどこを見るのかを確かめたかった。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.006",
      "lineId": "sazanami.power.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "さざなみが私と危険の間へ立つ。触れてはいない。それでも、こちらへ届くはずだった圧力だけがきれいに二つへ割れた。"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.007",
      "lineId": "sazanami.power.line.007",
      "speakerId": "legacy.speaker.we7zqt",
      "speakerName": "さざなみ",
      "mode": "dialogue",
      "text": "これは私の指先にすぎない。本体が動けば、岸の形が変わる。"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.008",
      "lineId": "sazanami.power.line.008",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "館内が水没しません？"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.009",
      "lineId": "sazanami.power.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "海溝より深い場所から、地上を小さな影として眺めるもの。けれど今見せている力は、勝つためではなく、私を怖がらせないために抑えられている。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.010",
      "lineId": "sazanami.power.line.010",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "試合のたびに地図を刷り直す予算はありません。指先の範囲でお願いします。"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.011",
      "lineId": "sazanami.power.line.011",
      "speakerId": "legacy.speaker.we7zqt",
      "speakerName": "さざなみ",
      "mode": "dialogue",
      "text": "目は乾く。水は出さない。"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.012",
      "lineId": "sazanami.power.line.012",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "本気を見たいと思っていた。実際に目の前へ現れると、知りたかったのは強さではなく、その力を本人がどう恐れているかだった。"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.013",
      "lineId": "sazanami.power.line.013",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "巨大な瞳が閉じ、波が一度だけ足首へ触れた。加減を約束する握手のようだった。"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.014",
      "lineId": "sazanami.power.line.014",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "寝返り一つで沿岸三県の潮位が変わるのに、青のりの質には細かい。闘技場の安全基準は一瞬で役に立たなくなり、担当者は私の顔を見て計測を諦めた。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.015",
      "lineId": "sazanami.power.line.015",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "世界を壊せることより、壊さないために何を選んだかが胸へ残った。距離を測り続けていたのは、こちらの暮らしを小さいものとして踏み越えたくなかったからだ。その理解が正しいか、いつか本人の言葉で確かめたい。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.016",
      "lineId": "sazanami.power.line.016",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "力の中心にあったのは、誰かへ近づくための一歩が、その人の暮らす海岸線を変えてしまうこと。最強であることが、本人にとって一番古い傷なのだと分かる。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.017",
      "lineId": "sazanami.power.line.017",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "怖さが消えたわけではない。だからこそ、使うかどうかを本人と決める必要がある。"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.018",
      "lineId": "sazanami.power.line.018",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "大丈夫とは言えない。怖いものは怖い。それでも、次に力を使う時は一人で決めなくていいと伝えた。",
      "emotion": "resolve"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.019",
      "lineId": "sazanami.power.line.019",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "浅瀬の味だと評された空の弁当箱だけが元の大きさで残り、さっきまで世界の終わりがいた場所に、帰り道の灯りが戻った。"
    },
    {
      "type": "choice",
      "id": "sazanami.power.node.choice.001",
      "choices": [
        {
          "id": "sazanami.power.choice.001",
          "label": "本体を呼ばず、潮の向きだけ変えてもらう",
          "result": "会場に海は来なかった。それでも敵の足元だけが満ち、味方の退路だけが干いた。",
          "intent": "本来の力を一気に取り戻す",
          "promise": "失敗時の危険を引き受け、この人専用の成長を最大まで進める。",
          "memory": "力を恐れたまま任せたことを、相手は危機の場面で思い出す。",
          "tone": "heroic",
          "effects": [
