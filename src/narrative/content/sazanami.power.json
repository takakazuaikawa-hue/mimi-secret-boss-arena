{
  "schemaVersion": 1,
  "id": "sazanami.power",
  "kind": "character",
  "title": "胴長と、水中三分間",
  "summary": "地下貯水槽で海の本気を見る。黄色い胴長と、泡の声",
  "ownership": {
    "arcId": "character.sazanami",
    "characterId": "sazanami",
