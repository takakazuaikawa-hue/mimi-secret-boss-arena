  "nodes": [
    {
      "type": "direction",
      "id": "sazanami.power.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "sazanami.power.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.001",
      "lineId": "sazanami.power.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "次の相手は水中戦を仕掛けてくるらしい。対策会議の結論——さざなみの本気を、一度ちゃんと見ておく。場所は閉鎖中の地下貯水槽。私の装備は、彼女が指定した黄色い胴長である。"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.002",
      "lineId": "sazanami.power.line.002",
      "speakerId": "legacy.speaker.we7zqt",
      "speakerName": "さざなみ",
      "mode": "dialogue",
      "text": "……似合う。黄色い胴長——百点。"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.003",
      "lineId": "sazanami.power.line.003",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "散歩には一点残したのに、胴長は満点なんですか。"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.004",
      "lineId": "sazanami.power.line.004",
      "speakerId": "legacy.speaker.we7zqt",
      "speakerName": "さざなみ",
      "mode": "dialogue",
      "text": "胴長は、完成している。あれ以上の装備を、海は知らない。"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.005",
      "lineId": "sazanami.power.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "海の価値観は、時々よく分からない。貯水槽に影が満ちていく。水位が上がる。照明が水面に揺れて、地下なのに、どこか遠い海の底みたいになった。",
      "emotion": "tension"
    },
    {
      "type": "direction",
      "id": "sazanami.power.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "flash"
      }
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.006",
      "lineId": "sazanami.power.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "本気のデモが始まった。水が、生き物になる。渦が柱になり、柱が壁になり、壁が音もなく崩れて凪へ戻る。水面が、彼女の呼吸に合わせて上下する。貯水槽全体が、一つの肺だった。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.007",
      "lineId": "sazanami.power.line.007",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "計測係の新人くんの計測器は、今夜は水没で終わった。彼は防水の記録板に「うみ。ここに、うみ。」と書いた。もう完全に俳人である。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.008",
      "lineId": "sazanami.power.line.008",
      "speakerId": "legacy.speaker.we7zqt",
      "speakerName": "さざなみ",
      "mode": "dialogue",
      "text": "ミミ。……水の中を、見てみるか。三分だけ、私の中へ。"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.009",
      "lineId": "sazanami.power.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "差し出されたのは、水でできた球のドームだった。中は空気。歩いて入れる、小さな部屋。私は胴長のまま、海の中へ一歩、踏み込んだ。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.010",
      "lineId": "sazanami.power.line.010",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "水中は、静かだった。光の柱が何本も差し込んで、影の粒子がゆっくり舞う。泡の声が、耳のすぐ横で聞こえた。壁越しじゃない、初めての距離。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.011",
      "lineId": "sazanami.power.line.011",
      "speakerId": "legacy.speaker.we7zqt",
      "speakerName": "さざなみ",
      "mode": "dialogue",
      "text": "息は、私が持つ。……あなたは今、海の中で、一番安全な場所にいる。"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.012",
      "lineId": "sazanami.power.line.012",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "海溝より大きい人の、真ん中の小部屋。心臓の音が水に響いて、隠しようがない。「……速い」と泡の声が言うので、「気のせいです」と答えた。海に嘘は通じなかったと思う。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.013",
      "lineId": "sazanami.power.line.013",
      "speakerId": "legacy.speaker.we7zqt",
      "speakerName": "さざなみ",
      "mode": "dialogue",
      "text": "本気の私は、これ。会場では、ここまで、しない。……でも、あなたには、全部を見ていてほしかった。"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.014",
      "lineId": "sazanami.power.line.014",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "三分間の海底から戻ると、地下貯水槽はただの貯水槽に戻っていた。胴長のまま、私はしばらく動けなかった。見せてもらった側の責任というものが、世の中にはある。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "sazanami.power.node.line.015",
      "lineId": "sazanami.power.line.015",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "この力を、試合でどう使うか。決めるのは、今夜のうちだ。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "sazanami.power.node.choice.001",
      "choices": [
        {
          "id": "sazanami.power.choice.001",
          "label": "本体を呼ばず、潮の向きだけ変えてもらう",
          "result": "決めた型は「潮目」。会場の水気——湿度、汗、飲み物、雨——の流れを、彼女がほんの少しだけ変える。相手は理由の分からない違和感に足を取られ、うちの三人だけが、いつも追い風の中にいる。審判には何も見えない。海は、見えない所で働くのが、一番大きい。",
          "intent": "海の大きさを、見えない優しさとして使う",
          "promise": "失敗時の危険を引き受け、この人専用の成長を最大まで進める。",
          "memory": "「潮目」の型が生まれた夜を、二人とも覚えている。",
          "tone": "heroic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "sazanami"
              },
              "mode": "add",
              "trust": 10,
              "ownership": -4
            },
            {
              "type": "fighterPoints",
              "target": {
                "type": "fighter",
                "fighterId": "sazanami"
              },
              "amount": 5
            }
          ],
          "goto": "sazanami.power.node.effect.001"
        },
        {
          "id": "sazanami.power.choice.002",
          "label": "水槽の影を広げ、安全な深さを測る",
          "result": "水槽の影をどこまで広げても会場が沈まない上限を、深夜まで計測した。結論、コート半面ぶんの「浅瀬」までなら安全。以後、彼女の試合は足首までの浅瀬で行われる。相手は水に警戒して大技を出せず、こちらは浅瀬の主。新人くんの報告書いわく「あさせ。されど、うみ。」——五・七・五が完成しつつある。",
          "intent": "会場を沈めない上限を先に決める",
          "promise": "本来の力は一部に留め、チーム全体の成長へ成果を持ち帰る。",
          "memory": "「浅瀬されど海」の上限値を、チームの全員が守っている。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "sazanami"
              },
              "mode": "add",
              "trust": 0,
              "ownership": 9
            },
            {
              "type": "sharedPoints",
              "amount": 5
            }
          ],
          "goto": "sazanami.power.node.effect.001"
        }
      ]
    },
