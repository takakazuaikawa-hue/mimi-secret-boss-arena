  },
  "nodes": [
    {
      "type": "direction",
      "id": "ushiro.join.node.direction.001",
      "command": { "type": "background", "assetId": "ushiro.join.asset.background.001", "transition": "dissolve" }
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.001",
      "lineId": "ushiro.join.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "うしろの選手登録で、想定通りの難所に着いた。顔写真である。カメラを向けると、彼は反射的に「相手の背後」へ回ってしまう。撮影者の背後に回られると、写真には何も写らない。"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.002",
      "lineId": "ushiro.join.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "撮影係を三人に増やしてみた。三人の背後に、三人ぶんの彼が回った。分身は増えるのに、写真は増えない。従業員通路は、静かな鬼ごっこ会場と化した。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.003",
      "lineId": "ushiro.join.line.003",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "すみません……。正面から見られると、体が勝手に。……長年の、職業病で。"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.004",
      "lineId": "ushiro.join.line.004",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "提出済みの写真候補は三枚。後頭部、後頭部、ブレた後頭部。登録課は全部差し戻してきた。ごもっともである。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.005",
      "lineId": "ushiro.join.line.005",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "……分かりました。カメラマンの背後に回っちゃうなら——カメラマンを、あなたにすればいいんです。"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.006",
      "lineId": "ushiro.join.line.006",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "……？　私が私を撮ると、私は私の背後に回るのでは……回れ、ない……？"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.007",
      "lineId": "ushiro.join.line.007",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "自分の背後には、回れない。うしろ史上初の盲点だった。私はカメラを彼の手に渡した。腕を伸ばして、レンズを自分へ。世に言う、自撮りである。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.008",
      "lineId": "ushiro.join.line.008",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "シャッター音。画面には、初めての正面の彼が写っていた。緊張で目が泳いで、ピースの位置が高い。でも、写っていた。百二十七人が通路に出てきて、一枚の画面を代わる代わる覗き込んだ。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.009",
      "lineId": "ushiro.join.line.009",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "……これが、私。……前から見ると、こういう顔を、していたのですね。"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.010",
      "lineId": "ushiro.join.line.010",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "自分の顔を初めて見る人の声を、私は初めて聞いた。登録写真の欄は、この一枚で埋まった。世界一時間のかかった自撮りとして、登録課の伝説になった。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.011",
      "lineId": "ushiro.join.line.011",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "残る欄は、あと少し。締め方を決める。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "ushiro.join.node.choice.001",
      "choices": [
        {
          "id": "ushiro.join.choice.001",
          "label": "最後列へ空席を一つ残し、見えない返事を待つ",
          "result": "契約欄の署名も、彼は「見られていない場所でなら」書けるという。私は書類を置いて、廊下の角まで下がった。三分後、戻ると署名が済んでいて、隣に小さな付記があった。「見ていなくても、待っていてくれたことは、背中で分かりました」。背中で分かる人と、契約した。",
          "intent": "見られない自由を保ったまま、迎える",
          "promise": "登録は少し遅れるが、この人専用の成長ポイントを得る。",
          "memory": "「背中で分かりました」の付記を、私は大事にしている。",
          "tone": "tender",
          "effects": [
            { "type": "relationship", "target": { "type": "fighter", "fighterId": "ushiro" }, "mode": "add", "trust": 8, "ownership": -3 },
            { "type": "fighterPoints", "target": { "type": "fighter", "fighterId": "ushiro" }, "amount": 2 },
            { "type": "recruitmentDecision", "fighterId": "ushiro", "decision": "join" }
          ],
          "goto": "ushiro.join.node.end.001"
        },
        {
          "id": "ushiro.join.choice.002",
          "label": "欠席者のまま、選手名簿へ登録する",
          "result": "名簿の備考欄に「本選手は常に出席していますが、見えない場合があります」と書いて提出した。登録課は三十分悩んで、新しい区分を作った。「在席(不可視)」。以後、闘技場の名簿には、この区分がたまに増えるようになる。うちのチームが通ったあとの書式は、だいたい豊かになる。",
          "intent": "見えないままでも、正式な席を作る",
          "promise": "本人の緊張は残るが、誰にでも使える成長ポイントを得る。",
          "memory": "区分「在席(不可視)」の発明を、登録課は少し誇りにしている。",
          "tone": "pragmatic",
          "effects": [
            { "type": "relationship", "target": { "type": "fighter", "fighterId": "ushiro" }, "mode": "add", "trust": 0, "ownership": 8 },
            { "type": "sharedPoints", "amount": 2 },
            { "type": "recruitmentDecision", "fighterId": "ushiro", "decision": "join" }
          ],
          "goto": "ushiro.join.node.end.001"
        },
        {
          "id": "ushiro.join.choice.003",
          "label": "今回はうしろを誘わず、別の機会を待つ",
          "result": "「登録は、またの機会に」。彼は少しほっとした様子で、それでも初めての自撮りだけは、大事そうに持って帰った。翌週、記念撮影所の「見守りオプション」の案内看板に、スタッフ紹介として、あの自撮りが小さく貼られていた。デビューは、彼のペースで進んでいる。",
          "intent": "今回はチームへ誘わない",
          "promise": "今回の所属は見送るが、人物の物語と再会の可能性は失わない。",
          "memory": "看板の小さな自撮りを、私は通るたび見てしまう。",
          "tone": "pragmatic",
          "effects": [
            { "type": "recruitmentDecision", "fighterId": "ushiro", "decision": "decline" }
          ],
          "goto": "ushiro.join.node.end.001"
        }
      ]
    },
    {
