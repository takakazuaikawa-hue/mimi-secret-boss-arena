      }
    },
    {
      "type": "direction",
      "id": "ushiro.join.node.direction.character.001",
      "command": {
        "type": "show",
        "assetId": "ushiro.join.asset.sprite.character",
        "actorId": "ushiro",
        "slot": "right",
        "scale": "tall"
      }
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.001a",
      "lineId": "ushiro.join.line.001a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "うしろの選手登録で、想定通りの難所に着いた。"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.001b",
      "lineId": "ushiro.join.line.001b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "顔写真だ。カメラを向けると、彼は反射的に「相手の背後」へ回ってしまう。"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.001c",
      "lineId": "ushiro.join.line.001c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "撮影者の背後に回られると、写真には何も写らない。"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.002a",
      "lineId": "ushiro.join.line.002a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "撮影係を三人に増やしてみた。三人の背後に、三人ぶんの彼が回った。"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.002b",
      "lineId": "ushiro.join.line.002b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "分身は増えるのに、写真は増えない。従業員通路は、静かな鬼ごっこ会場と化した。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.003a",
      "lineId": "ushiro.join.line.003a",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "すみません……。正面から見られると、体が勝手に。"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.003b",
      "lineId": "ushiro.join.line.003b",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "……長年の、職業病で。耳が、しゅんと倒れた。"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.003c",
      "lineId": "ushiro.join.line.003c",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "かわいそうに。"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.004a",
      "lineId": "ushiro.join.line.004a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "提出済みの写真候補は三枚。後頭部、後頭部、ブレた後頭部。"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.004b",
      "lineId": "ushiro.join.line.004b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "登録課は全部差し戻してきた。ごもっともだ。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.005a",
      "lineId": "ushiro.join.line.005a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "……分かりました。"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.005b",
      "lineId": "ushiro.join.line.005b",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "カメラマンの背後に回っちゃうなら——カメラマンを、あなたにすればいいんです。"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.006a",
      "lineId": "ushiro.join.line.006a",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "……?　私が私を撮ると、私は私の背後に回るのでは……回れ、ない……?"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.007a",
      "lineId": "ushiro.join.line.007a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "自分の背後には、回れない。うしろ史上初の盲点だった。"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.007b",
      "lineId": "ushiro.join.line.007b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "カメラを彼の手に渡し、腕を伸ばしてレンズを自分へ。世に言う、自撮りだ。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.008a",
      "lineId": "ushiro.join.line.008a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "シャッター音。画面には、初めての正面の彼が写っていた。"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.008b",
      "lineId": "ushiro.join.line.008b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "緊張で目が泳いで、ピースの位置が高い。でも、写っていた。"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.008c",
      "lineId": "ushiro.join.line.008c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "百二十七人が通路に出てきて、一枚の画面を代わる代わる覗き込んだ。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.009a",
      "lineId": "ushiro.join.line.009a",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "……これが、私。……前から見ると、こういう顔を、していたのですね。"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.010a",
      "lineId": "ushiro.join.line.010a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "自分の顔を初めて見る人の声を、私は初めて聞いた。登録写真の欄は、この一枚で埋まった。"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.010b",
      "lineId": "ushiro.join.line.010b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "世界一時間のかかった自撮りとして、登録課の伝説になった。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "ushiro.join.node.line.011a",
      "lineId": "ushiro.join.line.011a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "残る欄は、あと少し。締め方を決める。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "ushiro.join.node.choice.001",
      "choices": [
        {
          "id": "ushiro.join.choice.001",
          "label": "最後列へ空席を一つ残し、見えない返事を待つ",
          "result": "契約欄の署名は「見られていない場所でなら」書けるという。書類を置いて廊下の角まで下がると、三分後、署名が済んでいた。「待っていてくれたことは、背中で分かりました」背中で分かる人と、契約した。",
          "intent": "見られない自由を保ったまま、迎える",
          "promise": "登録は少し遅れるが、この人専用の成長ポイントを得る。",
          "memory": "「背中で分かりました」の付記を、私は大事にしている。",
          "tone": "tender",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "ushiro"
              },
              "mode": "add",
              "trust": 8,
              "ownership": -3
            },
            {
              "type": "fighterPoints",
              "target": {
                "type": "fighter",
                "fighterId": "ushiro"
              },
              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "ushiro",
              "decision": "join"
            }
          ],
          "goto": "ushiro.join.node.end.001"
        },
        {
          "id": "ushiro.join.choice.002",
          "label": "欠席者のまま、選手名簿へ登録する",
          "result": "備考欄に「常に出席していますが、見えない場合があります」と書いて提出。登録課は三十分悩み、新区分「在席(不可視)」を作った。うちが通ったあとの書式は、だいたい豊かになる。",
          "intent": "見えないままでも、正式な席を作る",
          "promise": "本人の緊張は残るが、誰にでも使える成長ポイントを得る。",
          "memory": "区分「在席(不可視)」の発明を、登録課は少し誇りにしている。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "ushiro"
              },
              "mode": "add",
              "trust": 0,
              "ownership": 8
            },
            {
              "type": "sharedPoints",
              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "ushiro",
              "decision": "join"
            }
          ],
          "goto": "ushiro.join.node.end.001"
        },
        {
          "id": "ushiro.join.choice.003",
          "label": "今回はうしろを誘わず、別の機会を待つ",
          "result": "「登録は、またの機会に」彼は少しほっとして、初めての自撮りだけは大事そうに持ち帰った。翌週、見守りオプションの案内看板に、スタッフ紹介としてあの自撮りが貼られていた。彼のペースで、進んでいる。",
          "intent": "今回はチームへ誘わない",
          "promise": "今回の所属は見送るが、人物の物語と再会の可能性は失わない。",
          "memory": "看板の小さな自撮りを、私は通るたび見てしまう。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "recruitmentDecision",
              "fighterId": "ushiro",
              "decision": "decline"
            }
          ],
          "goto": "ushiro.join.node.end.001"
        }
      ]
    },
    {
