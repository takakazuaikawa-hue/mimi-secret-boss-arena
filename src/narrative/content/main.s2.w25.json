{
  "schemaVersion": 1,
  "id": "main.s2.w25",
  "kind": "opening",
  "title": "前夜、記録の外の笑い方",
  "summary": "決勝前夜。誰も観ていない砂場で、伝説の再現体が型を繰り返していた",
  "ownership": {
    "arcId": "main.stage2"
  },
