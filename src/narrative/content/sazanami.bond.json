      "choices": [
        {
          "id": "sazanami.bond.choice.001",
          "label": "海が見える窓辺で、小さな水槽の散歩をする",
          "result": "歩いたのは私で、水槽は台車、本人は海より大きい。散歩の定義は崩れたが、機嫌はよかった。",
          "intent": "相手の秘密の勝ち方を試す",
          "promise": "読みにくい作戦になる代わりに、この人だけの成長を大きく進める。",
          "memory": "任せた一戦の手応えが、次に力を見せる理由になる。",
          "tone": "wild",
          "effects": [
            {
              "type": "relationship",
              "target": {
