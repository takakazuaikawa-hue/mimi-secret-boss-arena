  "presentation": {
    "location": "噴水広場",
    "assets": [
      {
        "id": "sazanami.bond.asset.background.001",
        "kind": "background",
        "path": "/assets/story/bg-casino-cafe-rain.png",
        "alt": "噴水広場の背景"
