{
  "schemaVersion": 1,
  "id": "main.s1.w22",
  "kind": "opening",
  "title": "書類不備",
  "summary": "四度目の復興と、本人同意欄の空白。選手たちが帰ってくる",
  "ownership": {
    "arcId": "main.stage1"
  },
  "trigger": {
