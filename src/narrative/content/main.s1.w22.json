  },
  "presentation": {
    "location": "搬入口(復興の資材置き場)",
    "assets": [
      {
        "id": "main.s1.w22.asset.background.001",
        "kind": "background",
        "path": "/assets/story/bg-loading-dock-day-v1.png",
        "alt": "資材の集まる搬入口の背景"
      },
      {
        "id": "main.s1.w22.asset.sprite.mimi.serious",
