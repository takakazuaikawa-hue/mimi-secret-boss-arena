{
  "schemaVersion": 1,
  "id": "ushiro.crisis",
  "kind": "character",
  "title": "影、貸します(百二十七体)",
  "summary": "黒い角封筒。会社が影を警備員としてバラ売りしようとする",
  "ownership": {
    "arcId": "character.ushiro",
    "characterId": "ushiro",
