  "nodes": [
    {
      "type": "line",
      "id": "ushiro.crisis.node.line.001",
      "lineId": "ushiro.crisis.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "アルデバラン社から届いた契約確認書には、うしろの扱いを決める欄が残っていた。本人の意思を聞くため、鏡のない部屋へ向かった。"
    },
    {
      "type": "line",
      "id": "ushiro.crisis.node.line.002",
      "lineId": "ushiro.crisis.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "その週、相手は私を避けた。廊下の向こうに姿を見つけても、業務用の言葉だけを残して先に曲がる。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "ushiro.crisis.node.line.003",
      "lineId": "ushiro.crisis.line.003",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "会社は『観測対象指定』で影を一つの姿へ固定しようとしている。書類の余白から、細い指が逃げ道を探していた。"
    },
    {
      "type": "line",
      "id": "ushiro.crisis.node.line.004",
      "lineId": "ushiro.crisis.line.004",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "契約は振り返る命令を禁じている。"
    },
    {
      "type": "direction",
      "id": "ushiro.crisis.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "ushiro.crisis.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "direction",
      "id": "ushiro.crisis.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "shake"
      }
    },
    {
      "type": "line",
      "id": "ushiro.crisis.node.line.005",
      "lineId": "ushiro.crisis.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "うしろの返事が短い。怒っている、と決めれば私の不安には名前がつく。でも以前の私も「見つかりたくないから背後へ隠れているのだ」と決めつけた。また同じ読み違いをするところだった。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "ushiro.crisis.node.line.006",
      "lineId": "ushiro.crisis.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "嫌われたのなら理由を聞けばいい。そう思うのに、いつの間にか軽くなっていた二本目の飲み物を見るたび、聞いた答えで今までの時間が変わるのが怖かった。"
    },
    {
      "type": "line",
      "id": "ushiro.crisis.node.line.007",
      "lineId": "ushiro.crisis.line.007",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "見えるようになれば、戦いやすいとは思います。でも、それであなたが消えるなら意味がない。"
    },
    {
      "type": "line",
      "id": "ushiro.crisis.node.line.008",
      "lineId": "ushiro.crisis.line.008",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "じゃあ、今ここで振り返ります。"
    },
    {
      "type": "line",
      "id": "ushiro.crisis.node.line.009",
      "lineId": "ushiro.crisis.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ようやく追いついた場所で、うしろは正面を持たず、振り返られた瞬間に別の背後へ消える影に戻っていた。近づく前の、何も期待していなかった顔だ。"
    },
    {
      "type": "line",
      "id": "ushiro.crisis.node.line.010",
      "lineId": "ushiro.crisis.line.010",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "見えないものを信じるのは、命令するより難しい。"
    },
    {
      "type": "line",
      "id": "ushiro.crisis.node.line.011",
      "lineId": "ushiro.crisis.line.011",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "待って。まだ、消えたくない。"
    },
    {
      "type": "line",
      "id": "ushiro.crisis.node.line.012",
      "lineId": "ushiro.crisis.line.012",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "原因は私への不信ではない。見つけてもらうことと、形を決められることが同じになることから私を遠ざけようとしている。そのやさしさを、やさしいまま受け入れてはいけない気がした。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "ushiro.crisis.node.line.013",
      "lineId": "ushiro.crisis.line.013",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "背後の気配が少し近づいた。肩へ触れない距離で、返事を待っている。"
    },
    {
      "type": "line",
      "id": "ushiro.crisis.node.line.014",
      "lineId": "ushiro.crisis.line.014",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "一人で全員の背後へ立てるのに、記念写真では一席ぶんだけ遠慮する。別れ話のように静かな場面なのに、施設全体は最終災害手順へ移行している。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "ushiro.crisis.node.line.015",
      "lineId": "ushiro.crisis.line.015",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "正しい答えを当てることより、間違えたまま命令しないことを選ぶ。私は逃げ道をふさがない位置で止まり、聞きたかったことを短い言葉にした。",
      "emotion": "resolve"
    },
    {
      "type": "line",
      "id": "ushiro.crisis.node.line.016",
      "lineId": "ushiro.crisis.line.016",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "守るために離れるのは、残された側へ選択を渡さない。命令と同じだと告げると、初めて相手の表情が崩れた。",
      "emotion": "resolve"
    },
    {
      "type": "line",
      "id": "ushiro.crisis.node.line.017",
      "lineId": "ushiro.crisis.line.017",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "勝つための答えと、あとで自分を嫌いにならない答えは、同じとは限らない。"
    },
    {
      "type": "line",
      "id": "ushiro.crisis.node.line.018",
      "lineId": "ushiro.crisis.line.018",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "私は勝利を約束しない。安全も約束できない。ただ、振り返らなくても存在を疑われない距離で歩くことを諦める判断だけは本人へ返すと決めた。"
    },
    {
      "type": "line",
      "id": "ushiro.crisis.node.line.019",
      "lineId": "ushiro.crisis.line.019",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "並んで戻る廊下には、まだ一人分の距離がある。でも今度の沈黙は拒絶ではなく、同じ答えを考えるためのものだった。",
      "emotion": "tender"
    },
    {
      "type": "choice",
      "id": "ushiro.crisis.node.choice.001",
      "choices": [
        {
          "id": "ushiro.crisis.choice.001",
          "label": "誰にも観測されない位置から味方を守る",
          "result": "誰にも見られない位置から影が伸び、倒れかけた味方を支えた。観測されなくても選べる行動が、うしろ自身の技になった。",
          "intent": "この人だけの突破法へ賭ける",
          "promise": "予測しにくい方法を試し、この人専用の成長を大きく進める。",
          "memory": "危機で選んだ方法は、契約を解く場面でも二人の共通の記憶として戻る。",
          "tone": "wild",
          "effects": [
            {
