  "nodes": [
    {
      "type": "direction",
      "id": "wolf-nine.crisis.node.direction.001",
      "command": { "type": "background", "assetId": "wolf-nine.crisis.asset.background.001", "transition": "dissolve" }
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.001",
      "lineId": "wolf-nine.crisis.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "黒い角封筒。差出人、アルデバラン社・物語資産管理部。件名——「資産『九戦目』の興行化について」。同封書類の表紙にはこうあった。「感動の九戦目・完全台本(勝敗決定済み)」。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.002",
      "lineId": "wolf-nine.crisis.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "会社は、彼が八年温めてきた「九戦目」を、対戦相手も、展開も、決着の一撃まで決めた興行として売る気だった。台本の結末は、涙の大勝利。八敗の狼が、ついに勝つ物語。——偽物の。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.003",
      "lineId": "wolf-nine.crisis.line.003",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "決闘場で彼を見つけた時、彼は台本を膝に置いて、九本目の白い旗を見上げていた。怒声を予想していた。違った。声は、静かだった。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.004",
      "lineId": "wolf-nine.crisis.line.004",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "……なあ、ミミ。この台本、読んだか。よく書けてるんだ。九戦目の相手は強大で、俺は満身創痍で、最後の一撃で勝つ。観客は泣くだろうな。……俺が八年欲しかったものが、全部書いてある。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.005",
      "lineId": "wolf-nine.crisis.line.005",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "……受けたいん、ですか。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.006",
      "lineId": "wolf-nine.crisis.line.006",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "惨めな話だがな。……一瞬、迷った。台本でもいい、九戦目が永遠に来ないよりは——ってな。八年は、長いんだ。白い旗ってのは、重いんだ。"
    },
    {
      "type": "direction",
      "id": "wolf-nine.crisis.node.direction.002",
      "command": { "type": "effect", "effectId": "shake" }
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.007",
      "lineId": "wolf-nine.crisis.line.007",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "初めて聞く、弱音だった。全部を勝負にする人が、たった一つの本物の勝負に飢えて、偽物に手が伸びかけている。ここで説教をしたら、負けだと思った。この人に届く言葉は、いつだって勝負の言葉だ。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.008",
      "lineId": "wolf-nine.crisis.line.008",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "ヴォルフ・ナインさん。ひとつ、聞きます。台本の九戦目が終わった朝、あなたは食堂で、胸を張って「決着がつかん！」って吠えられますか。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.009",
      "lineId": "wolf-nine.crisis.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "長い沈黙。彼は台本を見て、白い旗を見て、それから、喉の奥で唸った。あいこ二十七連続の成績表。延長戦という名のおかわり。決着のつかない毎日の、あの騒がしい食卓を、思い出している顔だった。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.010",
      "lineId": "wolf-nine.crisis.line.010",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "……吠えられんな。台本の勝ちじゃ、あの食卓に、座る資格がない。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.011",
      "lineId": "wolf-nine.crisis.line.011",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "彼は立ち上がり、台本の返送封筒に、几帳面に封蝋を押した。差出人欄の書き方が、完全に果たし状のそれだった。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.012",
      "lineId": "wolf-nine.crisis.line.012",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "返送の備考にはこう書いた。「九戦目の相手は、自分で選ぶ。結果は、当日のお楽しみ。——それが決闘だ、素人ども」。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.013",
      "lineId": "wolf-nine.crisis.line.013",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "物語資産管理部への果たし状(実質)が、投函された。あとは、会社が用意した「台本の対戦相手」との公式戦が残っている。台本なしで、どう迎え撃つかだ。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "wolf-nine.crisis.node.choice.001",
      "choices": [
        {
          "id": "wolf-nine.crisis.choice.001",
          "label": "九戦目を一撃だけの決闘にする",
          "result": "台本の相手が出てきた公式戦。ヴォルフは開幕、相手に一礼して言った。「あんたに台本は要らん。一撃で来い。俺も一撃で行く」。互いの最高の一撃が、中央で交差した。決着は、ついた——が、どちらが勝ったかより、両者が台本を破り捨てて全力を出したことに、会場は沸いた。物語資産管理部の担当者は、用意していた「感動の演出」のきっかけを、最後まで押せなかった。本物の前で、偽物のボタンは押せない。",
          "intent": "台本のない一撃で、本物を見せる",
          "promise": "危険を引き受け、この人専用の成長を最大まで進める。",
          "memory": "一撃の交差を、観客は「台本破りの一撃」と呼んでいる。",
          "tone": "wild",
          "effects": [
            { "type": "relationship", "target": { "type": "fighter", "fighterId": "wolf-nine" }, "mode": "add", "trust": 12, "ownership": -10 },
            { "type": "fighterPoints", "target": { "type": "fighter", "fighterId": "wolf-nine" }, "amount": 6 }
          ],
          "goto": "wolf-nine.crisis.node.effect.001"
        },
        {
          "id": "wolf-nine.crisis.choice.002",
          "label": "過去八敗の型を順番に敵へ返す",
          "result": "公式戦で、彼は八つの型を第一から順に全部使った。八人の強敵から持ち帰った八年ぶんの回答を、一戦に全部。台本には「苦戦の末の逆転」と書いてあったらしいが、現実は「八重の胸借りの完封」だった。試合後、彼は台本を相手に手渡した。「これはあんたのだ。破るなり、燃やすなり、勝負の記念にするなり、好きにしな」。相手は記念にしたそうだ。",
          "intent": "八敗の重みで、台本を上書きする",
          "promise": "本人の九戦目は温存し、チーム全体へ使える成長を持ち帰る。",
          "memory": "八つの型の完封を、解説席は「八人がかりの勝利」と評した。",
          "tone": "pragmatic",
          "effects": [
            { "type": "relationship", "target": { "type": "fighter", "fighterId": "wolf-nine" }, "mode": "add", "trust": -2, "ownership": 10 },
            { "type": "sharedPoints", "amount": 6 }
          ],
          "goto": "wolf-nine.crisis.node.effect.001"
        }
      ]
    },
