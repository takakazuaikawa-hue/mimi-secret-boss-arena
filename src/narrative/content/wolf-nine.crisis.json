      }
    },
    {
      "type": "direction",
      "id": "wolf-nine.crisis.node.direction.character.001",
      "command": {
        "type": "show",
        "assetId": "wolf-nine.crisis.asset.sprite.character",
        "actorId": "wolf-nine",
        "slot": "right",
        "scale": "standard"
      }
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.001a",
      "lineId": "wolf-nine.crisis.line.001a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ヴォルフ・ナインの私書箱に、九通目が届いていた。差出人は、本人ではない。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.001b",
      "lineId": "wolf-nine.crisis.line.001b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "中身も挑戦状ではなく、台本だった。表紙に『第九戦・進行台本(勝敗確定稿)』。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.001c",
      "lineId": "wolf-nine.crisis.line.001c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "八年待った一通の隣に、勝ち負けの決まった紙が並ぶ。黒い角封筒は、その台本の封筒だった。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.002a",
      "lineId": "wolf-nine.crisis.line.002a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "会社は「九戦目」の相手も展開も、決着の一撃まで決めていた。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.002b",
      "lineId": "wolf-nine.crisis.line.002b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "台本の結末は、涙の大勝利。八敗の狼が勝つ物語——偽物の。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.003a",
      "lineId": "wolf-nine.crisis.line.003a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "決闘場で彼を見つけた時、台本を膝に置いて、白い旗を見上げていた。怒声を予想していた。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.003b",
      "lineId": "wolf-nine.crisis.line.003b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "耳が、こわばった。違った。声は、静かだった。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.004a",
      "lineId": "wolf-nine.crisis.line.004a",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "……なあ、ミミ。この台本、読んだか。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.004b",
      "lineId": "wolf-nine.crisis.line.004b",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "よく書けてるんだ。九戦目の相手は強大で、俺は満身創痍で、最後の一撃で勝つ。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.004c",
      "lineId": "wolf-nine.crisis.line.004c",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "観客は泣くだろうな。……俺が八年欲しかったものが、全部書いてある。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.005a",
      "lineId": "wolf-nine.crisis.line.005a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "……受けたいん、ですか。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.006a",
      "lineId": "wolf-nine.crisis.line.006a",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "惨めな話だがな。……一瞬、迷った。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.006b",
      "lineId": "wolf-nine.crisis.line.006b",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "台本でもいい、九戦目が永遠に来ないよりは——ってな。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.006c",
      "lineId": "wolf-nine.crisis.line.006c",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "八年は、長いんだ。白い旗ってのは、重いんだ。"
    },
    {
      "type": "direction",
      "id": "wolf-nine.crisis.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "shake"
      }
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.007a",
      "lineId": "wolf-nine.crisis.line.007a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "初めて聞く、弱音だった。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.007b",
      "lineId": "wolf-nine.crisis.line.007b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "全部を勝負にする人が、本物の勝負に飢えて、偽物に手が伸びかけている。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.007c",
      "lineId": "wolf-nine.crisis.line.007c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "説教をしたら、負ける。届く言葉は、いつも勝負の言葉だ。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.008a",
      "lineId": "wolf-nine.crisis.line.008a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "ヴォルフ・ナインさん。ひとつ、聞きます。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.008b",
      "lineId": "wolf-nine.crisis.line.008b",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "台本の九戦目が終わった朝、食堂で胸を張って「決着がつかん!」と吠えられますか。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.009a",
      "lineId": "wolf-nine.crisis.line.009a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "長い沈黙。彼は台本を見て、白い旗を見て、喉の奥で唸った。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.009b",
      "lineId": "wolf-nine.crisis.line.009b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "あいこ二十七連続の成績表。延長戦という名のおかわり。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.009c",
      "lineId": "wolf-nine.crisis.line.009c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "決着のつかない、あの騒がしい食卓を、思い出している顔だった。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.010a",
      "lineId": "wolf-nine.crisis.line.010a",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "……吠えられんな。台本の勝ちじゃ、あの食卓に、座る資格がない。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.011a",
      "lineId": "wolf-nine.crisis.line.011a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "彼は立ち上がり、返送封筒に、几帳面に封蝋を押した。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.011b",
      "lineId": "wolf-nine.crisis.line.011b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "差出人欄の書き方が、完全に果たし状のそれだった。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.012a",
      "lineId": "wolf-nine.crisis.line.012a",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "返送の備考にはこう書いた。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.012b",
      "lineId": "wolf-nine.crisis.line.012b",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "「九戦目の相手は、自分で選ぶ。結果は、当日のお楽しみ。——それが決闘だ、素人ども」"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.013a",
      "lineId": "wolf-nine.crisis.line.013a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "物語資産管理部への果たし状(実質)が、投函された。"
    },
    {
      "type": "line",
      "id": "wolf-nine.crisis.node.line.013b",
      "lineId": "wolf-nine.crisis.line.013b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "あとは、会社が用意した台本の対戦相手との公式戦が残る。台本なしで、どう迎え撃つかだ。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "wolf-nine.crisis.node.choice.001",
      "choices": [
        {
          "id": "wolf-nine.crisis.choice.001",
          "label": "九戦目を一撃だけの決闘にする",
          "result": "公式戦。ヴォルフは一礼して言った。「台本は要らん。一撃で来い」互いの最高の一撃が交差した。両者が台本を破り捨てたことに、会場は沸いた。本物の前で、偽物のボタンは押せない。",
          "intent": "台本のない一撃で、本物を見せる",
          "promise": "危険を引き受け、この人専用の成長を最大まで進める。",
          "memory": "一撃の交差を、観客は「台本破りの一撃」と呼んでいる。",
          "tone": "wild",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "wolf-nine"
              },
