  "presentation": {
    "location": "存在しない地下階",
    "assets": [
      {
        "id": "cassim-bell.power.asset.background.001",
        "kind": "background",
        "path": "/assets/story/bg-observation-deck-night.png",
        "alt": "存在しない地下階の背景"
