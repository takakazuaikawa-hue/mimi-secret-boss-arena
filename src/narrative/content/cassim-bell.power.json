{
  "schemaVersion": 1,
  "id": "cassim-bell.power",
  "kind": "character",
  "title": "存在しない地下階",
  "summary": "七つの扉の廊下。失われた世界の一枚を、二人で開ける",
  "ownership": {
    "arcId": "character.cassim-bell",
    "characterId": "cassim-bell",
    "stage": "power"
  },
  "trigger": {
    "actions": [
      "search"
    ],
    "when": {
      "all": [],
      "any": [],
      "none": []
    },
    "repeat": {
