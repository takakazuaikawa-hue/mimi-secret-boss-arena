              },
              "mode": "add",
              "trust": 0,
              "ownership": 9
            },
            {
              "type": "sharedPoints",
              "amount": 5
            }
          ],
          "goto": "cassim-bell.power.node.effect.001"
        }
      ]
    },
    {
      "type": "effect",
      "id": "cassim-bell.power.node.effect.001",
      "effects": [
        {
          "type": "setStoryStage",
