  "nodes": [
    {
      "type": "direction",
      "id": "wolf-nine.liberation.node.direction.001",
      "command": { "type": "background", "assetId": "wolf-nine.liberation.asset.background.001", "transition": "dissolve" }
    },
    {
      "type": "line",
      "id": "wolf-nine.liberation.node.line.001",
      "lineId": "wolf-nine.liberation.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "契約を終わらせる夜。無人の決闘場に、彼は九本の旗を全部立てて待っていた。解除届は、決闘の立会人みたいに、旗の下の台に置かれた。"
    },
    {
      "type": "line",
      "id": "wolf-nine.liberation.node.line.002",
      "lineId": "wolf-nine.liberation.line.002",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "所有者命令ってのはな、俺の流儀じゃ「セコンドの指示」だ。悪くなかったぞ、あんたのセコンドは。……だが、ここから先は、自分の名前で戦う。"
    },
    {
      "type": "line",
      "id": "wolf-nine.liberation.node.line.003",
      "lineId": "wolf-nine.liberation.line.003",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "判を押す。所有者命令の権限が消える。彼は解除届を果たし状みたいに丁寧に検分して、「良い書式だ」と及第点をくれた。うちの解除届は、狼の品質基準を通過した。",
      "emotion": "comic"
    },
    {
      "type": "direction",
      "id": "wolf-nine.liberation.node.direction.002",
      "command": { "type": "still", "assetId": "wolf-nine.liberation.asset.still.001" }
    },
    {
      "type": "direction",
      "id": "wolf-nine.liberation.node.direction.003",
      "command": { "type": "effect", "effectId": "pulse" }
    },
    {
      "type": "line",
      "id": "wolf-nine.liberation.node.line.004",
      "lineId": "wolf-nine.liberation.line.004",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "それでだ。自由になった記念に、渡すものがある。……受け取れ。"
    },
    {
      "type": "line",
      "id": "wolf-nine.liberation.node.line.005",
      "lineId": "wolf-nine.liberation.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "差し出されたのは、封蝋つきの手紙だった。宛名——「ミミ殿」。九通目の、挑戦状。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "wolf-nine.liberation.node.line.006",
      "lineId": "wolf-nine.liberation.line.006",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "く、九戦目！？　私が！？　人生で一番大事な勝負に使う番号じゃ……"
    },
    {
      "type": "line",
      "id": "wolf-nine.liberation.node.line.007",
      "lineId": "wolf-nine.liberation.line.007",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "中を読め。"
    },
    {
      "type": "line",
      "id": "wolf-nine.liberation.node.line.008",
      "lineId": "wolf-nine.liberation.line.008",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "封を開ける。果たし状の作法で始まる文面は、途中から、様子がおかしかった。「果たし合いの内容——今後、末永く。朝食九種目、席取り、消印の押し方、その他日常の全種目において、俺と真剣に競い続けること。決着は、急がない。持ち越しを、無限に認める」。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "wolf-nine.liberation.node.line.009",
      "lineId": "wolf-nine.liberation.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "九戦目は、一回の決闘じゃなかった。終わらない日常戦、全部だった。八年空白だった九本目の旗に使う相手として、私を選んだのだ。この、決闘の形をした——これは、たぶん、そういう手紙である。心臓が、九種目ぶん跳ねた。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "wolf-nine.liberation.node.line.010",
      "lineId": "wolf-nine.liberation.line.010",
      "speakerId": "legacy.speaker.1vj9fme",
      "speakerName": "ヴォルフ・ナイン",
      "mode": "dialogue",
      "text": "返事は今すぐでなくていい。決闘の返事は、じっくり書くのが作法だ。……だが、受けるなら、九本目の旗に、あんたの好きな色を塗れ。"
    },
    {
      "type": "line",
      "id": "wolf-nine.liberation.node.line.011",
      "lineId": "wolf-nine.liberation.line.011",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "返事の書き方を、決める。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "wolf-nine.liberation.node.choice.001",
      "choices": [
        {
          "id": "wolf-nine.liberation.choice.001",
          "label": "所有者命令を破棄し、九通目の挑戦状を返す",
          "result": "返事は、その場で書いた。決闘の作法で、封蝋つきで。「果たし状、謹んで受領。ただし対等な条件を要求する。私が勝ったら、朝食のジャム塗り選手権の審査基準を、私が決める」。彼は文面を読んで、決闘場中に響く声で笑い、九本目の白い旗を指した。翌朝、旗はカジノバニーの制服と同じ色に塗られていた。塗ったのは、私ではない。",
          "intent": "九戦目を、対等な条件で受ける",
          "promise": "所有者名を消し、本人が自分の名で次の試合を選べるようにする。",
          "memory": "制服色の九本目の旗は、決闘場の名物になっている。",
          "tone": "defiant",
          "effects": [
            { "type": "relationship", "target": { "type": "fighter", "fighterId": "wolf-nine" }, "mode": "add", "trust": 10, "ownership": 0 },
            { "type": "liberationDecision", "fighterId": "wolf-nine", "decision": "release" }
          ],
          "goto": "wolf-nine.liberation.node.effect.001"
        },
        {
          "id": "wolf-nine.liberation.choice.002",
          "label": "契約を解き、決勝を最初の対等な決闘にする",
          "result": "「返事の前に、一つだけ前哨戦を」と私は言った。「決勝戦、チームとして勝ちましょう。あなたが自由な選手として戦う、最初の公式戦です」。彼は牙を見せて笑った。「いいだろう。決勝が終わったら、九戦目の返事を聞く。……逃げるなよ、ミミ殿」。逃げませんとも。持ち越しは、無限に認められているのだ。",
          "intent": "決勝を、自由な狼の初陣にする",
          "promise": "断る権利を返したうえで、決勝を一緒に戦う新しい約束を結ぶ。",
          "memory": "「逃げるなよ、ミミ殿」の宛名の呼び方を、私はまだ聞き慣れない。",
          "tone": "tender",
          "effects": [
            { "type": "relationship", "target": { "type": "fighter", "fighterId": "wolf-nine" }, "mode": "add", "trust": 6, "ownership": 0 },
            { "type": "sharedPoints", "amount": 4 },
            { "type": "liberationDecision", "fighterId": "wolf-nine", "decision": "release" }
          ],
          "goto": "wolf-nine.liberation.node.effect.001"
        }
      ]
    },
    {
      "type": "effect",
      "id": "wolf-nine.liberation.node.effect.001",
      "effects": [
        { "type": "setStoryStage", "fighterId": "wolf-nine", "stage": 6 },
        { "type": "setLiberationEligible", "fighterId": "wolf-nine", "eligible": false },
        { "type": "setLiberated", "fighterId": "wolf-nine", "liberated": true },
        { "type": "relationship", "target": { "type": "fighter", "fighterId": "wolf-nine" }, "mode": "set", "ownership": 0 }
      ]
