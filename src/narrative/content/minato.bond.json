{
  "schemaVersion": 1,
  "id": "minato.bond",
  "kind": "character",
  "title": "世界より難しい昼定食",
  "summary": "従業員食堂で「選ぶ練習」。誰も困らない選択を、初めて自分の手で",
  "ownership": {
    "arcId": "character.minato",
    "characterId": "minato",
