      "work",
      "rest"
    ],
    "when": {
      "all": [],
      "any": [],
      "none": []
    },
    "repeat": {
      "mode": "once-per-run"
    },
    "priority": 400,
    "weight": 1
  },
  "presentation": {
    "location": "噴水広場",
    "assets": [
      {
        "id": "amara.join.asset.background.001",
        "kind": "background",
        "path": "/assets/story/bg-fountain-plaza-day-v1.png",
        "alt": "噴水広場の背景"
      },
      {
        "id": "amara.join.asset.sprite.character",
        "kind": "sprite",
        "path": "/assets/battle/fighters/amara-v1.png",
        "alt": "天秤の裁定者アマラ"
      }
    ]
  },
  "nodes": [
    {
      "type": "direction",
      "id": "amara.join.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "amara.join.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "direction",
      "id": "amara.join.node.direction.character.001",
      "command": {
        "type": "show",
        "assetId": "amara.join.asset.sprite.character",
        "actorId": "amara",
        "slot": "right",
        "scale": "tall"
      }
    },
    {
      "type": "line",
      "id": "amara.join.node.line.001a",
      "lineId": "amara.join.line.001a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "選手登録の面談は十時、噴水広場。書類一式と、念のための茶葉を持っていく。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.001b",
      "lineId": "amara.join.line.001b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "前回の面談で、もう学んでる。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.002a",
      "lineId": "amara.join.line.002a",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "時間どおりですね。着席してください。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.002b",
      "lineId": "amara.join.line.002b",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "本日の議題、被告・所有者制度。参考人、ミミ。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.003a",
      "lineId": "amara.join.line.003a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "面接するのは私の側ですよね!?"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.004a",
      "lineId": "amara.join.line.004a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "噴水の縁に、白チョークで「参考人席」と書いてある。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.004b",
      "lineId": "amara.join.line.004b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "私の椅子だけ、もう用意されてた。この人の法廷は、出張する。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.005a",
      "lineId": "amara.join.line.005a",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "あなたの雇用契約書、第三条。「休憩は業務の状況により短縮できる」"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.006a",
      "lineId": "amara.join.line.006a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "なんで私の契約書を持ってるんですか!?"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.007a",
      "lineId": "amara.join.line.007a",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "証拠開示請求をしました。窓口のノノさんは親切ですね。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.008a",
      "lineId": "amara.join.line.008a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "個人情報が、いちばん正式な手続きで流出していた。近いうちにノノさんも開廷される気がする。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.009a",
      "lineId": "amara.join.line.009a",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "本法廷は、証人を喚問します。——噴水。証言を。"
    },
    {
      "type": "direction",
      "id": "amara.join.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "flash"
      }
    },
    {
      "type": "line",
      "id": "amara.join.node.line.010a",
      "lineId": "amara.join.line.010a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "水が、立ち上がった。噴水の水柱が空へ伸びて、光の中に映像を映す。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.010b",
      "lineId": "amara.join.line.010b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "休憩を削られて、水を替え損ねた飼育係。ひとり夜番の清掃係。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.010c",
      "lineId": "amara.join.line.010c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "そして、泣いているお客様の隣にいた、私。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.011a",
      "lineId": "amara.join.line.011a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "これ、全部……"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.012a",
      "lineId": "amara.join.line.012a",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "この広場の水が見てきた、返してもらえなかった時間たちです。あなただけでは、ない。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.013a",
      "lineId": "amara.join.line.013a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "水の中の私、ちゃんと笑ってた。あの十一分は、損じゃなかった。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.013b",
      "lineId": "amara.join.line.013b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "でも、それを「損じゃないなら良し」で終わらせない人が、目の前にいる。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.014a",
      "lineId": "amara.join.line.014a",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "結論を述べます。内部から規則を見る必要があります。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.014b",
      "lineId": "amara.join.line.014b",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "——私を、登録してください。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.015a",
      "lineId": "amara.join.line.015a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "スカウトしに来て、志願された。面談の攻守は、水柱ごと入れ替わった。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.016a",
      "lineId": "amara.join.line.016a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "じゃ、じゃあこの端末に入力を。……最後、「これから何をしたいか」の欄です。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.017a",
      "lineId": "amara.join.line.017a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "アマラさんの指が、初めて止まった。水柱が所在なさげに揺れて、静かに噴水へ帰っていく。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.018a",
      "lineId": "amara.join.line.018a",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "……過去の欄は、すべて埋まるのに。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.019a",
      "lineId": "amara.join.line.019a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "端末ごと机の中央へ戻して、お茶を淹れた。今度は、審理が始まる前に。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.019b",
      "lineId": "amara.join.line.019b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "急がせないのが、私にできる唯一の弁護。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.020a",
      "lineId": "amara.join.line.020a",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "……署名は、します。あなたの契約書の、弁護人欄に。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.020b",
      "lineId": "amara.join.line.020b",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "——素手で。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.021a",
      "lineId": "amara.join.line.021a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "アマラさんが手袋を、指先から一本ずつ外した。初めて見る素手が、ペンを取った。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.021b",
      "lineId": "amara.join.line.021b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「嘘がつけないので」紙を返すとき、指先が一瞬だけ触れた。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.021c",
      "lineId": "amara.join.line.021c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "耳が、忙しい。心臓が一個じゃ、足りない。",
      "emotion": "tension"
    },
    {
      "type": "choice",
      "id": "amara.join.node.choice.001",
      "choices": [
        {
          "id": "amara.join.choice.001",
          "label": "登録の前に、契約書への異議を最後まで聞く",
          "result": "論告は二時間、契約書は付箋で三倍の厚さに。閉廷は「弁護方針会議を、これにて終わります」志望動機は空欄のまま「決まったら、法廷で」箸袋に「本参考人の茶は開廷前に出た、異例」とあった",
          "intent": "本人の戦い方と、怒ってくれた理由を知る",
          "promise": "登録は少し遅れるが、この人専用の成長ポイントを得る。",
          "memory": "互いの契約の弁護人を引き受け合った面談として、アマラは今日を覚えている。",
          "tone": "tender",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "amara"
              },
              "mode": "add",
              "trust": 8,
              "ownership": -3
            },
            {
              "type": "fighterPoints",
              "target": {
