{
  "schemaVersion": 1,
  "id": "amara.join",
  "kind": "character",
  "title": "出張法廷、参考人・ミミ",
  "summary": "選手登録の面談のはずが、ミミの雇用契約が審理される",
  "ownership": {
    "arcId": "character.amara",
    "characterId": "amara",
