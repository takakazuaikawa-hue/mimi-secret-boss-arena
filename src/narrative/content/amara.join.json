                "fighterId": "amara"
              },
              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "amara",
              "decision": "join"
            }
          ],
          "goto": "amara.join.node.end.001"
        },
        {
          "id": "amara.join.choice.002",
          "label": "監査権限つきの選手証を先に発行する",
          "result": "選手証は九十秒で出た。今週、予定どおり終わった最初の仕事。翌朝、机に出頭通知。「第二回公判、被告・所有者ミミ。ただし茶の差し入れは許可する」権限には、説明書より先に責任が来る",
          "intent": "次の公式戦へ間に合わせる",
          "promise": "本人の詳細は後回しになるが、誰にでも使える成長ポイントを得る。",
          "memory": "先に席を確保した判断を、アマラは「審理未了のまま執行された」と記録している。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
