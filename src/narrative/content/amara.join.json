{
  "schemaVersion": 1,
  "id": "amara.join",
  "kind": "character",
  "title": "噴水は見ていた",
  "summary": "スカウト面談で噴水が証言台に立ち、素手の署名で指が触れる",
  "ownership": {
    "arcId": "character.amara",
    "characterId": "amara",
