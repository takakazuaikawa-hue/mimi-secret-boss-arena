      "mode": "once-per-run"
    },
    "priority": 400,
    "weight": 1
  },
  "presentation": {
    "location": "噴水広場",
    "assets": [
      {
        "id": "amara.join.asset.background.001",
        "kind": "background",
        "path": "/assets/story/bg-employee-entrance.png",
        "alt": "噴水広場の背景"
      }
    ]
  },
  "nodes": [
    {
      "type": "line",
      "id": "amara.join.node.line.001",
      "lineId": "amara.join.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "選手登録の面談、十時から、噴水広場で。書類一式と、念のための茶葉を持って行く。前回で学習はしている。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.002",
      "lineId": "amara.join.line.002",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "時間どおりですね。着席してください。本日の議題、被告・所有者制度。参考人、ミミ。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.003",
      "lineId": "amara.join.line.003",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "面接するのは私の側ですよね！？"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.004",
      "lineId": "amara.join.line.004",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "噴水の縁に、白いチョークで丁寧に「参考人席」。私の椅子だけ、もう用意されていた。この人の法廷は、出張する。",
      "emotion": "comic"
    },
    {
      "type": "direction",
      "id": "amara.join.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "amara.join.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "direction",
      "id": "amara.join.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "pulse"
      }
    },
    {
      "type": "line",
      "id": "amara.join.node.line.005",
      "lineId": "amara.join.line.005",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "始めます。あなたの雇用契約書、第三条。「休憩は業務の状況により短縮できる」。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.006",
      "lineId": "amara.join.line.006",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "なんで私の契約書を持ってるんですか。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.007",
      "lineId": "amara.join.line.007",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "証拠開示請求をしました。窓口のノノさんは親切ですね。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.008",
      "lineId": "amara.join.line.008",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "個人情報が、いちばん正式な手続きで流出していた。近いうちにノノさんも開廷される気がする。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.009",
      "lineId": "amara.join.line.009",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "第三条、赤字。第七条、赤字。兎耳手当、不存在。……この契約は、あなたを守っていない。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.010",
      "lineId": "amara.join.line.010",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "赤ペンが止まらない。私の契約書が、みるみる誰かの採点済み答案みたいになっていく。……この人、怒ってくれているのだ。遅れて気づいて、参考人席が少しだけ座り心地よくなった。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.011",
      "lineId": "amara.join.line.011",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "それで、あの、今日は選手登録の面談で……"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.012",
      "lineId": "amara.join.line.012",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "その件です。結論から述べます。内部から規則を見る必要があります。——私を、登録してください。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.013",
      "lineId": "amara.join.line.013",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "スカウトしに来て、志願された。面談の攻守は、開始四分で入れ替わった。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.014",
      "lineId": "amara.join.line.014",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "じゃ、じゃあこの端末に入力を。……最後、「これから何をしたいか」の欄です。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.015",
      "lineId": "amara.join.line.015",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "アマラの指が、初めて止まった。重力さえ被告席へ呼べる人が、十五文字の空欄の前で動かない。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.016",
      "lineId": "amara.join.line.016",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "……過去の欄は、すべて埋まるのに。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.017",
      "lineId": "amara.join.line.017",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ペンを貸して私が埋めれば、面談は五分で終わる。でもそれは、彼女が私の契約書にしたことと逆向きの同じ失礼だ。私は空欄を端末ごと机の中央へ戻し、お茶を淹れた。今度は、審理が始まる前に。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.018",
      "lineId": "amara.join.line.018",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "……記録に残します。「参考人は、答えを急がせなかった」と。"
    },
    {
      "type": "line",
      "id": "amara.join.node.line.019",
      "lineId": "amara.join.line.019",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "判決ではない言葉が、これで二つ目。志望動機はまだ空欄のまま。でもマグの隣に、箸袋の異議申立て(第二号)が増えていた。「本参考人の茶は、開廷前に出た。異例である」。",
      "emotion": "revelation"
    },
    {
      "type": "choice",
      "id": "amara.join.node.choice.001",
      "choices": [
        {
          "id": "amara.join.choice.001",
          "label": "登録の前に、契約書への異議を最後まで聞く",
          "result": "論告は二時間に及び、私の雇用契約書は付箋で三倍の厚さになった。最後の一枚にアマラは「弁護人署名」の欄を勝手に作り、自分の名前を書いた。「あなたの契約の弁護人は、私が務めます」。志望動機の欄は、まだ空欄のまま。「決まったら、法廷で述べます」とのことだった。",
          "intent": "本人の戦い方と、怒ってくれた理由を知る",
          "promise": "登録は少し遅れるが、この人専用の成長ポイントを得る。",
          "memory": "契約の弁護人を引き受け合った面談として、アマラは今日を覚えている。",
          "tone": "tender",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "amara"
              },
              "mode": "add",
              "trust": 8,
              "ownership": -3
            },
            {
              "type": "fighterPoints",
              "target": {
                "type": "fighter",
                "fighterId": "amara"
              },
              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "amara",
              "decision": "join"
            }
          ],
          "goto": "amara.join.node.end.001"
        },
        {
          "id": "amara.join.choice.002",
          "label": "監査権限つきの選手証を先に発行する",
          "result": "選手証は九十秒で出た。今週、予定どおりに終わった最初の業務だった。翌朝、私の机には出頭通知。「第二回公判、被告・所有者ミミ。ただし被告には、茶の差し入れを許可する」。権限には、だいたい説明書より先に責任が来る。",
          "intent": "次の公式戦へ間に合わせる",
          "promise": "本人の詳細は後回しになるが、誰にでも使える成長ポイントを得る。",
          "memory": "先に席を確保した判断を、アマラは「審理未了のまま執行された」と記録している。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "amara"
              },
              "mode": "add",
              "trust": 0,
              "ownership": 8
            },
            {
              "type": "sharedPoints",
              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "amara",
              "decision": "join"
            }
          ],
          "goto": "amara.join.node.end.001"
        },
        {
          "id": "amara.join.choice.003",
          "label": "今回はアマラを誘わず、別の機会を待つ",
          "result": "「本日の面談は、審理未了で閉廷します」。アマラは書類を几帳面に揃えて返してくれた。私の契約書の赤字だけは、そのまま残して。「異議は、取り下げていません」。それが、再会の予約に聞こえた。",
          "intent": "今回はチームへ誘わない",
          "promise": "今回の所属は見送るが、人物の物語と再会の可能性は失わない。",
          "memory": "誘わなかった日の赤字を、二人とも取り下げていない。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "recruitmentDecision",
              "fighterId": "amara",
              "decision": "decline"
            }
          ],
          "goto": "amara.join.node.end.001"
        }
      ]
    },
    {
      "type": "end",
      "id": "amara.join.node.end.001",
      "mode": "return-to-week"
    }
  ],
