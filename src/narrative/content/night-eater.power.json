  "nodes": [
    {
      "type": "direction",
      "id": "night-eater.power.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "night-eater.power.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "night-eater.power.node.line.001",
      "lineId": "night-eater.power.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "深夜の第三コロシアム。観客はゼロ。今夜は特別許可をもらって、夜を食べるものの「本気」を確認する日だった。付き添いは私と、なぜか今夜もいる計測係の新人くん。"
    },
    {
      "type": "line",
      "id": "night-eater.power.node.line.002",
      "lineId": "night-eater.power.line.002",
      "speakerId": "legacy.speaker.ij983g",
      "speakerName": "夜を食べるもの",
      "mode": "dialogue",
      "text": "本気は、久しぶり。……お行儀悪くても、嫌いにならないで。"
    },
    {
      "type": "line",
      "id": "night-eater.power.node.line.003",
      "lineId": "night-eater.power.line.003",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "前置きが、もう不穏だった。彼女は客席の中央で息を吸い——会場の照明を、全部一息に飲み込んだ。",
      "emotion": "tension"
    },
    {
      "type": "direction",
      "id": "night-eater.power.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "flash"
      }
    },
    {
      "type": "line",
      "id": "night-eater.power.node.line.004",
      "lineId": "night-eater.power.line.004",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "闇が来た。ただの停電じゃない。空気の質が変わる、「本来の夜」。天井が消えて満天の星になり、飲み込まれた照明たちが、会場の上空に新しい星座として並んだ。得点板の電光数字だけが、蛍の群れになって客席を漂っている。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "night-eater.power.node.line.005",
      "lineId": "night-eater.power.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "新人くんの計測器は今夜も三秒で「規格外」、五秒で煙を吹いた。彼は暗闇の中、手探りで記録板に何か書いた。あとで見たら「くらい。きれい。」だった。今夜も的確である。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "night-eater.power.node.line.006",
      "lineId": "night-eater.power.line.006",
      "speakerId": "legacy.speaker.ij983g",
      "speakerName": "夜を食べるもの",
      "mode": "dialogue",
      "text": "これが、私の夜。試合でこれをやると……相手は、何も見えなくなる。味方も。"
    },
    {
      "type": "line",
      "id": "night-eater.power.node.line.007",
      "lineId": "night-eater.power.line.007",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "それで今まで、本気を出さなかったんですね。敵も味方も、まとめて閉店しちゃうから。"
    },
    {
      "type": "line",
      "id": "night-eater.power.node.line.008",
      "lineId": "night-eater.power.line.008",
      "speakerId": "legacy.speaker.ij983g",
      "speakerName": "夜を食べるもの",
      "mode": "dialogue",
      "text": "ええ。私の本気は、ひとりぼっちの技なの。……ずっと、そうだった。"
    },
    {
      "type": "line",
      "id": "night-eater.power.node.line.009",
      "lineId": "night-eater.power.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "その時、私の兎耳が、ぴくりと動いた。暗闇の中で、音の景色が妙にはっきり見える。新人くんの心拍、彼女の衣擦れ、蛍になった数字の羽音。——見えた。耳で、会場全体が。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "night-eater.power.node.line.010",
      "lineId": "night-eater.power.line.010",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "……夜を食べるものさん。私、この暗闇の中、耳で全部わかります。監督指示、出せます。"
    },
    {
      "type": "line",
      "id": "night-eater.power.node.line.011",
      "lineId": "night-eater.power.line.011",
      "speakerId": "legacy.speaker.ij983g",
      "speakerName": "夜を食べるもの",
      "mode": "dialogue",
      "text": "…………耳。……その耳、飾りじゃなかったの。"
    },
    {
      "type": "line",
      "id": "night-eater.power.node.line.012",
      "lineId": "night-eater.power.line.012",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "飾りだと思ってたんですか！？"
    },
    {
      "type": "line",
      "id": "night-eater.power.node.line.013",
      "lineId": "night-eater.power.line.013",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "かくして深夜の無人会場で、変な特訓が始まった。彼女が夜を広げ、私が耳で読んで、声で導く。「三歩右、椅子!」「その先、階段!」。ひとりぼっちの技が、二人の技に変わっていく。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "night-eater.power.node.line.014",
      "lineId": "night-eater.power.line.014",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "特訓の締めに、彼女は蛍になった得点板の数字を、一匹ずつ夜空へ帰した。最後の一匹「0」だけを手のひらに残して、私に見せる。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "night-eater.power.node.line.015",
      "lineId": "night-eater.power.line.015",
      "speakerId": "legacy.speaker.ij983g",
      "speakerName": "夜を食べるもの",
      "mode": "dialogue",
      "text": "ひとりぼっちの数、ゼロ。……今夜の得点は、これでいい。"
    },
    {
      "type": "line",
      "id": "night-eater.power.node.line.016",
      "lineId": "night-eater.power.line.016",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "うまいこと言った顔(たぶん)の影に、私は笑って、それから本題を思い出した。この夜を、試合でどう使うか。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "night-eater.power.node.choice.001",
      "choices": [
        {
          "id": "night-eater.power.choice.001",
          "label": "会場の夜を一口だけ食べてもらう",
          "result": "本番用に「一口ぶんの夜」を調整した。会場の一角だけを本来の夜にして、私の声が届く範囲で戦う型だ。リハーサルの最後、彼女は言った。「私の夜に、初めて他人の声がある。……悪くない。星、五つ」。食レポの癖は、直らないらしい。",
          "intent": "ひとりぼっちの技を、二人の技にする",
          "promise": "失敗時の危険を引き受け、この人専用の成長を最大まで進める。",
          "memory": "「私の夜に声がある」を、彼女は最高評価の言葉として使う。",
          "tone": "heroic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "night-eater"
              },
              "mode": "add",
              "trust": 10,
              "ownership": -4
            },
            {
              "type": "fighterPoints",
              "target": {
                "type": "fighter",
                "fighterId": "night-eater"
              },
              "amount": 5
            }
          ],
          "goto": "night-eater.power.node.effect.001"
        },
        {
          "id": "night-eater.power.choice.002",
          "label": "相手の影だけを食べる練習を重ねる",
          "result": "会場全体ではなく、相手の影だけを一口いただく精密技を深夜まで練習した。影を食べられた者は、自分の居場所が分からなくなるらしい。「行儀のいい食べ方」と彼女は呼び、新人くんは記録板に「こわい。じょうひん。」と書いた。チームの誰も、彼女の敵に回りたくないと思った夜だった。",
          "intent": "会場を巻き込まない精密な型を作る",
          "promise": "本来の力は一部に留め、チーム全体の成長へ成果を持ち帰る。",
          "memory": "「行儀のいい食べ方」の練習に付き合った夜を、チームは覚えている。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "night-eater"
              },
              "mode": "add",
              "trust": 0,
              "ownership": 9
            },
            {
              "type": "sharedPoints",
              "amount": 5
            }
          ],
          "goto": "night-eater.power.node.effect.001"
        }
      ]
    },
