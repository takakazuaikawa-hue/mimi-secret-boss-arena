  "nodes": [
    {
      "type": "line",
      "id": "minato.power.node.line.001",
      "lineId": "minato.power.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "練習のあと、ミナトに呼ばれて搬入口まで来た。いつもの力では足りない理由を、見せたいらしい。"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.002",
      "lineId": "minato.power.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "警報より先に、相手の声が私の名を呼んだ。いつもと同じ呼び方なのに、その一音だけで足が止まる。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.003",
      "lineId": "minato.power.line.003",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "返却済みの武器が、倉庫の壁越しに一斉に鳴った。金属音ではなく、遠い戦場から名前を呼ぶ声に聞こえる。"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.004",
      "lineId": "minato.power.line.004",
      "speakerId": "legacy.speaker.1vz3er0",
      "speakerName": "ミナト",
      "mode": "dialogue",
      "text": "返した剣が、僕を選んで戻ってきた。"
    },
    {
      "type": "direction",
      "id": "minato.power.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "minato.power.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "direction",
      "id": "minato.power.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "flash"
      }
    },
    {
      "type": "line",
      "id": "minato.power.node.line.005",
      "lineId": "minato.power.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "返却された神器が彼の迷いに反応し、倉庫一棟を戦場の空へ変えてしまう。そんな力が、目の前で息をしている。逃げる理由なら十分だった。それでも私は、力の大きさよりミナトが最初にどこを見るのかを確かめたかった。",
      "emotion": "tension"
    },
    {
      "type": "direction",
      "id": "minato.power.node.direction.003",
      "command": {
        "type": "still",
        "assetId": "minato.power.asset.still.001"
      }
    },
    {
      "type": "direction",
      "id": "minato.power.node.direction.004",
      "command": {
        "type": "effect",
        "effectId": "pulse"
      }
    },
    {
      "type": "line",
      "id": "minato.power.node.line.006",
      "lineId": "minato.power.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ミナトが私と危険の間へ立つ。触れてはいない。それでも、こちらへ届くはずだった圧力だけがきれいに二つへ割れた。"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.007",
      "lineId": "minato.power.line.007",
      "speakerId": "legacy.speaker.1vz3er0",
      "speakerName": "ミナト",
      "mode": "dialogue",
      "text": "あれを全部持てば勝てる。でも、また『必要だから』で選んだら、俺は前と同じ場所へ戻る。"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.008",
      "lineId": "minato.power.line.008",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "遺失物窓口の人が泣いてました。"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.009",
      "lineId": "minato.power.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "誰かに必要な役目があれば、迷わず正しい方を選べる人。けれど今見せている力は、勝つためではなく、私を怖がらせないために抑えられている。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.010",
      "lineId": "minato.power.line.010",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "じゃあ今度は、使いたい一本を選んでください。勝てるかどうかは、そのあと考えます。"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.011",
      "lineId": "minato.power.line.011",
      "speakerId": "legacy.speaker.1vz3er0",
      "speakerName": "ミナト",
      "mode": "dialogue",
      "text": "一本だけにします。今度は自分で選びたい。"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.012",
      "lineId": "minato.power.line.012",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "本気を見たいと思っていた。実際に目の前へ現れると、知りたかったのは強さではなく、その力を本人がどう恐れているかだった。"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.013",
      "lineId": "minato.power.line.013",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "彼は困ったように笑い、いちばん傷の少ない剣ではなく、柄に小さな花が彫られた短剣へ手を伸ばした。"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.014",
      "lineId": "minato.power.line.014",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "返却された神器が彼の迷いに反応し、倉庫一棟を戦場の空へ変えてしまう。闘技場の安全基準は一瞬で役に立たなくなり、担当者は私の顔を見て計測を諦めた。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.015",
      "lineId": "minato.power.line.015",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "世界を壊せることより、壊さないために何を選んだかが胸へ残った。必要だったのは新しい使命ではなく、何もしない日を選んでも見捨てられない確信だった。その理解が正しいか、いつか本人の言葉で確かめたい。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.016",
      "lineId": "minato.power.line.016",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "力の中心にあったのは、勇者でなくなった自分には、帰る場所も選ぶ理由もないこと。最強であることが、本人にとって一番古い傷なのだと分かる。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.017",
      "lineId": "minato.power.line.017",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "怖さが消えたわけではない。だからこそ、使うかどうかを本人と決める必要がある。"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.018",
      "lineId": "minato.power.line.018",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "大丈夫とは言えない。怖いものは怖い。それでも、次に力を使う時は一人で決めなくていいと伝えた。",
      "emotion": "resolve"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.019",
      "lineId": "minato.power.line.019",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "柄に小さな花が彫られた短剣だけが元の大きさで残り、さっきまで世界の終わりがいた場所に、帰り道の灯りが戻った。"
    },
    {
      "type": "choice",
      "id": "minato.power.node.choice.001",
      "choices": [
        {
          "id": "minato.power.choice.001",
          "label": "空の鞘だけで、かつての必殺技を再現する",
          "result": "斬撃は出なかった。代わりに敵が斬られるはずだった場所だけが静かに割れ、ミナトはようやく自分の力が剣の数ではないと知った。",
          "intent": "本来の力を一気に取り戻す",
          "promise": "失敗時の危険を引き受け、この人専用の成長を最大まで進める。",
          "memory": "力を恐れたまま任せたことを、相手は危機の場面で思い出す。",
          "tone": "heroic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "minato"
              },
              "mode": "add",
              "trust": 10,
              "ownership": -4
            },
            {
              "type": "fighterPoints",
              "target": {
                "type": "fighter",
                "fighterId": "minato"
              },
              "amount": 5
            }
          ],
          "goto": "minato.power.node.effect.001"
        },
        {
          "id": "minato.power.choice.002",
          "label": "四十七本を一本ずつ試し、安全な型を選ぶ",
          "result": "派手な一本は残らなかったが、誰が隣に立っても崩れない型ができた。返却票の裏が、そのままチームの手順書になった。",
          "intent": "安全な段階解除で確実に進む",
          "promise": "本来の力は一部に留め、チーム全体の成長へ成果を持ち帰る。",
          "memory": "全員で帰ると決めた手順が、危機で使える安全策として残る。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "minato"
              },
              "mode": "add",
              "trust": 0,
              "ownership": 9
            },
            {
              "type": "sharedPoints",
              "amount": 5
            }
          ],
          "goto": "minato.power.node.effect.001"
        }
      ]
    },
    {
      "type": "effect",
      "id": "minato.power.node.effect.001",
