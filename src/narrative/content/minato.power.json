  "nodes": [
    {
      "type": "direction",
      "id": "minato.power.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "minato.power.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "minato.power.node.line.001",
      "lineId": "minato.power.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "夜の搬入口に呼び出された。ミナトと、台車三台ぶんの神器四十七本。今夜は、彼が次の試合の「本気の形」を決める日だった。"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.002",
      "lineId": "minato.power.line.002",
      "speakerId": "legacy.speaker.1vz3er0",
      "speakerName": "ミナト",
      "mode": "dialogue",
      "text": "全部装備すれば、俺は世界を四十七回救った時の強さに戻れる。……戻れて、しまう。"
    },
    {
      "type": "direction",
      "id": "minato.power.node.direction.002",
      "command": {
        "type": "still",
        "assetId": "minato.power.asset.still.001"
      }
    },
    {
      "type": "direction",
      "id": "minato.power.node.direction.003",
      "command": {
        "type": "effect",
        "effectId": "pulse"
      }
    },
    {
      "type": "line",
      "id": "minato.power.node.line.003",
      "lineId": "minato.power.line.003",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "四十七本が、彼を取り囲んで浮いていた。全部が「使ってくれ」と光っている。壮観で、きれいで、少し悲しい。道具はまだ、物語の続きを信じているのだ。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.004",
      "lineId": "minato.power.line.004",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "戻りたいですか。その強さに。"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.005",
      "lineId": "minato.power.line.005",
      "speakerId": "legacy.speaker.1vz3er0",
      "speakerName": "ミナト",
      "mode": "dialogue",
      "text": "……いや。あの強さは、あの物語のものだ。今の俺の試合を、借り物の結末で戦いたくない。"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.006",
      "lineId": "minato.power.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "彼は一本ずつ、神器の柄に触れて回った。労いの言葉を一本にひとつ。四十七回の「ありがとう」は、聞いているこっちの目頭に悪い。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.007",
      "lineId": "minato.power.line.007",
      "speakerId": "legacy.speaker.1vz3er0",
      "speakerName": "ミナト",
      "mode": "dialogue",
      "text": "帰っていい。全員だ。——それぞれの物語の空へ。"
    },
    {
      "type": "direction",
      "id": "minato.power.node.direction.004",
      "command": {
        "type": "effect",
        "effectId": "flash"
      }
    },
    {
      "type": "direction",
      "id": "minato.power.node.direction.005",
      "command": {
        "type": "still",
        "assetId": "minato.power.asset.still.002"
      }
    },
    {
      "type": "line",
      "id": "minato.power.node.line.008",
      "lineId": "minato.power.line.008",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "四十七本が、一斉に空へ昇った。逆さまの流星群だった。光の尾が四十七本、夜を上へ上へと流れていく。搬入口の作業員さんたちが全員手を止めて、空を見上げた。誰かが小さく拍手して、それが伝染して、夜の搬入口が拍手で満ちた。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.009",
      "lineId": "minato.power.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "よく見ると、昇っていく光に、すれ違って降りてくる光もある。どこかの誰かの神器が、この街へ帰ってくるのだ。終わった物語の道具たちの、通勤ラッシュ。この空は、そういう空だった。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.010",
      "lineId": "minato.power.line.010",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "……一本だけ、残ってますよ。"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.011",
      "lineId": "minato.power.line.011",
      "speakerId": "legacy.speaker.1vz3er0",
      "speakerName": "ミナト",
      "mode": "dialogue",
      "text": "これは神器じゃない。……旅の三日目に、露店で買った土産物だ。花柄で、安物で、一度も世界を救っていない。"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.012",
      "lineId": "minato.power.line.012",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "花柄の短剣。四十七本の伝説の中で、たった一本だけの「ただの買い物」。彼が自分の意思で選んだ最初の一本が、最後まで残った。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.013",
      "lineId": "minato.power.line.013",
      "speakerId": "legacy.speaker.1vz3er0",
      "speakerName": "ミナト",
      "mode": "dialogue",
      "text": "次の試合は、こいつと足で戦う。世界を救った強さじゃなく、カレーを選べるようになった俺の強さで。"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.014",
      "lineId": "minato.power.line.014",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "空になった台車が三台、夜風にことりと鳴った。四十七枚の遺失物伝票に、私は今夜、全部「返却完了」の判を押せる。窓口係として、これほど誇らしい残業はない。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "minato.power.node.line.015",
      "lineId": "minato.power.line.015",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "確かめておくことは、あと一つ。神器なしの戦い方を、どう仕上げるかだ。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "minato.power.node.choice.001",
      "choices": [
        {
          "id": "minato.power.choice.001",
          "label": "空の鞘だけで、かつての必殺技を再現する",
          "result": "「見ててくれ」。彼は空の鞘で、四十七の物語の集大成を舞った。刃のない必殺技は、誰も傷つけられない代わりに、誰の目にも美しかった。舞い終わりの残心のまま、彼は言った。「刃は、もう要らなかったんだな」。夜空で、遅れて一本ぶんの流星が瞬いた。返事みたいに。",
          "intent": "伝説の技を、誰も傷つけない形で継ぐ",
          "promise": "失敗時の危険を引き受け、この人専用の成長を最大まで進める。",
          "memory": "刃のない必殺技の美しさを、見た者は忘れない。",
          "tone": "heroic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "minato"
              },
              "mode": "add",
              "trust": 10,
              "ownership": -4
            },
            {
              "type": "fighterPoints",
              "target": {
                "type": "fighter",
                "fighterId": "minato"
              },
              "amount": 5
            }
          ],
          "goto": "minato.power.node.effect.001"
        },
        {
          "id": "minato.power.choice.002",
          "label": "花柄の短剣に合う、新しい型を一から作る",
          "result": "伝説の再現はやめて、安物の短剣に合う新しい型を、深夜まで二人で考えた。踏み込み、隠し方、抜くと見せて抜かない間合い。完成した型に名前が要ると言うので、「花柄一閃」と提案したら、真顔で採用された。チームの戦術ノートの新しいページが、また一枚増えた。",
          "intent": "過去の再現ではなく、今の型を作る",
          "promise": "本来の力は使わず、チーム全体の成長へ成果を持ち帰る。",
          "memory": "「花柄一閃」の命名の経緯は、チームの公式記録に残っている。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "minato"
              },
              "mode": "add",
              "trust": 0,
              "ownership": 9
            },
            {
              "type": "sharedPoints",
              "amount": 5
            }
          ],
          "goto": "minato.power.node.effect.001"
        }
      ]
    },
    {
      "type": "effect",
      "id": "minato.power.node.effect.001",
      "effects": [
        {
          "type": "setStoryStage",
          "fighterId": "minato",
          "stage": 4
        }
      ]
    },
    {
      "type": "end",
      "id": "minato.power.node.end.001",
      "mode": "return-to-week"
    }
  ],
