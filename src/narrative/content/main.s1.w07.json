  },
  "presentation": {
    "location": "従業員相談室",
    "assets": [
      {
        "id": "main.s1.w07.asset.background.001",
        "kind": "background",
        "path": "/assets/story/bg-employee-consultation-room-v1.png",
        "alt": "従業員相談室の背景"
      }
