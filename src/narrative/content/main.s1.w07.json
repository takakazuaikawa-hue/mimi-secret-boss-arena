{
  "schemaVersion": 1,
  "id": "main.s1.w07",
  "kind": "opening",
  "title": "希望欄から埋める",
  "summary": "所有の欄より先に、本人の希望の欄を埋める。監督の初仕事のやり直し",
  "ownership": {
    "arcId": "main.stage1"
  },
  "trigger": {
