  "nodes": [
    {
      "type": "line",
      "id": "peony.power.node.line.001",
      "lineId": "peony.power.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "練習のあと、ピオニーに呼ばれて旧城壁展示区まで来た。いつもの力では足りない理由を、見せたいらしい。"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.002",
      "lineId": "peony.power.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "警報より先に、相手の声が私の名を呼んだ。いつもと同じ呼び方なのに、その一音だけで足が止まる。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.003",
      "lineId": "peony.power.line.003",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "訓練用の城壁が一枚、音もなく砂になった。拳は触れる寸前で止まっていたのに、風圧だけで形が消えている。"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.004",
      "lineId": "peony.power.line.004",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "本気を出すと、相手より先に床が負ける。"
    },
    {
      "type": "direction",
      "id": "peony.power.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "peony.power.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "direction",
      "id": "peony.power.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "flash"
      }
    },
    {
      "type": "line",
      "id": "peony.power.node.line.005",
      "lineId": "peony.power.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "くしゃみを我慢しただけで城壁が砂になり、本人だけが椅子の傷を気にしている。そんな力が、目の前で息をしている。逃げる理由なら十分だった。それでも私は、力の大きさよりピオニーが最初にどこを見るのかを確かめたかった。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.006",
      "lineId": "peony.power.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ピオニーが私と危険の間へ立つ。触れてはいない。それでも、こちらへ届くはずだった圧力だけがきれいに二つへ割れた。"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.007",
      "lineId": "peony.power.line.007",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "本気を出すと、守りたいものまで同じ距離にあるように見える。それが怖い。"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.008",
      "lineId": "peony.power.line.008",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "床の修理費は会社持ちです。"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.009",
      "lineId": "peony.power.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "壊れるものの前へ自分から立ち、全部の責任を引き受ける巨人。けれど今見せている力は、勝つためではなく、私を怖がらせないために抑えられている。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.010",
      "lineId": "peony.power.line.010",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "では壊さない距離を、一緒に測りましょう。本気を出さない命令ではなく。"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.011",
      "lineId": "peony.power.line.011",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "いい職場じゃないか。"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.012",
      "lineId": "peony.power.line.012",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "本気を見たいと思っていた。実際に目の前へ現れると、知りたかったのは強さではなく、その力を本人がどう恐れているかだった。"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.013",
      "lineId": "peony.power.line.013",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "彼女は何度も拳を引き、最後に壁の前へ小さな花だけを残した。"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.014",
      "lineId": "peony.power.line.014",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "くしゃみを我慢しただけで城壁が砂になり、本人だけが椅子の傷を気にしている。闘技場の安全基準は一瞬で役に立たなくなり、担当者は私の顔を見て計測を諦めた。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.015",
      "lineId": "peony.power.line.015",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "世界を壊せることより、壊さないために何を選んだかが胸へ残った。怖がっていたのは力そのものより、壊したあとも一緒に作り直してくれる人がいないことだった。その理解が正しいか、いつか本人の言葉で確かめたい。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.016",
      "lineId": "peony.power.line.016",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "力の中心にあったのは、守ろうと力を出した瞬間、守る相手まで同じ拳で壊してしまうこと。最強であることが、本人にとって一番古い傷なのだと分かる。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.017",
      "lineId": "peony.power.line.017",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "怖さが消えたわけではない。だからこそ、使うかどうかを本人と決める必要がある。"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.018",
      "lineId": "peony.power.line.018",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "大丈夫とは言えない。怖いものは怖い。それでも、次に力を使う時は一人で決めなくていいと伝えた。",
      "emotion": "resolve"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.019",
      "lineId": "peony.power.line.019",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "角の部分だけ立派に折られた紙の冠だけが元の大きさで残り、さっきまで世界の終わりがいた場所に、帰り道の灯りが戻った。"
    },
    {
      "type": "choice",
      "id": "peony.power.node.choice.001",
      "choices": [
        {
          "id": "peony.power.choice.001",
          "label": "角の封印を外し、壊さず止まる練習をする",
          "result": "壁の一歩手前で止まれた。割れたのは後ろに置いてあった会社の表彰盾だけで、全員が見なかったことにした。",
          "intent": "本来の力を一気に取り戻す",
          "promise": "失敗時の危険を引き受け、この人専用の成長を最大まで進める。",
          "memory": "力を恐れたまま任せたことを、相手は危機の場面で思い出す。",
          "tone": "heroic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "peony"
              },
              "mode": "add",
              "trust": 10,
              "ownership": -4
            },
            {
