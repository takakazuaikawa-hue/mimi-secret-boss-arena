  "nodes": [
    {
      "type": "direction",
      "id": "peony.power.node.direction.001",
      "command": { "type": "background", "assetId": "peony.power.asset.background.001", "transition": "dissolve" }
    },
    {
      "type": "line",
      "id": "peony.power.node.line.001",
      "lineId": "peony.power.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "旧城壁展示区。解体予定の城壁レプリカが残る、夜の資材置き場だ。次の強敵に備えて、今日はピオニーの「角の封印」を外す練習に来た。彼女の全力は、角の封印を解いた時にだけ出る。"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.002",
      "lineId": "peony.power.line.002",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "……ほんとうに、はずすの？　わたしの全力、みたら、きらいになるかも。"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.003",
      "lineId": "peony.power.line.003",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "うちのチーム、全力を見て嫌いになった前例、ゼロ件です。統計は正直ですよ。"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.004",
      "lineId": "peony.power.line.004",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "彼女は角の封印——小さな花の飾りを、そっと外した。空気が変わる。夜の資材置き場に、静かな重圧が満ちる。新人くんの計測器は、電源を入れる前から煙を吹いた。予知である。",
      "emotion": "tension"
    },
    {
      "type": "direction",
      "id": "peony.power.node.direction.002",
      "command": { "type": "effect", "effectId": "flash" }
    },
    {
      "type": "line",
      "id": "peony.power.node.line.005",
      "lineId": "peony.power.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "一撃だった。拳は、城壁レプリカに触れてすらいない。触れる寸前の風圧だけで、石積みの壁が、上から下まで、さらさらと砂に変わった。破壊というより、時間が早送りされたみたいな、静かな崩壊だった。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.006",
      "lineId": "peony.power.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "振り向いたピオニーの顔が、泣きそうだった。全力を出すたび、この顔をしてきたのだろう。すごい、と言われるより先に、ごめんなさい、を用意している顔。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.007",
      "lineId": "peony.power.line.007",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "——よし。この砂、もらっていいですよね。解体予定だったし。"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.008",
      "lineId": "peony.power.line.008",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "……もらう？　すな、を？"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.009",
      "lineId": "peony.power.line.009",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "迷子案内所の前、砂場がほしいって、ずっと言ってたんです。城壁の砂なら、由緒正しくて最高です。"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.010",
      "lineId": "peony.power.line.010",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "翌週、案内所の前に、小さな砂場ができた。ピオニーが自分の全力で作った砂で、子どもたちが小さな城を築いている。壊した城壁が、百個の小さな城になった。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.011",
      "lineId": "peony.power.line.011",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "……こわしたものが、あそびばに、なった。……わたしの全力、はじめて、ありがとうって言われた。"
    },
    {
      "type": "line",
      "id": "peony.power.node.line.012",
      "lineId": "peony.power.line.012",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "壊さないことだけが、優しさじゃない。壊れたあとの使い道まで一緒に考えるのが、うちのチームの流儀になった。夜の展示区で、試合用の型を決める。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "peony.power.node.choice.001",
      "choices": [
        {
          "id": "peony.power.choice.001",
          "label": "角の封印を外し、壊さず止まる練習をする",
          "result": "型の名前は「寸止めの花」。角の封印を外した全力の一撃を、相手の眼前ぴたりで止める。風圧だけが相手の装備を砂に変え、本人には髪一本触れない。練習台の私は、全力の拳が目の前で止まる瞬間を百回見た。百回目でも心臓は跳ねたが、怖さは一回目から、ずっとなかった。",
          "intent": "全力と制御を、両方手に入れる",
          "promise": "失敗時の危険を引き受け、この人専用の成長を最大まで進める。",
          "memory": "「寸止めの花」の練習台を務めたことを、私は少し自慢に思っている。",
          "tone": "heroic",
          "effects": [
            { "type": "relationship", "target": { "type": "fighter", "fighterId": "peony" }, "mode": "add", "trust": 10, "ownership": -4 },
            { "type": "fighterPoints", "target": { "type": "fighter", "fighterId": "peony" }, "amount": 5 }
          ],
          "goto": "peony.power.node.effect.001"
        },
        {
          "id": "peony.power.choice.002",
          "label": "角を封じたまま、守る力だけを広げる",
          "result": "封印は外さず、守備範囲を広げる訓練にした。両腕のドームで守れる範囲は、最終的に観客席一区画ぶんまで広がった。新人くんの記録板には「かべ。うごく。やさしい。」。この三語で監査が通るのだから、彼の文才は本物である。",
          "intent": "破壊ではなく防御の上限を伸ばす",
          "promise": "本来の力は封印したまま、チーム全体の成長へ成果を持ち帰る。",
          "memory": "観客席一区画ぶんの守備範囲を、運営は防災設備として登録した。",
          "tone": "pragmatic",
          "effects": [
            { "type": "relationship", "target": { "type": "fighter", "fighterId": "peony" }, "mode": "add", "trust": 0, "ownership": 9 },
            { "type": "sharedPoints", "amount": 5 }
          ],
          "goto": "peony.power.node.effect.001"
        }
      ]
    },
    {
      "type": "effect",
      "id": "peony.power.node.effect.001",
      "effects": [
        { "type": "setStoryStage", "fighterId": "peony", "stage": 4 }
      ]
