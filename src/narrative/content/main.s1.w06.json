      }
    },
    {
      "type": "direction",
      "id": "main.s1.w06.node.direction.mimi.opening",
      "command": {
        "type": "show",
        "assetId": "main.s1.w06.asset.sprite.mimi.serious",
        "actorId": "mimi",
        "slot": "left",
        "scale": "tall"
      }
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.001a",
      "lineId": "main.s1.w06.line.001a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "休み明けの受付、判子の音がよく響く。"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.001b",
      "lineId": "main.s1.w06.line.001b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "私の机にも、封筒がひとつ、赤い社印。片道五日の、返事が来たんだ。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.002a",
      "lineId": "main.s1.w06.line.002a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "中身は分かってる。名義訂正、受理。"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.002b",
      "lineId": "main.s1.w06.line.002b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "それで派遣に戻る。温泉で心も決めてきた。"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.002c",
      "lineId": "main.s1.w06.line.002c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ちゃんと引き継いで、綺麗に戻ろう、と。"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.003a",
      "lineId": "main.s1.w06.line.003a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「名義変更の申請は、保留します」……ほりゅう?"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.003b",
      "lineId": "main.s1.w06.line.003b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "理由の欄を三度読んだ。耳の奥が、きんと冷える。"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.003c",
      "lineId": "main.s1.w06.line.003c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「最上級ランク在籍中の名義変更は、興行保全規定により認められません」",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.004a",
      "lineId": "main.s1.w06.line.004a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "つまり、こうだ。うちが勝ちすぎて最上級に上がったので、辞められない。"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.004b",
      "lineId": "main.s1.w06.line.004b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "私は書類を持ったまま、受付の台に、静かにおでこを付けた。"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.004c",
      "lineId": "main.s1.w06.line.004c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "台は冷たくて、少しだけ気持ちよかった。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.005a",
      "lineId": "main.s1.w06.line.005a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「オーナーさん、台が凹みます」凹みません。凹んでるのは、私です。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.006a",
      "lineId": "main.s1.w06.line.006a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "続けて二通目。「最上級所属チームには、興行義務が発生します」大会は四週ごと。"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.006b",
      "lineId": "main.s1.w06.line.006b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "あいだの三週は準備と育成に——手引き付きの一覧が、二十六週ぶん几帳面に印字されてた。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.007a",
      "lineId": "main.s1.w06.line.007a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ノノさんに両方見せた。二通を見比べて、輝くような笑顔。"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.007b",
      "lineId": "main.s1.w06.line.007b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「はい! すごいことです! 最上級で辞められなくなった方」"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.007c",
      "lineId": "main.s1.w06.line.007c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「この街で四百年ぶりです!」……喜ばれてしまった。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.008a",
      "lineId": "main.s1.w06.line.008a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "四百年ぶり。その響きに職員さんたちが集まってくる。"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.008b",
      "lineId": "main.s1.w06.line.008b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "拍手が起きた。おめでたい話として。"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.008c",
      "lineId": "main.s1.w06.line.008c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "回覧板が回り、どこかで銅鑼まで鳴った。私の「戻る」は、静かに遠くなった。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.009a",
      "lineId": "main.s1.w06.line.009a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「四百年ぶりですって? やっぱり、似合うのよ」だから、似合うとかじゃないんですよ、マダム。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.010a",
      "lineId": "main.s1.w06.line.010a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "悔しいのに、拍手に手を振ってしまった。接客歴半年の反射。"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.010b",
      "lineId": "main.s1.w06.line.010b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "振りながら、考えた。戻れないなら——ここで、どう立つか。",
      "emotion": "resolve"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.011a",
      "lineId": "main.s1.w06.line.011a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "手帳に、新しい欄が開いていた。「興行義務: 今季、二十六週」二十六。"
    },
    {
      "type": "line",
      "id": "main.s1.w06.node.line.011b",
      "lineId": "main.s1.w06.line.011b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "初めて、その数字を自分の予定として見た。",
      "emotion": "tension"
    },
    {
      "type": "choice",
      "id": "main.s1.w06.node.choice.001",
      "choices": [
        {
          "id": "main.s1.w06.choice.001",
          "label": "二十六週、やり切る前提で組み直す",
          "result": "手帳の一頁目に、二十六個の枠を書いた。書けば、ただの予定表。埋めれば減る——番号を振れば、化け物も行列になる。ノノさんが金の付箋をくれた。「大会の週です」とのこと。七枚。あと七回、試合をするらしい。",
          "intent": "戻れない前提を、予定表に変えて引き受ける",
          "promise": "腹が据わる代わりに、二十六週の枠が全部自分の予定になる",
          "memory": "金の付箋七枚が、大会の週を先に教えている",
          "tone": "heroic",
          "effects": [
            {
              "type": "sharedPoints",
              "amount": 2
            }
          ],
          "goto": "main.s1.w06.node.end.001"
        },
        {
          "id": "main.s1.w06.choice.002",
          "label": "並行して、規定の例外も探してもらう",
          "result": "「例外規定は、あります」とノノさん。「ただし審査は本社で、書類はたぶん三往復」らしい。指を折って数えて、やめた。それでも申請は出した。控えを挟むと、手帳が少し厚くなった。悪くない。",
          "intent": "やり切る覚悟と、戻る道の両方を持っておく",
          "promise": "退路の申請が生きる代わりに、答えはずっと先になる",
          "memory": "例外申請の控えが、手帳に挟まったままになる",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "sharedPoints",
              "amount": 2
            }
          ],
          "goto": "main.s1.w06.node.end.001"
        }
      ]
    },
    {
      "type": "end",
      "id": "main.s1.w06.node.end.001",
      "mode": "return-to-week"
    }
  ],
