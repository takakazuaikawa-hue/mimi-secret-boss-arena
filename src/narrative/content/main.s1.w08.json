{
  "schemaVersion": 1,
  "id": "main.s1.w08",
  "kind": "opening",
  "title": "先付け、四十二点",
  "summary": "最上級初戦の朝。会場が海仕様になり、試合前から採点される",
  "ownership": {
    "arcId": "main.stage1"
  },
  "trigger": {
    "actions": ["work", "play", "rest", "search"],
    "when": { "all": [], "any": [], "none": [] },
