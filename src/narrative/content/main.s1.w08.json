      }
    },
    {
      "type": "direction",
      "id": "main.s1.w08.node.direction.002",
      "command": {
        "type": "clearSprites"
      }
    },
    {
      "type": "direction",
      "id": "main.s1.w08.node.direction.mimi.opening",
      "command": {
        "type": "show",
        "assetId": "main.s1.w08.asset.sprite.mimi.tsukkomi",
        "actorId": "mimi",
        "slot": "left",
        "scale": "tall"
      }
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.001a",
      "lineId": "main.s1.w08.line.001a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "廊下の掲示に「本日、場内水位上昇のお知らせ」最上級の試合は、会場ごと相手仕様になるらしい。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.002a",
      "lineId": "main.s1.w08.line.002a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "相手は、海そのもの——さざなみさんの隊。"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.002b",
      "lineId": "main.s1.w08.line.002b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "手帳に挟んだ長い正式名、ゆうべ三回、声に出して練習してきた。"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.003a",
      "lineId": "main.s1.w08.line.003a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "会場整備の人たちが、最前列に浮き輪を配っていた。"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.003b",
      "lineId": "main.s1.w08.line.003b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "券売のおじさんは、防水の賭け札を売っている。"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.003c",
      "lineId": "main.s1.w08.line.003c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「最上級はね、お客も装備がいるんだよ」観る側に、装備。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.004a",
      "lineId": "main.s1.w08.line.004a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "控室のうちの三人は、めずらしく静かだった。"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.004b",
      "lineId": "main.s1.w08.line.004b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "強い相手の気配は、匂いで分かるらしい。誰も大福に手を伸ばさない。"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.004c",
      "lineId": "main.s1.w08.line.004c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "私は一人で二個食べた。緊張したときの、癖。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.005a",
      "lineId": "main.s1.w08.line.005a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ガヤ氏の声が弾けた。「最上級リーグ! 本日挑むは——七段飛ばしの新星!」七段飛ばし。"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.005b",
      "lineId": "main.s1.w08.line.005b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "もう通り名になってる。通り名は、選べない。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.006a",
      "lineId": "main.s1.w08.line.006a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "相手側の通路から、波の音がした。"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.006b",
      "lineId": "main.s1.w08.line.006b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "目を上げると、天井まで届く高さの水が、廊下をこちらへ歩いてくる。"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.006c",
      "lineId": "main.s1.w08.line.006c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "歩いてくる、としか言えない歩き方で。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.007a",
      "lineId": "main.s1.w08.line.007a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "波の先端が、ぺこりと会釈の形になった。礼儀正しい海だ。"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.007b",
      "lineId": "main.s1.w08.line.007b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "あわてて返礼すると、場内の泡がぷつぷつ寄り集まる。"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.007c",
      "lineId": "main.s1.w08.line.007c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "空中に文字。「ようこそ さいじょうきゅうへ」",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.008a",
      "lineId": "main.s1.w08.line.008a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "続けて、泡文字。「せんつけ 42てん」"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.008b",
      "lineId": "main.s1.w08.line.008b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "……先付け?応援席のノノさんが、両手を口に当てて教えてくれた。"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.008c",
      "lineId": "main.s1.w08.line.008c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「さざなみさんの採点です! 先に付けて、試合の中身で上げ下げするんです!」",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.009a",
      "lineId": "main.s1.w08.line.009a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "四十二点。まだ何もしてないのに、四十二点。満点が何点かも、知らされてない。"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.009b",
      "lineId": "main.s1.w08.line.009b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "それでも——うちの三人の背中が、静かに温まっていくのが見えた。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.010a",
      "lineId": "main.s1.w08.line.010a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "応援席では、マダムが宝くじ売り場の声。"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.010b",
      "lineId": "main.s1.w08.line.010b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「いい番号よー!」番号じゃないんですよ、マダム。"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.010c",
      "lineId": "main.s1.w08.line.010c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "耳が、思わず垂れた。隣で計測係くんが、すでに記録板を抱きしめてる。",
      "emotion": "comic"
    },
    {
      "type": "direction",
      "id": "main.s1.w08.node.direction.mimi.shift.011",
      "command": {
        "type": "show",
        "assetId": "main.s1.w08.asset.sprite.mimi.serious",
        "actorId": "mimi",
        "slot": "left",
        "scale": "tall"
      }
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.011a",
      "lineId": "main.s1.w08.line.011a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "みなさん——泳がされないように、いきましょう!",
      "emotion": "resolve"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.012a",
      "lineId": "main.s1.w08.line.012a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "銅鑼。波がほどけて、砂場いっぱいに広がった。"
    },
    {
      "type": "line",
      "id": "main.s1.w08.node.line.012b",
      "lineId": "main.s1.w08.line.012b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ここからは、圧勝が存在しない場所。最上級の初戦が、始まる。",
      "emotion": "tension"
    },
    {
      "type": "choice",
      "id": "main.s1.w08.node.choice.001",
      "choices": [
        {
          "id": "main.s1.w08.choice.001",
          "label": "採点、上げてもらいましょうと宣言する",
          "result": "「面白い試合をします。海に採点されるなら、上げてもらいましょう」三人がにやりとした。見せ場をもらった役者の顔。泡文字が「きたいちゅう」と反応する。四十二点の下に、小さな上向き矢印。矢印一本で、こんなに嬉しいとは。",
          "intent": "強敵戦を、見せ場として受けて立つ",
          "promise": "チームの闘志が上がる代わりに、海の採点基準を背負う",
          "memory": "泡文字の上向き矢印を、チーム全員が覚えている",
          "tone": "wild",
          "effects": [
            {
              "type": "sharedPoints",
              "amount": 2
            }
          ],
          "goto": "main.s1.w08.node.end.001"
        },
        {
          "id": "main.s1.w08.choice.002",
          "label": "まず、流されないことから始める",
          "result": "「派手じゃなくていいです。まず、流されないこと」地味な指示ほど、本気が伝わるらしい。三人は真顔でうなずいた。足場の確認、呼吸の合図、退き際の約束。泡文字が「じみ」と浮かんで、少しむっとした。",
          "intent": "格上相手に、足場から固める",
          "promise": "崩れにくくなる代わりに、海の採点は辛くなる",
          "memory": "「まず流されない」が、格上戦のうちの型になる",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "sharedPoints",
              "amount": 2
            }
          ],
          "goto": "main.s1.w08.node.end.001"
        }
      ]
    },
    {
      "type": "end",
      "id": "main.s1.w08.node.end.001",
      "mode": "return-to-week"
    }
  ],
