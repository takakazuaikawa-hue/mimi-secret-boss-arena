  "nodes": [
    {
      "type": "direction",
      "id": "peony.liberation.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "peony.liberation.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.001a",
      "lineId": "peony.liberation.line.001a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "契約を終わらせる夜。契約書には、変な欄がある。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.001b",
      "lineId": "peony.liberation.line.001b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「保護対象」という会社の書式だ。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.001c",
      "lineId": "peony.liberation.line.001c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "守護獣型の資産は、守る相手を登録させるらしい。欄には、私の名前が入っていた。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.002a",
      "lineId": "peony.liberation.line.002a",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "……この欄が、きえたら。わたし、なにを守れば、いいんだろう。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.003a",
      "lineId": "peony.liberation.line.003a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "空欄になったら、あなたが選ぶんです。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.003b",
      "lineId": "peony.liberation.line.003b",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "書かされるんじゃなくて、選ぶ。それが今日の手続きです。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.004a",
      "lineId": "peony.liberation.line.004a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "判を押す。保護対象の欄から、私の名前が消える。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.004b",
      "lineId": "peony.liberation.line.004b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "彼女は空欄をしばらく見つめた。それから、意外なお願いをした。",
      "emotion": "tension"
    },
    {
      "type": "direction",
      "id": "peony.liberation.node.direction.002",
      "command": {
        "type": "still",
        "assetId": "peony.liberation.asset.still.001"
      }
    },
    {
      "type": "direction",
      "id": "peony.liberation.node.direction.003",
      "command": {
        "type": "effect",
        "effectId": "pulse"
      }
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.007a",
      "lineId": "peony.liberation.line.007a",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "さいごに、ひとつだけ。……いまから五ふんだけ、まもらせて。"
    },
    {
      "type": "direction",
      "id": "peony.liberation.node.direction.004",
      "command": {
        "type": "still",
        "assetId": "peony.liberation.asset.still.002"
      }
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.009a",
      "lineId": "peony.liberation.line.009a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "何を、と聞く前に、彼女は両腕で夜空へ大きなドームを作った。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.009b",
      "lineId": "peony.liberation.line.009b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "中には、私と、彼女と、月明かりだけ。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.009c",
      "lineId": "peony.liberation.line.009c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "外の音が遠くなる。敵も、危機も、ない。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.010a",
      "lineId": "peony.liberation.line.010a",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "……この、なにもない時間を、まもってみたかったの。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.010b",
      "lineId": "peony.liberation.line.010b",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "あぶなくない時に、まもるのって、どんな気持ちか、しりたくて。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.011a",
      "lineId": "peony.liberation.line.011a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "……どうですか、初めての平和な警備は。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.012a",
      "lineId": "peony.liberation.line.012a",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "……しずかで、あったかい。……これ、まもるっていうより、いっしょに、いるだね。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.013a",
      "lineId": "peony.liberation.line.013a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "守ることしか知らなかった人が、「一緒にいる」を発見した五分間。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.013b",
      "lineId": "peony.liberation.line.013b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ドームの中の月明かりは、ちょっと反則の綺麗さだった。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.013c",
      "lineId": "peony.liberation.line.013c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "心拍の話は、しないでおく。耳だけが、少し騒がしい。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.014a",
      "lineId": "peony.liberation.line.014a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "五分後、腕のドームが開く。夜風が戻る。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.014b",
      "lineId": "peony.liberation.line.014b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "締めの形を決めて、帰ろう。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "peony.liberation.node.choice.001",
      "choices": [
        {
          "id": "peony.liberation.choice.001",
          "label": "保護対象欄を空にし、守る相手を本人へ返す",
          "result": "空欄の保護対象欄に、後日、彼女は特大クレヨンで書き足していた。「そのときどきで、えらぶ」——書式に怒られない範囲で、一番自由な記入。今日は、案内所の子どもたちの砂場の城。明日はわからない。それでいい。",
          "intent": "守る相手の選択権を、本人に渡す",
          "promise": "所有者名を消し、本人が自分の名で次の試合を選べるようにする。",
          "memory": "「そのときどきで、えらぶ」のクレヨン文字を、二人とも気に入っている。",
          "tone": "defiant",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "peony"
              },
              "mode": "add",
              "trust": 10,
              "ownership": 0
            },
            {
              "type": "liberationDecision",
              "fighterId": "peony",
              "decision": "release"
            }
          ],
          "goto": "peony.liberation.node.effect.001"
        },
        {
          "id": "peony.liberation.choice.002",
          "label": "契約を解き、決勝の日の託児当番を一緒に組む",
          "result": "「決勝の日、案内所どうしましょう」と相談したら、当番表を作ってきた。試合時間だけ「ノノさん」、それ以外は全部「ピオニー」——自由になった最初の予定表が、迷子の子たちでいっぱいだった。自由の使い道は、最初から決まっていたらしい。",
          "intent": "自由になった人の予定を、一緒に組む",
          "promise": "断る権利を返したうえで、決勝を一緒に戦う新しい約束を結ぶ。",
          "memory": "クレヨンの当番表は、案内所の公式文書になった。",
          "tone": "tender",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "peony"
              },
              "mode": "add",
              "trust": 6,
              "ownership": 0
            },
            {
              "type": "sharedPoints",
              "amount": 4
            },
            {
              "type": "liberationDecision",
              "fighterId": "peony",
              "decision": "release"
            }
          ],
          "goto": "peony.liberation.node.effect.001"
        }
      ]
    },
    {
