  "nodes": [
    {
      "type": "direction",
      "id": "peony.liberation.node.direction.001",
      "command": { "type": "background", "assetId": "peony.liberation.asset.background.001", "transition": "dissolve" }
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.001",
      "lineId": "peony.liberation.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "契約を終わらせる夜。ピオニーの契約書には、変な欄がある。「保護対象」。会社の書式だ。守護獣型の資産には、守る相手を登録させるらしい。欄には、私の名前が入っていた。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.002",
      "lineId": "peony.liberation.line.002",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "……この欄が、きえたら。わたし、なにを守れば、いいんだろう。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.003",
      "lineId": "peony.liberation.line.003",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "空欄になったら、あなたが選ぶんです。書かされるんじゃなくて、選ぶ。それが今日の手続きです。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.004",
      "lineId": "peony.liberation.line.004",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "判を押す。保護対象の欄から、私の名前が消える。彼女は空欄をしばらく見つめて、それから、意外なお願いをした。",
      "emotion": "tension"
    },
    {
      "type": "direction",
      "id": "peony.liberation.node.direction.002",
      "command": { "type": "still", "assetId": "peony.liberation.asset.still.001" }
    },
    {
      "type": "direction",
      "id": "peony.liberation.node.direction.003",
      "command": { "type": "effect", "effectId": "pulse" }
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.005",
      "lineId": "peony.liberation.line.005",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "さいごに、ひとつだけ。……いまから五ふんだけ、まもらせて。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.006",
      "lineId": "peony.liberation.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "何を、と聞く前に、彼女は両腕で夜空へ大きなドームを作った。中には、私と、彼女と、月明かりだけ。外の音が遠くなる。攻めてくる敵は、いない。守る危機も、ない。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.007",
      "lineId": "peony.liberation.line.007",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "……この、なにもない時間を、まもってみたかったの。あぶなくない時に、まもるのって、どんな気持ちか、しりたくて。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.008",
      "lineId": "peony.liberation.line.008",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "……どうですか、初めての平和な警備は。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.009",
      "lineId": "peony.liberation.line.009",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "……しずかで、あったかい。……これ、まもるっていうより、いっしょに、いるだね。"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.010",
      "lineId": "peony.liberation.line.010",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "守ることしか知らなかった人が、「一緒にいる」を発見した五分間だった。ドームの中の月明かりは、ちょっと反則の綺麗さだった。心拍の話は、しないでおく。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "peony.liberation.node.line.011",
      "lineId": "peony.liberation.line.011",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "五分後、腕のドームが開く。夜風が戻る。締めの形を決めて、帰ろう。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "peony.liberation.node.choice.001",
      "choices": [
        {
          "id": "peony.liberation.choice.001",
          "label": "保護対象欄を空にし、守る相手を本人へ返す",
          "result": "空欄になった保護対象の欄に、後日、彼女は自分の字(特大クレヨン)で書き足していた。「そのときどきで、えらぶ」。書式に怒られない範囲で一番自由な記入だった。今日の彼女が選んで守るのは、案内所の子どもたちの砂場の城。明日は、わからない。それでいい。",
          "intent": "守る相手の選択権を、本人に渡す",
          "promise": "所有者名を消し、本人が自分の名で次の試合を選べるようにする。",
          "memory": "「そのときどきで、えらぶ」のクレヨン文字を、二人とも気に入っている。",
          "tone": "defiant",
          "effects": [
            { "type": "relationship", "target": { "type": "fighter", "fighterId": "peony" }, "mode": "add", "trust": 10, "ownership": 0 },
            { "type": "liberationDecision", "fighterId": "peony", "decision": "release" }
          ],
          "goto": "peony.liberation.node.effect.001"
        },
        {
          "id": "peony.liberation.choice.002",
          "label": "契約を解き、決勝の日の託児当番を一緒に組む",
          "result": "「決勝の日、案内所どうしましょう」と相談したら、彼女は当番表を作ってきた。特大クレヨンで、試合時間だけ「ノノさん」、それ以外は全部「ピオニー」。自由になった最初の予定表が、迷子の子たちでいっぱいだった。この人の自由は、最初から使い道が決まっていたらしい。",
          "intent": "自由になった人の予定を、一緒に組む",
          "promise": "断る権利を返したうえで、決勝を一緒に戦う新しい約束を結ぶ。",
          "memory": "クレヨンの当番表は、案内所の公式文書になった。",
          "tone": "tender",
          "effects": [
            { "type": "relationship", "target": { "type": "fighter", "fighterId": "peony" }, "mode": "add", "trust": 6, "ownership": 0 },
            { "type": "sharedPoints", "amount": 4 },
            { "type": "liberationDecision", "fighterId": "peony", "decision": "release" }
          ],
          "goto": "peony.liberation.node.effect.001"
        }
      ]
    },
    {
      "type": "effect",
      "id": "peony.liberation.node.effect.001",
      "effects": [
