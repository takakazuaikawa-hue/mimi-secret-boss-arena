{
  "schemaVersion": 1,
  "id": "main.s2.w08",
  "kind": "opening",
  "title": "九つ目の勝負",
  "summary": "九種目の大会の朝。書かれた結果と、書き直される挑戦状",
  "ownership": {
    "arcId": "main.stage2"
  },
  "trigger": {
