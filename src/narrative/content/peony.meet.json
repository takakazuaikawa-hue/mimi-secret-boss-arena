  "nodes": [
    {
      "type": "direction",
      "id": "peony.meet.node.direction.001",
      "command": { "type": "background", "assetId": "peony.meet.asset.background.001", "transition": "dissolve" }
    },
    {
      "type": "line",
      "id": "peony.meet.node.line.001",
      "lineId": "peony.meet.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "迷子のお子様のお迎え要請で、案内所へ走った。着いてみると、迷子の男の子は泣いていなかった。代わりに、天井につっかえそうな巨大な人が、滝みたいな汗をかいて、折り紙と向き合っていた。"
    },
    {
      "type": "line",
      "id": "peony.meet.node.line.002",
      "lineId": "peony.meet.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "桃色の髪、立派な角、城壁みたいな肩幅。その巨躯が、全神経を指先の一点に集めて、紙の冠を折っている。男の子は隣で、わくわくと完成を待っている。",
      "emotion": "tension"
    },
    {
      "type": "direction",
      "id": "peony.meet.node.direction.002",
      "command": { "type": "still", "assetId": "peony.meet.asset.still.001" }
    },
    {
      "type": "direction",
      "id": "peony.meet.node.direction.003",
      "command": { "type": "effect", "effectId": "pulse" }
    },
    {
      "type": "line",
      "id": "peony.meet.node.line.003",
      "lineId": "peony.meet.line.003",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "しー……。今、いちばん、むずかしいところ。……つのの、おりかえし。"
    },
    {
      "type": "line",
      "id": "peony.meet.node.line.004",
      "lineId": "peony.meet.line.004",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "あとで知ったが、この人の拳は、触れる前の風圧だけで城壁を砂にする。その手で、いま、五センチの折り返しに挑んでいる。私は息を止めて見守った。案内所全体が、息を止めていた。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "peony.meet.node.line.005",
      "lineId": "peony.meet.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "——完成。紙の冠が、男の子の頭にそっと載る。歓声。その瞬間、ピオニーが安心して、大きく息を吸って——くしゃみをした。",
      "emotion": "comic"
    },
    {
      "type": "direction",
      "id": "peony.meet.node.direction.004",
      "command": { "type": "effect", "effectId": "shake" }
    },
    {
      "type": "line",
      "id": "peony.meet.node.line.006",
      "lineId": "peony.meet.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "窓の外で、雲が割れた。屋内の掲示物が全部めくれ、私の兎耳は真後ろへなびき、館内放送が「突風にご注意ください」と流れた。屋内で。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "peony.meet.node.line.007",
      "lineId": "peony.meet.line.007",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "……ごめんなさい。でも、かんむりは、まもった。"
    },
    {
      "type": "line",
      "id": "peony.meet.node.line.008",
      "lineId": "peony.meet.line.008",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "見ると、くしゃみの瞬間、彼女は両手で男の子と冠を風から囲っていた。雲は割ったが、紙の冠は守った。優先順位が、完璧に彼女だった。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "peony.meet.node.line.009",
      "lineId": "peony.meet.line.009",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "迷子係の方、ですか？"
    },
    {
      "type": "line",
      "id": "peony.meet.node.line.010",
      "lineId": "peony.meet.line.010",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "ううん。……わたしも、まいご。むかし守ってた城が、もう地図にないの。守り方だけ、おぼえてるんだけど。"
    },
    {
      "type": "line",
      "id": "peony.meet.node.line.011",
      "lineId": "peony.meet.line.011",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "案内所に居着いた理由が、それだった。迷子は、迷子の面倒を見るのが上手い。守る城を失くした巨人は、この小さな窓口で、紙の冠を守っている。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "peony.meet.node.line.012",
      "lineId": "peony.meet.line.012",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "男の子のお母さんが迎えに来て、案内所が静かになる。ピオニーは、余った折り紙で二つ目の冠を折り始めた。さっきより、指が少しだけ緊張している。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "peony.meet.node.line.013",
      "lineId": "peony.meet.line.013",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "……これは、うさみみが、じゃまにならない設計。……できたら、もらって、くれる？"
    },
    {
      "type": "line",
      "id": "peony.meet.node.line.014",
      "lineId": "peony.meet.line.014",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "城壁を砂にする手が、私の耳の位置を測って、冠の設計を変えている。断る選択肢は、この世に存在しなかった。",
      "emotion": "tender"
    },
    {
      "type": "choice",
      "id": "peony.meet.node.choice.001",
      "choices": [
        {
          "id": "peony.meet.choice.001",
          "label": "迷子が泣き止むまで隣に座る",
          "result": "その日の午後、案内所にはもう一人迷子が来た。今度は大泣きの女の子。ピオニーは慌てず、私と役割分担した。彼女が「おおきくて、あんしんな壁」になり、私が「はなしをきく係」になる。泣き止んだ女の子は、帰り際にピオニーの角へ、借りた紙冠をお返しに載せた。角の先の紙冠は、その日一日、彼女の宝物だった。",
          "intent": "守る側の隣で、案内所の午後を手伝う",
          "promise": "目先の報酬は得ない代わりに、この人が何を失ったかを知る。",
          "memory": "角の先の紙冠の日を、ピオニーは何度も話す。",
          "tone": "tender",
          "effects": [
            { "type": "relationship", "target": { "type": "fighter", "fighterId": "peony" }, "mode": "add", "trust": 7, "ownership": -2 }
          ],
          "goto": "peony.meet.node.effect.001"
        },
        {
          "id": "peony.meet.choice.002",
          "label": "今日はピオニーを誘わず、用事へ戻る",
          "result": "仕事に戻る私の頭には、兎耳がじゃまにならない設計の紙冠が載っていた。フロアのお客様たちに「かわいい」と言われるたび、作者の宣伝をしておいた。翌週、迷子案内所には「冠の折り方教室(こわれません)」の貼り紙が出た。括弧の但し書きに、彼女の全力が詰まっている。",
          "intent": "今日は業務へ戻る",
          "promise": "所属選手にはならないが、後の出来事で再会できる。",
          "memory": "紙冠を一日かぶっていた店員のことを、ピオニーは覚えている。",
          "tone": "pragmatic",
          "effects": [],
          "goto": "peony.meet.node.effect.001"
        }
      ]
    },
    {
      "type": "effect",
      "id": "peony.meet.node.effect.001",
