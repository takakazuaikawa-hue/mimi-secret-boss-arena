{
  "schemaVersion": 1,
  "id": "peony.meet",
  "kind": "character",
  "title": "紙の冠と、全力の指先",
  "summary": "迷子案内所。城壁を砂にする手が、折り紙と格闘していた",
  "ownership": {
    "arcId": "character.peony",
    "characterId": "peony",
