  "nodes": [
    {
      "type": "direction",
      "id": "peony.bond.node.direction.001",
      "command": { "type": "background", "assetId": "peony.bond.asset.background.001", "transition": "dissolve" }
    },
    {
      "type": "line",
      "id": "peony.bond.node.line.001",
      "lineId": "peony.bond.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "風の強い午後、外遊びが中止になった。迷子案内所の子ども向けに、紙芝居を作ることになった。作・ミミ、画・ピオニー。題名「かみのかんむりと、やさしいかいじゅう」。実話をもとにしたフィクションである。"
    },
    {
      "type": "line",
      "id": "peony.bond.node.line.002",
      "lineId": "peony.bond.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ピオニーの絵は、意外なほど繊細だった。特大クレヨンで描かれる怪獣は、どれも困り顔で、どこか本人に似ている。「かいじゅうは、こわい顔が、にがてなの」とのこと。作者の実感である。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "peony.bond.node.line.003",
      "lineId": "peony.bond.line.003",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "問題は、リハーサルで起きた。怪獣の登場シーンで、ピオニーが張り切って効果音の足踏みをしたのだ。ずしん。",
      "emotion": "comic"
    },
    {
      "type": "direction",
      "id": "peony.bond.node.direction.002",
      "command": { "type": "effect", "effectId": "shake" }
    },
    {
      "type": "line",
      "id": "peony.bond.node.line.004",
      "lineId": "peony.bond.line.004",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "食堂の食器棚が総立ちになり、館内に「地震ではありません。繰り返します、地震ではありません」の放送が流れた。効果音として、リアルすぎた。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "peony.bond.node.line.005",
      "lineId": "peony.bond.line.005",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "……こうかおん、きんし？"
    },
    {
      "type": "line",
      "id": "peony.bond.node.line.006",
      "lineId": "peony.bond.line.006",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "禁止じゃないです。工夫です。……そうだ。逆にしましょう。あなたの怪獣は「世界一静かな怪獣」です。"
    },
    {
      "type": "line",
      "id": "peony.bond.node.line.007",
      "lineId": "peony.bond.line.007",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "台本を書き直した。怪獣は、足音を立てない。街のみんなを起こさないように、爪先立ちで歩く。くしゃみを我慢して、雲の陰に隠れる。——ピオニーは台本を三回読んで、小さな声で言った。「この怪獣、しってる」。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "peony.bond.node.line.008",
      "lineId": "peony.bond.line.008",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "本番は、風の強い午後の案内所。満員(子ども八人)。ピオニーの怪獣役は、迫真だった。爪先立ちの震え、くしゃみの我慢、紙の冠をそっと直す指先。全部、演技じゃないから強い。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "peony.bond.node.line.009",
      "lineId": "peony.bond.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "物語の最後、静かな怪獣は、街の子に紙の冠をもらう。読み手の私がその行を読んだ時、観客の女の子が立ち上がって、本物のピオニーの角に、自分の紙冠を掛けに行った。台本にない、最高の結末だった。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "peony.bond.node.line.010",
      "lineId": "peony.bond.line.010",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "……ミミ。かいじゅうは、しずかじゃなくても、よかったのかな。"
    },
    {
      "type": "line",
      "id": "peony.bond.node.line.011",
      "lineId": "peony.bond.line.011",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "はい。今日の拍手、聞きました？　あれ、半分はあなたの足踏み待ちでしたよ。次回作は「うるさい怪獣」でいきましょう。"
    },
    {
      "type": "line",
      "id": "peony.bond.node.line.012",
      "lineId": "peony.bond.line.012",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "終演後の片付けで、残りの午後の使い方を決める。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "peony.bond.node.choice.001",
      "choices": [
        {
          "id": "peony.bond.choice.001",
          "label": "子ども向けの紙芝居を、ピオニーと作る",
          "result": "次回作「うるさいかいじゅう、はじめてのおまつり」の制作会議は、夕方まで続いた。今度の怪獣は、我慢しない。足踏みで太鼓の代わりをして、くしゃみで花火の風を送る。ピオニーはクレヨンを握って、初めて「大きい自分」を楽しそうに描いた。困り顔じゃない怪獣が、画用紙の上で笑っていた。",
          "intent": "我慢しない側の物語も、一緒に作る",
          "promise": "読みにくい成長になる代わりに、この人だけの成長を大きく進める。",
          "memory": "困り顔じゃない怪獣の絵を、案内所に飾ってある。",
          "tone": "wild",
          "effects": [
            { "type": "relationship", "target": { "type": "fighter", "fighterId": "peony" }, "mode": "add", "trust": 9, "ownership": -2 },
            { "type": "fighterPoints", "target": { "type": "fighter", "fighterId": "peony" }, "amount": 3 }
          ],
          "goto": "peony.bond.node.effect.001"
        },
        {
          "id": "peony.bond.choice.002",
          "label": "味方を背に乗せ、城壁を越える連携を試す",
          "result": "午後は練習場で新連携を試した。ピオニーが四つん這いで「動く城壁」になり、味方が背を駆け上がって高所を取る型だ。彼女は「ふまれるの、へいき。むしろ、とくい」と胸を張った。守られてきた城壁の記憶が、今度は味方の足場になる。連携の名前は、満場一致で「お城ごっこ」になった。",
          "intent": "大きさを、チームの地形として使う",
          "promise": "紙芝居の続きは後日になるが、全員へ配れる成長ポイントを得る。",
          "memory": "連携「お城ごっこ」の命名会議は三十秒で終わった。",
          "tone": "pragmatic",
          "effects": [
            { "type": "relationship", "target": { "type": "fighter", "fighterId": "peony" }, "mode": "add", "trust": 1, "ownership": 7 },
            { "type": "sharedPoints", "amount": 3 }
          ],
          "goto": "peony.bond.node.effect.001"
        }
      ]
    },
    {
      "type": "effect",
      "id": "peony.bond.node.effect.001",
