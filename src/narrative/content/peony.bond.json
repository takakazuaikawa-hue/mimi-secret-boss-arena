  "presentation": {
    "location": "従業員食堂",
    "assets": [
      {
        "id": "peony.bond.asset.background.001",
        "kind": "background",
        "path": "/assets/story/bg-casino-cafe-rain.png",
        "alt": "従業員食堂の背景"
      }
