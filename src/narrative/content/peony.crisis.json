{
  "schemaVersion": 1,
  "id": "peony.crisis",
  "kind": "character",
  "title": "城壁破壊ショーのお知らせ",
  "summary": "黒い角封筒。会社が「破壊」を売り物にしようとし、彼女は守るものを増やしすぎる",
  "ownership": {
    "arcId": "character.peony",
    "characterId": "peony",
    "stage": "crisis"
  },
  "trigger": {
    "actions": [
      "work",
