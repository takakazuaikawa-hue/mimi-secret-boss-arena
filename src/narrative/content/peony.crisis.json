  "nodes": [
    {
      "type": "line",
      "id": "peony.crisis.node.line.001",
      "lineId": "peony.crisis.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "アルデバラン社から届いた契約確認書には、ピオニーの扱いを決める欄が残っていた。本人の意思を聞くため、旧城壁展示区へ向かった。"
    },
    {
      "type": "line",
      "id": "peony.crisis.node.line.002",
      "lineId": "peony.crisis.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "その週、相手は私を避けた。廊下の向こうに姿を見つけても、業務用の言葉だけを残して先に曲がる。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "peony.crisis.node.line.003",
      "lineId": "peony.crisis.line.003",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "会社の指示書には『保護対象以外を排除』とある。守ることと壊すことを、一行で同じ命令にしていた。"
    },
    {
      "type": "line",
      "id": "peony.crisis.node.line.004",
      "lineId": "peony.crisis.line.004",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "命令してくれれば殴れる。自分で決めると止まっちまう。"
    },
    {
      "type": "direction",
      "id": "peony.crisis.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "peony.crisis.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "direction",
      "id": "peony.crisis.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "shake"
      }
    },
    {
      "type": "line",
      "id": "peony.crisis.node.line.005",
      "lineId": "peony.crisis.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ピオニーの返事が短い。怒っている、と決めれば私の不安には名前がつく。でも以前の私も「壊さないよう力加減を教えれば安心できるのだ」と決めつけた。また同じ読み違いをするところだった。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "peony.crisis.node.line.006",
      "lineId": "peony.crisis.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "嫌われたのなら理由を聞けばいい。そう思うのに、角の部分だけ立派に折られた紙の冠を見るたび、聞いた答えで今までの時間が変わるのが怖かった。"
    },
    {
      "type": "line",
      "id": "peony.crisis.node.line.007",
      "lineId": "peony.crisis.line.007",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "命じられれば迷わない。迷わなければ、間違えた時に止まれない。"
    },
    {
      "type": "line",
      "id": "peony.crisis.node.line.008",
      "lineId": "peony.crisis.line.008",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "止まってもいい。勝ち方を一緒に考えます。"
    },
    {
      "type": "line",
      "id": "peony.crisis.node.line.009",
      "lineId": "peony.crisis.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ようやく追いついた場所で、ピオニーは壊れるものの前へ自分から立ち、全部の責任を引き受ける巨人に戻っていた。近づく前の、何も期待していなかった顔だ。"
    },
    {
      "type": "line",
      "id": "peony.crisis.node.line.010",
      "lineId": "peony.crisis.line.010",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "誰を守るかは、あなたが決めてください。私は勝手に『それ以外』を作りません。"
    },
    {
      "type": "line",
      "id": "peony.crisis.node.line.011",
      "lineId": "peony.crisis.line.011",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "それなら、考える方から本気を出すよ。"
    },
    {
      "type": "line",
      "id": "peony.crisis.node.line.012",
      "lineId": "peony.crisis.line.012",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "原因は私への不信ではない。守ろうと力を出した瞬間、守る相手まで同じ拳で壊してしまうことから私を遠ざけようとしている。そのやさしさを、やさしいまま受け入れてはいけない気がした。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "peony.crisis.node.line.013",
      "lineId": "peony.crisis.line.013",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "大きな拳がゆっくり開き、指先に乗っていた命令書が四角いまま床へ落ちた。"
    },
    {
      "type": "line",
      "id": "peony.crisis.node.line.014",
      "lineId": "peony.crisis.line.014",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "くしゃみを我慢しただけで城壁が砂になり、本人だけが椅子の傷を気にしている。別れ話のように静かな場面なのに、施設全体は最終災害手順へ移行している。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "peony.crisis.node.line.015",
      "lineId": "peony.crisis.line.015",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "正しい答えを当てることより、間違えたまま命令しないことを選ぶ。私は逃げ道をふさがない位置で止まり、聞きたかったことを短い言葉にした。",
      "emotion": "resolve"
    },
    {
      "type": "line",
      "id": "peony.crisis.node.line.016",
      "lineId": "peony.crisis.line.016",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "守るために離れるのは、残された側へ選択を渡さない。命令と同じだと告げると、初めて相手の表情が崩れた。",
      "emotion": "resolve"
    },
    {
      "type": "line",
      "id": "peony.crisis.node.line.017",
      "lineId": "peony.crisis.line.017",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "勝つための答えと、あとで自分を嫌いにならない答えは、同じとは限らない。"
    },
    {
      "type": "line",
      "id": "peony.crisis.node.line.018",
      "lineId": "peony.crisis.line.018",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "私は勝利を約束しない。安全も約束できない。ただ、壊した責任ではなく、作り直す時間を誰かと分けることを諦める判断だけは本人へ返すと決めた。"
    },
    {
      "type": "line",
      "id": "peony.crisis.node.line.019",
      "lineId": "peony.crisis.line.019",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "並んで戻る廊下には、まだ一人分の距離がある。でも今度の沈黙は拒絶ではなく、同じ答えを考えるためのものだった。",
      "emotion": "tender"
    },
    {
      "type": "choice",
      "id": "peony.crisis.node.choice.001",
      "choices": [
        {
          "id": "peony.crisis.choice.001",
          "label": "観客席を守る城壁役として前へ出る",
          "result": "ピオニーは観客席の前へ立ち、敵の大技を城壁のように受け止めた。守る場所を本人が選んだことで、角の力も迷わなかった。",
          "intent": "この人だけの突破法へ賭ける",
          "promise": "予測しにくい方法を試し、この人専用の成長を大きく進める。",
          "memory": "危機で選んだ方法は、契約を解く場面でも二人の共通の記憶として戻る。",
          "tone": "wild",
          "effects": [
            {
              "type": "relationship",
