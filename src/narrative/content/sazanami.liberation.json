  "nodes": [
    {
      "type": "direction",
      "id": "sazanami.liberation.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "sazanami.liberation.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "sazanami.liberation.node.line.001a",
      "lineId": "sazanami.liberation.line.001a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "契約を終わらせる、夜。貯水槽の縁に、解除届と、携帯水槽と、黄色い胴長を並べた。"
    },
    {
      "type": "line",
      "id": "sazanami.liberation.node.line.001b",
      "lineId": "sazanami.liberation.line.001b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "この三つが、私とさざなみの一年だった。"
    },
    {
      "type": "line",
      "id": "sazanami.liberation.node.line.002a",
      "lineId": "sazanami.liberation.line.002a",
      "speakerId": "legacy.speaker.we7zqt",
      "speakerName": "さざなみ",
      "mode": "dialogue",
      "text": "水槽の所有印が消えると、この影は、海へ帰る。……ここへは、もう出前できない。"
    },
    {
      "type": "line",
      "id": "sazanami.liberation.node.line.003a",
      "lineId": "sazanami.liberation.line.003a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "……寂しくなりますね。水槽の前の夜食、好きだったんですけど。"
    },
    {
      "type": "line",
      "id": "sazanami.liberation.node.line.004a",
      "lineId": "sazanami.liberation.line.004a",
      "speakerId": "legacy.speaker.we7zqt",
      "speakerName": "さざなみ",
      "mode": "dialogue",
      "text": "……ミミ。あなたは、海を何だと思っている。"
    },
    {
      "type": "direction",
      "id": "sazanami.liberation.node.direction.002",
      "command": {
        "type": "still",
        "assetId": "sazanami.liberation.asset.still.001"
      }
    },
    {
      "type": "direction",
      "id": "sazanami.liberation.node.direction.003",
      "command": {
        "type": "effect",
        "effectId": "pulse"
      }
    },
    {
      "type": "line",
      "id": "sazanami.liberation.node.line.005a",
      "lineId": "sazanami.liberation.line.005a",
      "speakerId": "legacy.speaker.we7zqt",
      "speakerName": "さざなみ",
      "mode": "dialogue",
      "text": "雨は、私。水道の水も、元をたどれば、私。あなたの朝の一杯の水も、涙も、たどれば海へ帰る。"
    },
    {
      "type": "line",
      "id": "sazanami.liberation.node.line.005b",
      "lineId": "sazanami.liberation.line.005b",
      "speakerId": "legacy.speaker.we7zqt",
      "speakerName": "さざなみ",
      "mode": "dialogue",
      "text": "——海は、どこでも隣。水槽は、ただの窓口だった。"
    },
    {
      "type": "line",
      "id": "sazanami.liberation.node.line.006a",
      "lineId": "sazanami.liberation.line.006a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "スケールの大きい「いつでも会える」だった。"
    },
    {
      "type": "line",
      "id": "sazanami.liberation.node.line.006b",
      "lineId": "sazanami.liberation.line.006b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ロマンチックなのか怖いのか迷って、心臓は跳ねる方を選んだ。"
    },
    {
      "type": "line",
      "id": "sazanami.liberation.node.line.006c",
      "lineId": "sazanami.liberation.line.006c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "雨のたびに思い出す人がいるのは、悪くない。耳が、じんわり熱い。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "sazanami.liberation.node.line.007a",
      "lineId": "sazanami.liberation.line.007a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "判を押す。水槽の所有印が消える。"
    },
    {
      "type": "line",
      "id": "sazanami.liberation.node.line.007b",
      "lineId": "sazanami.liberation.line.007b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "影は光の粒になって、配管を通り、雨樋を抜けて、海へ帰っていった。"
    },
    {
      "type": "line",
      "id": "sazanami.liberation.node.line.007c",
      "lineId": "sazanami.liberation.line.007c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "貯水槽の水面が、最後に一度、手を振るみたいに波立った。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "sazanami.liberation.node.line.008a",
      "lineId": "sazanami.liberation.line.008a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "静かになった水面に、泡文字がひとつ、ゆっくり浮かんで消えた。"
    },
    {
      "type": "line",
      "id": "sazanami.liberation.node.line.008b",
      "lineId": "sazanami.liberation.line.008b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「契約——採点対象外。友人に、点は、つけない」と、そこにあった。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "sazanami.liberation.node.line.009a",
      "lineId": "sazanami.liberation.line.009a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "採点の人が、採点をやめる相手。それが、答案用紙の外の関係。"
    },
    {
      "type": "line",
      "id": "sazanami.liberation.node.line.009b",
      "lineId": "sazanami.liberation.line.009b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "胴長を抱えて、帰り道を考えた。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "sazanami.liberation.node.choice.001",
      "choices": [
        {
          "id": "sazanami.liberation.choice.001",
          "label": "水槽の所有印を消し、影を海へつなぎ直す",
          "result": "帰り道、雨が降り始めた。傘を差そうとして、やめた。雨粒が兎耳に当たるたび、泡の声が小さく聞こえる。「濡れる。傘——マイナス五十点」と聞こえた。差しました。差しましたよ。海はどこでも隣で、どこでも過保護だった。",
          "intent": "海を、海の広さのまま自由にする",
          "promise": "所有者名を消し、本人が自分の名で次の試合を選べるようにする。",
          "memory": "雨の日の泡の声を、私はもう寂しいと思わない。",
          "tone": "defiant",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "sazanami"
              },
              "mode": "add",
              "trust": 10,
              "ownership": 0
            },
            {
              "type": "liberationDecision",
              "fighterId": "sazanami",
              "decision": "release"
            }
          ],
          "goto": "sazanami.liberation.node.effect.001"
        },
        {
          "id": "sazanami.liberation.choice.002",
          "label": "契約を解き、次戦の潮時だけ本人へ尋ねる",
          "result": "「次の試合、出ますか」と聞くと、長い間があった。翌朝、館内水槽に泡文字で「潮見表」が貼り出され、私の出勤時間だけ大潮の印がついていた。出るという意味だと、ノノさんが翻訳してくれた。",
          "intent": "自由な海へ、改めて隣を頼む",
          "promise": "断る権利を返したうえで、決勝を一緒に戦う新しい約束を結ぶ。",
          "memory": "潮見表の大潮の印の意味を、チームの全員が知っている。",
          "tone": "tender",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "sazanami"
              },
              "mode": "add",
              "trust": 6,
              "ownership": 0
            },
            {
