  "nodes": [
    {
      "type": "line",
      "id": "amara.meet.node.line.001",
      "lineId": "amara.meet.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "名札の再発行申請。記入時間、推定九十秒。今週いちばん簡単な用事のはずだった。従業員相談室の扉を開けるまでは。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.002",
      "lineId": "amara.meet.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "長机が三つ、法壇の形に積み上がっている。窓際の観葉植物には「傍聴席」の札。私の申請書を受け取るはずの窓口は、「被告席」になっていた。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.003",
      "lineId": "amara.meet.line.003",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "開廷します。本日の被告、従業員休憩規定・第八条。"
    },
    {
      "type": "direction",
      "id": "amara.meet.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "amara.meet.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.004",
      "lineId": "amara.meet.line.004",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "あの、名札の再発行をお願いしに来たんですけど。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.005",
      "lineId": "amara.meet.line.005",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "静粛に。……いえ、訂正します。あなたは今、証人席に立っています。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.006",
      "lineId": "amara.meet.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "見ると、私の足元に白いチョークで丁寧に「証人席」と書いてあった。入口が証人席を兼ねる法廷を、私は初めて見た。九十秒で帰る予定は、開廷と同時に却下された。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.007",
      "lineId": "amara.meet.line.007",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "証人ミミ。あなたは先週の火曜、休憩十五分のうち十一分を、泣いているお客様の付き添いに使った。相違ありませんか。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.008",
      "lineId": "amara.meet.line.008",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "な、なんで知って……相違ないです。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.009",
      "lineId": "amara.meet.line.009",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "規定第八条は、その十一分の返還を定めていない。つまりこの休憩規定は、休ませないために書かれています。"
    },
    {
      "type": "direction",
      "id": "amara.meet.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "flash"
      }
    },
    {
      "type": "direction",
      "id": "amara.meet.node.direction.003",
      "command": {
        "type": "still",
        "assetId": "amara.meet.asset.still.001"
      }
    },
    {
      "type": "direction",
      "id": "amara.meet.node.direction.004",
      "command": {
        "type": "effect",
        "effectId": "pulse"
      }
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.010",
      "lineId": "amara.meet.line.010",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "白い手袋が規則集の余白を指す。赤字がびっしり。全部、誰かの取り戻せなかった数分の記録だった。怖い人だ、と思った。思ったのに、先に出たのは接客の言葉だった。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.011",
      "lineId": "amara.meet.line.011",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "……お茶、淹れ直しましょうか。それ、完全に冷めてますよね。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.012",
      "lineId": "amara.meet.line.012",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "今は審理中——"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.013",
      "lineId": "amara.meet.line.013",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "証人からの差し入れです。却下、できます？"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.014",
      "lineId": "amara.meet.line.014",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "…………記録に残します。「審理は三分間、良い香りのために中断された」と。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.015",
      "lineId": "amara.meet.line.015",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "判決文みたいな言い方で、湯気を三分待つ人だった。マグを持つ手袋の指が、規則集からほんの少し離れる。それで気づいた。この法廷、裁判長も検事も書記も、全部この人が一人でやっている。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.016",
      "lineId": "amara.meet.line.016",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "……弁護人は、いないんですか。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.017",
      "lineId": "amara.meet.line.017",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "この闘技場に、規則へ負けた側に立つ者はいません。私を含めて。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.018",
      "lineId": "amara.meet.line.018",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「私を含めて」。その五文字だけ、判決の声じゃなかった。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.019",
      "lineId": "amara.meet.line.019",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "事情はまだ何も知らない。でも、ここで「お大事に」と帰ったら、たぶん今夜の私が今日の私を開廷する。",
      "emotion": "tender"
    },
    {
      "type": "choice",
      "id": "amara.meet.node.choice.001",
      "choices": [
        {
          "id": "amara.meet.choice.001",
          "label": "この裁判、傍聴していく",
          "result": "私は傍聴席(観葉植物の隣)へ着席した。論告は三時間に及び、途中から闘技場そのものが被告に追加され、閉廷は業務放送の蛍の光に強制された。帰り際、アマラは初めて「また来ますか」と聞いた。判決ではなく、質問だった。扉の下から箸袋が一枚滑ってくる。裏に几帳面な字で「異議申立て(第一号)——本日の証人は、審理を三分余計に楽しくした」。",
          "intent": "用事より先に、目の前の裁判の行方を見届ける",
          "promise": "目先の報酬は得ない代わりに、この人が何と戦っているかを知る。",
          "memory": "初対面で最後まで傍聴した唯一の相手として、アマラは私を覚えている。",
          "tone": "tender",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "amara"
              },
              "mode": "add",
              "trust": 7,
              "ownership": -2
            },
            {
              "type": "setFlag",
              "flagId": "amara.court.observer",
              "value": true
            }
          ],
          "goto": "amara.meet.node.effect.001"
        },
        {
          "id": "amara.meet.choice.002",
          "label": "名札の再発行だけ頼んで帰る",
          "result": "申請書は「証拠物件ホ」として受理された。名札は三日後、「本法廷は、あなたの名前が正しく表示される権利を認める」という判決文つきで届いた。同封の箸袋の裏に、几帳面な字で「異議申立て(第一号)——本日の証人は、審理を三分余計に楽しくした」。判決文の隅には、とても小さな手書きの「またどうぞ」。",
          "intent": "今日は仕事へ戻り、距離を保つ",
          "promise": "所属選手にはならないが、後の出来事で再会できる。",
          "memory": "急いで仲間にしなかった距離感を、アマラは礼儀として覚えている。",
          "tone": "pragmatic",
          "effects": [],
          "goto": "amara.meet.node.effect.001"
        }
      ]
    },
    {
      "type": "effect",
      "id": "amara.meet.node.effect.001",
      "effects": [
        {
          "type": "markEncountered",
          "fighterId": "amara",
          "encountered": true
        },
        {
          "type": "setStoryStage",
          "fighterId": "amara",
          "stage": 1
        }
      ]
    },
    {
      "type": "end",
      "id": "amara.meet.node.end.001",
      "mode": "return-to-week"
    }
  ],
