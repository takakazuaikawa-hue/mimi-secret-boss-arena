{
  "schemaVersion": 1,
  "id": "amara.meet",
  "kind": "character",
  "title": "第一回公判、被告・休憩規定",
  "summary": "名札の再発行に行った相談室で、重力に出頭命令が下る",
  "ownership": {
    "arcId": "character.amara",
    "characterId": "amara",
    "stage": "meet"
  },
  "trigger": {
