      "work",
      "rest"
    ],
    "when": {
      "all": [],
      "any": [],
      "none": []
    },
    "repeat": {
      "mode": "once-per-run"
    },
    "priority": 500,
    "weight": 1
  },
  "presentation": {
    "location": "従業員相談室",
    "assets": [
      {
        "id": "amara.meet.asset.background.001",
        "kind": "background",
        "path": "/assets/story/bg-employee-consultation-room-v1.png",
        "alt": "従業員相談室の背景"
      },
      {
        "id": "amara.meet.asset.still.001",
        "kind": "still",
        "path": "/assets/story/encounters/amara.png",
        "alt": "書類と天秤が宙に浮く相談室で、静かに立つアマラ"
      }
    ]
  },
  "nodes": [
    {
      "type": "direction",
      "id": "amara.meet.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "amara.meet.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.001a",
      "lineId": "amara.meet.line.001a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "名札の再発行、書く時間はたぶん九十秒。相談室の扉を開けるまでは、そのはずだった。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.002a",
      "lineId": "amara.meet.line.002a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "え。長机が三つ、裁判所みたいに積み上がってる。観葉植物には「傍聴席」の札。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.002b",
      "lineId": "amara.meet.line.002b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "受付の窓口は「被告席」になっていた。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.003a",
      "lineId": "amara.meet.line.003a",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "開廷します。本日の被告、従業員休憩規定・第八条。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.004a",
      "lineId": "amara.meet.line.004a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "あの、名札の再発行をお願いしに来たんですけど。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.005a",
      "lineId": "amara.meet.line.005a",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "静粛に。……いえ、訂正します。あなたは今、証人席に立っています。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.006a",
      "lineId": "amara.meet.line.006a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "え。足元に、白チョークで「証人席」って書いてある。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.006b",
      "lineId": "amara.meet.line.006b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "九十秒で帰る予定、開廷と同時に却下されました。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.007a",
      "lineId": "amara.meet.line.007a",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "相違ありませんか。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.008a",
      "lineId": "amara.meet.line.008a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "な、なんで知って……相違ないです。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.009a",
      "lineId": "amara.meet.line.009a",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "規定第八条は、その十一分の返還を定めていない。よって本法廷は——重力に、出頭を命じます。"
    },
    {
      "type": "direction",
      "id": "amara.meet.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "flash"
      }
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.010a",
      "lineId": "amara.meet.line.010a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "窓が鳴った。書類が浮いた。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.010b",
      "lineId": "amara.meet.line.010b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "規則集も、紅茶も、前髪も。相談室ごと、ふわりと浮いた。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.010c",
      "lineId": "amara.meet.line.010c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "冗談みたいな光景の真ん中で、その人だけが静かに立っていた。",
      "emotion": "tension"
    },
    {
      "type": "direction",
      "id": "amara.meet.node.direction.003",
      "command": {
        "type": "still",
        "assetId": "amara.meet.asset.still.001"
      }
    },
    {
      "type": "direction",
      "id": "amara.meet.node.direction.004",
      "command": {
        "type": "effect",
        "effectId": "pulse"
      }
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.011a",
      "lineId": "amara.meet.line.011a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "え、ちょっ、浮いて——きゃっ!"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.012a",
      "lineId": "amara.meet.line.012a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "手首を、白い手袋がつかんだ。転びかけた私を、引き寄せる。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.012b",
      "lineId": "amara.meet.line.012b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "近い。宇宙みたいな目が、すぐ上から見てる。耳が、熱い。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.013a",
      "lineId": "amara.meet.line.013a",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "証人の転倒は、認めていません。……怪我は。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.014a",
      "lineId": "amara.meet.line.014a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "ないです、たぶん。心臓以外は。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.015a",
      "lineId": "amara.meet.line.015a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "心拍数のほうが、休憩規定より先に労災になりそう。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.015b",
      "lineId": "amara.meet.line.015b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "アマラさんが指を鳴らすと、書類も私も床へ、紅茶だけは彼女の手へ戻った。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.016a",
      "lineId": "amara.meet.line.016a",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "——この規則は、休ませないために書かれています。誰かが、異議を申し立てるまでは。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.017a",
      "lineId": "amara.meet.line.017a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "……弁護人は、いないんですか。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.018a",
      "lineId": "amara.meet.line.018a",
      "speakerId": "legacy.speaker.14shtqw",
      "speakerName": "アマラ",
      "mode": "dialogue",
      "text": "この闘技場に、規則へ負けた側に立つ者はいません。私を含めて。"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.019a",
      "lineId": "amara.meet.line.019a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「私を含めて」その五文字だけ、判決の声じゃなかった。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.020a",
      "lineId": "amara.meet.line.020a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "手首に手袋の感触が残ってる。「お大事に」"
    },
    {
      "type": "line",
      "id": "amara.meet.node.line.020b",
      "lineId": "amara.meet.line.020b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "で帰ったら、たぶん今夜の私が今日の私を、また開廷する。",
      "emotion": "tender"
    },
    {
      "type": "choice",
      "id": "amara.meet.node.choice.001",
      "choices": [
        {
          "id": "amara.meet.choice.001",
          "label": "この裁判、傍聴していく",
          "result": "傍聴席に座った。浮いた証拠書類を、アマラさんが指先だけで整列させる。閉廷は蛍の光で強制終了。帰り際、彼女が聞いた。「また来ますか」判決じゃなく、質問だった。箸袋の裏に「異議申立て第一号、審理を三分楽しくした証人」",
          "intent": "用事より先に、目の前の裁判の行方を見届ける",
          "promise": "目先の報酬は得ない代わりに、この人が何と戦っているかを知る。",
          "memory": "初対面で最後まで傍聴した唯一の相手として、アマラは私を覚えている。",
          "tone": "tender",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "amara"
              },
              "mode": "add",
              "trust": 7,
              "ownership": -2
            },
            {
              "type": "setFlag",
              "flagId": "amara.court.observer",
              "value": true
            }
          ],
          "goto": "amara.meet.node.effect.001"
        },
        {
          "id": "amara.meet.choice.002",
          "label": "名札の再発行だけ頼んで帰る",
          "result": "申請書は「証拠物件ホ」として受理された。名札は三日後、「名前が正しく表示される権利を認める」という判決文つきで届いた。箸袋の裏に「異議申立て第一号、審理を三分楽しくした証人」とあった。隅には小さく「またどうぞ」",
          "intent": "今日は仕事へ戻り、距離を保つ",
          "promise": "所属選手にはならないが、後の出来事で再会できる。",
          "memory": "急いで仲間にしなかった距離感を、アマラは礼儀として覚えている。",
          "tone": "pragmatic",
          "effects": [],
          "goto": "amara.meet.node.effect.001"
        }
      ]
    },
    {
      "type": "effect",
      "id": "amara.meet.node.effect.001",
      "effects": [
        {
          "type": "markEncountered",
          "fighterId": "amara",
          "encountered": true
        },
        {
          "type": "setStoryStage",
          "fighterId": "amara",
          "stage": 1
        }
      ]
    },
    {
      "type": "end",
      "id": "amara.meet.node.end.001",
      "mode": "return-to-week"
    }
  ],
