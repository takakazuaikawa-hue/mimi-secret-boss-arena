    "weight": 1
  },
  "presentation": {
    "location": "鏡のない部屋",
    "assets": [
      {
        "id": "ushiro.power.asset.still.001",
        "kind": "still",
        "path": "/assets/story/events/ushiro-power-127-shadows-v1.png",
        "alt": "鏡のない部屋を満たす百二十七人のうしろ"
      },
      {
        "id": "ushiro.power.asset.background.001",
        "kind": "background",
        "path": "/assets/story/bg-observation-deck-night.png",
        "alt": "鏡のない部屋の背景"
      },
      {
        "id": "ushiro.power.asset.still.002",
        "kind": "still",
        "path": "/assets/story/events/ushiro-power-v2.png",
        "alt": "百二十七人の中から本体を指差し「あなたです」と告げ、目が合う瞬間"
      }
    ]
  },
  "nodes": [
    {
      "type": "direction",
      "id": "ushiro.power.node.direction.001",
      "command": { "type": "background", "assetId": "ushiro.power.asset.background.001", "transition": "dissolve" }
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.001",
      "lineId": "ushiro.power.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "闘技場の地下には「鏡のない部屋」がある。反射物を全部取り払った訓練室で、うしろが唯一、全力を出せる場所らしい。鏡や窓があると、写り込みを気にして力が散るのだという。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.002",
      "lineId": "ushiro.power.line.002",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "全員、出します。……引かないで、くださいね。"
    },
    {
      "type": "direction",
      "id": "ushiro.power.node.direction.002",
      "command": { "type": "effect", "effectId": "flash" }
    },
    {
      "type": "direction",
      "id": "ushiro.power.node.direction.003",
      "command": { "type": "still", "assetId": "ushiro.power.asset.still.001" }
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.003",
      "lineId": "ushiro.power.line.003",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "部屋の照明が揺れて、影が咲いた。壁に、床に、天井に、百二十七人の黒金の影。全員が同じ姿勢で立ち、全員が別々の方向を見ている。部屋のどこにも「背後」が存在しない。全方位が、彼の正面だった。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.004",
      "lineId": "ushiro.power.line.004",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "戦闘では、これが決定打になる。敵の背後は、常に彼の間合いだ。振り向いても振り向いても、そこに彼がいる。相手にしてみれば、世界中が背後になる悪夢である。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.005",
      "lineId": "ushiro.power.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "新人くんは百二十七人に囲まれて、記録板に「ぜんぶ、うしろ。」と書いた。今日も試合結果より正確な記録である。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.006",
      "lineId": "ushiro.power.line.006",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "……ところで。この中の、どれが本体か。分かりますか。分かった人は、今まで、いないのですが。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.007",
      "lineId": "ushiro.power.line.007",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "百二十七人は、完全に同じ見た目だった。姿勢も、影の濃さも、ピースの角度も。私は部屋を一周して、二周目の途中で、足を止めた。",
      "emotion": "tension"
    },
    {
      "type": "direction",
      "id": "ushiro.power.node.direction.004",
      "command": { "type": "still", "assetId": "ushiro.power.asset.still.002" }
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.008",
      "lineId": "ushiro.power.line.008",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "——あなたです。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.009",
      "lineId": "ushiro.power.line.009",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "…………なぜ。今まで、誰にも。……なぜ、分かったのですか。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.010",
      "lineId": "ushiro.power.line.010",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "あなただけ、ちょっと優しい姿勢してます。私が転びそうな床の段差の前に、立ってるので。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.011",
      "lineId": "ushiro.power.line.011",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "百二十六人の影は完璧に同じだった。本体だけが、無意識に、私の足元の心配をしていた。観察者の癖は、隠せない。観察する側なら、なおさら分かる。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.012",
      "lineId": "ushiro.power.line.012",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "百二十七人が、いっせいにざわめいた。動揺すると全員が動揺するらしい。壮観な照れ方だった。観察する人が観察された時の顔を、百二十七方向から同時に見られる贅沢は、たぶん世界で私だけのものだ。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.013",
      "lineId": "ushiro.power.line.013",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "……見つかるのは、こわいと、思っていました。……見つけてもらうのは、その、……悪くない、ですね。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.014",
      "lineId": "ushiro.power.line.014",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "この力の、試合での使い方を決める。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "ushiro.power.node.choice.001",
      "choices": [
        {
          "id": "ushiro.power.choice.001",
          "label": "誰も見ないまま、存在できる場所を作る",
          "result": "型の名前は「観客席」。試合中、百二十六人の影は何もしない。ただ会場中に立って、相手を「見る」だけだ。全方位から観察される重圧で、相手の動きは硬くなり、フェイントは全部読まれる。本体は最後まで手を出さないことすらある。「見るだけで勝てるのが、一番平和です」と本人は満足げだった。",
          "intent": "観察を、そのまま強さにする",
          "promise": "失敗時の危険を引き受け、この人専用の成長を最大まで進める。",
          "memory": "型「観客席」の相手はみんな、試合後に「視線が痛かった」と言う。",
          "tone": "heroic",
          "effects": [
            { "type": "relationship", "target": { "type": "fighter", "fighterId": "ushiro" }, "mode": "add", "trust": 10, "ownership": -4 },
            { "type": "fighterPoints", "target": { "type": "fighter", "fighterId": "ushiro" }, "amount": 5 }
          ],
          "goto": "ushiro.power.node.effect.001"
        },
        {
          "id": "ushiro.power.choice.002",
          "label": "鏡を並べ、味方だけが位置を読めるようにする",
          "result": "逆転の発想で、会場に小さな鏡を仕込む練習をした。彼の影は鏡に「写り込む」ので、鏡の角度を知っている味方だけが、全部の位置を読める。敵には百二十七人、味方には現在地つきの百二十七人。情報戦の主導権は、写り込みの癖ごと、うちのものになった。",
          "intent": "写り込みの癖を、味方の地図に変える",
          "promise": "本来の全展開は温存し、チーム全体の成長へ成果を持ち帰る。",
          "memory": "鏡の角度表は、チームの新しい共有財産になった。",
          "tone": "pragmatic",
          "effects": [
            { "type": "relationship", "target": { "type": "fighter", "fighterId": "ushiro" }, "mode": "add", "trust": 0, "ownership": 9 },
            { "type": "sharedPoints", "amount": 5 }
          ],
          "goto": "ushiro.power.node.effect.001"
        }
      ]
    },
    {
      "type": "effect",
      "id": "ushiro.power.node.effect.001",
      "effects": [
        { "type": "setStoryStage", "fighterId": "ushiro", "stage": 4 }
      ]
    },
    {
      "type": "end",
      "id": "ushiro.power.node.end.001",
      "mode": "return-to-week"
    }
  ],
