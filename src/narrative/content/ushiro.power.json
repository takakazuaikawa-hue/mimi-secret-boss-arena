      }
    ]
  },
  "nodes": [
    {
      "type": "direction",
      "id": "ushiro.power.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "ushiro.power.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.001a",
      "lineId": "ushiro.power.line.001a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "闘技場の地下には「鏡のない部屋」がある。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.001b",
      "lineId": "ushiro.power.line.001b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "反射物を全部取り払った訓練室で、うしろが唯一、全力を出せる場所らしい。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.001c",
      "lineId": "ushiro.power.line.001c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "鏡や窓があると、写り込みを気にして力が散るのだという。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.002a",
      "lineId": "ushiro.power.line.002a",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "全員、出します。……引かないで、くださいね。"
    },
    {
      "type": "direction",
      "id": "ushiro.power.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "flash"
      }
    },
    {
      "type": "direction",
      "id": "ushiro.power.node.direction.003",
      "command": {
        "type": "still",
        "assetId": "ushiro.power.asset.still.001"
      }
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.003a",
      "lineId": "ushiro.power.line.003a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "部屋の照明が揺れて、影が咲いた。壁に、床に、天井に、百二十七人の黒金の影。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.003b",
      "lineId": "ushiro.power.line.003b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "全員が同じ姿勢で立ち、全員が別々の方向を見ている。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.003c",
      "lineId": "ushiro.power.line.003c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "部屋のどこにも「背後」が存在しない。全方位が、彼の正面だった。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.004a",
      "lineId": "ushiro.power.line.004a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "戦闘では、これが決定打になる。敵の背後は、常に彼の間合いだ。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.004b",
      "lineId": "ushiro.power.line.004b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "振り向いても振り向いても、そこに彼がいる。相手にしてみれば、世界中が背後になる悪夢だ。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.005a",
      "lineId": "ushiro.power.line.005a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "新人くんは百二十七人に囲まれて、記録板に「ぜんぶ、うしろ。」と書いた。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.005b",
      "lineId": "ushiro.power.line.005b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "今日も正確な記録だ。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.006a",
      "lineId": "ushiro.power.line.006a",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "……ところで。この中の、どれが本体か。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.006b",
      "lineId": "ushiro.power.line.006b",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "分かりますか。分かった人は、今まで、いないのですが。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.007a",
      "lineId": "ushiro.power.line.007a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "百二十七人は、完全に同じ見た目だった。姿勢も、影の濃さも、ピースの角度も。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.007b",
      "lineId": "ushiro.power.line.007b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "私は部屋を一周して、耳まで澄ませながら、二周目の途中で、足を止めた。",
      "emotion": "tension"
    },
    {
      "type": "direction",
      "id": "ushiro.power.node.direction.004",
      "command": {
        "type": "still",
        "assetId": "ushiro.power.asset.still.002"
      }
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.008a",
      "lineId": "ushiro.power.line.008a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "——あなたです。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.009a",
      "lineId": "ushiro.power.line.009a",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "…………なぜ。今まで、誰にも。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.009b",
      "lineId": "ushiro.power.line.009b",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "……なぜ、分かったのですか。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.010a",
      "lineId": "ushiro.power.line.010a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "あなただけ、ちょっと優しい姿勢してます。私が転びそうな床の段差の前に、立ってるので。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.011a",
      "lineId": "ushiro.power.line.011a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "百二十六人の影は完璧に同じだった。本体だけが、無意識に、私の足元の心配をしていた。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.011b",
      "lineId": "ushiro.power.line.011b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "観察者の癖は、隠せない。観察する側なら、なおさら分かる。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.012a",
      "lineId": "ushiro.power.line.012a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "観察する人が観察された時の顔を、百二十七方向から同時に見られる贅沢は、たぶん世界で私だけのものだ。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.013a",
      "lineId": "ushiro.power.line.013a",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "……見つかるのは、こわいと、思っていました。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.013b",
      "lineId": "ushiro.power.line.013b",
      "speakerId": "legacy.speaker.1ddw3j9",
      "speakerName": "うしろ",
      "mode": "dialogue",
      "text": "……見つけてもらうのは、その、……悪くない、ですね。"
    },
    {
      "type": "line",
      "id": "ushiro.power.node.line.014a",
      "lineId": "ushiro.power.line.014a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "この力の、試合での使い方を決める。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "ushiro.power.node.choice.001",
      "choices": [
