  "nodes": [
    {
      "type": "direction",
      "id": "main.s1.w01.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "main.s1.w01.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "direction",
      "id": "main.s1.w01.node.direction.002",
      "command": {
        "type": "clearSprites"
      }
    },
    {
      "type": "direction",
      "id": "main.s1.w01.node.direction.mimi.opening",
      "command": {
        "type": "show",
        "assetId": "main.s1.w01.asset.sprite.mimi.tsukkomi",
        "actorId": "mimi",
        "slot": "right",
        "scale": "tall"
      }
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.001a",
      "lineId": "main.s1.w01.line.001a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "開場前の闘技場、石の匂い。揚げ油も、ちょっと混じってる。"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.001b",
      "lineId": "main.s1.w01.line.001b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "天井が高くて、足音がよく響く。名札の紐が、耳まで、ちくちくする。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.002a",
      "lineId": "main.s1.w01.line.002a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "派遣票は「臨時接客・一日」だった。給仕と受付補助、倉庫の数えごと。"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.002b",
      "lineId": "main.s1.w01.line.002b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "夕方にはカジノへ戻る、それだけのはずだった。"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.003a",
      "lineId": "main.s1.w01.line.003a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ノノさんが、挨拶の途中で時計を見た。"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.003b",
      "lineId": "main.s1.w01.line.003b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「開場五分前です——走りますよ」走った。初日の廊下、やけに長い。",
      "emotion": "comic"
    },
    {
      "type": "direction",
      "id": "main.s1.w01.node.direction.003",
      "command": {
        "type": "background",
        "assetId": "main.s1.w01.asset.background.002",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.005a",
      "lineId": "main.s1.w01.line.005a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "客席の扉を開けた。地鳴りみたいな歓声が来る。"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.005b",
      "lineId": "main.s1.w01.line.005b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "砂の上で鎧の巨人と炎の狼が激突。トレーの果実水が、ばしゃん。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.006a",
      "lineId": "main.s1.w01.line.006a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "決着の銅鑼。右半分が万歳して、左半分が札をちぎる。"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.006b",
      "lineId": "main.s1.w01.line.006b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "悔しさの紙吹雪。……ここ、強い人の試合に賭ける場所なんだ。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.007a",
      "lineId": "main.s1.w01.line.007a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "お客様、こぼれます! 万歳は、飲み物を置いてからです!",
      "emotion": "comic"
    },
    {
      "type": "direction",
      "id": "main.s1.w01.node.direction.004",
      "command": {
        "type": "background",
        "assetId": "main.s1.w01.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.008a",
      "lineId": "main.s1.w01.line.008a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "受付に、白ひげの剣士さん。「世界を三度すくった者だが」"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.008b",
      "lineId": "main.s1.w01.line.008b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「はい」「ポイント五倍は今日かね」今日です、判を押した。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.010a",
      "lineId": "main.s1.w01.line.010a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "次は、頭が三つある犬のお客様。三つの口が別々の飲み物を頼む。"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.010b",
      "lineId": "main.s1.w01.line.010b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "どの口が払うかで五分もめて、真ん中が払った。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.011a",
      "lineId": "main.s1.w01.line.011a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "昼、門前に観光バスが停まった。行き先は「魔王城あと地・日帰り」だとか。"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.011b",
      "lineId": "main.s1.w01.line.011b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "滅ぼす場所じゃなく、行く場所らしい。土産の城壁、無限在庫だそうだ。",
      "emotion": "comic"
    },
    {
      "type": "direction",
      "id": "main.s1.w01.node.direction.mimi.shift.012",
      "command": {
        "type": "show",
        "assetId": "main.s1.w01.asset.sprite.mimi.serious",
        "actorId": "mimi",
        "slot": "right",
        "scale": "tall"
      }
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.012a",
      "lineId": "main.s1.w01.line.012a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "強そうな人ほど、客席で拍手してる。なぜ試合に出ないのか、聞いた。"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.012b",
      "lineId": "main.s1.w01.line.012b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ノノさんが笑う。「みなさん、強くて——お暇なんです」",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.013a",
      "lineId": "main.s1.w01.line.013a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "鞘の剣は、鳴っていたわけじゃない。鳴らす場面が、もう来ないだけ。"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.013b",
      "lineId": "main.s1.w01.line.013b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "強いまま終わった人たち。客席には、物語の続きが座ってる。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.014a",
      "lineId": "main.s1.w01.line.014a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "夕方、払い戻しの列で伝説を四十人さばいた。配当計算はカジノと同じ。"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.014b",
      "lineId": "main.s1.w01.line.014b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "くたくた。でも最後の判は、いい音がした。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.015a",
      "lineId": "main.s1.w01.line.015a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "閉場の鐘。表仕事用の赤い上着を返して、黒い接客服に戻る。"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.015b",
      "lineId": "main.s1.w01.line.015b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "肩が少し軽い。今日いち、いい感じの疲れかも。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.016a",
      "lineId": "main.s1.w01.line.016a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "帰りぎわ、ノノさんが手帳を出す。「引き継ぎの現場責任者、ミミさんで」"
    },
    {
      "type": "line",
      "id": "main.s1.w01.node.line.016b",
      "lineId": "main.s1.w01.line.016b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "……せきにんしゃ? 耳が、思わず、ぴんと立った。",
      "emotion": "tension"
    },
    {
      "type": "choice",
      "id": "main.s1.w01.node.choice.001",
      "choices": [
        {
          "id": "main.s1.w01.choice.001",
          "label": "引き受けます、と即答する",
          "result": "「助かります!」名簿の一番上に署名した。ペンを上げた瞬間、夕暮れの闘技場に灯りが走る。下の欄はまだ真っ白。怖い。でも、胸がちょっと鳴った。耳も、たぶん立ってる。",
          "intent": "頼られた仕事を、その場で受ける",
          "promise": "話が早く進む代わりに、知らない名簿の一番上に名前が残る",
          "memory": "ノノさんが、即答の速さを覚えている",
          "outcomeAssetId": "main.s1.w01.asset.outcome.001",
          "tone": "heroic",
          "effects": [
            {
              "type": "sharedPoints",
              "amount": 2
            }
          ],
          "goto": "main.s1.w01.node.end.001"
        },
        {
          "id": "main.s1.w01.choice.002",
          "label": "少しだけ、考えさせてくださいと返す",
          "result": "ノノさんが「では、鉛筆で」と、名簿に薄い線を残した。閉場後、その線に指を添える。外は闘技場の青い灯り、廊下の向こうはカジノの暖かな灯り。……どちらへも、戻れる。それでも、もう半分は答えを知ってる気がした。",
          "intent": "カジノの日常へ帰る道を、まだ閉じない",
          "promise": "退路を残す代わりに、返事はもう半分済んでいる",
          "memory": "名簿に、鉛筆書きの名前が残っている",
          "outcomeAssetId": "main.s1.w01.asset.outcome.002",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "sharedPoints",
              "amount": 2
            }
          ],
          "goto": "main.s1.w01.node.end.001"
        }
      ]
    },
    {
      "type": "end",
      "id": "main.s1.w01.node.end.001",
      "mode": "return-to-week"
    }
  ],
  "debug": {
    "status": "review",
