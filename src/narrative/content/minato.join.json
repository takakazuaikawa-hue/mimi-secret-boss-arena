  "nodes": [
    {
      "type": "direction",
      "id": "minato.join.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "minato.join.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "minato.join.node.line.001",
      "lineId": "minato.join.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "昼の商店街。定食屋の前に、動かない人がいた。ミナトだ。券売機の前で、微動だにしない。嫌な予感がして時計を見る。私がここを最初に通ったのは、四十分前である。"
    },
    {
      "type": "line",
      "id": "minato.join.node.line.002",
      "lineId": "minato.join.line.002",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "ミナトさん、まだ選んでるんですか！？"
    },
    {
      "type": "line",
      "id": "minato.join.node.line.003",
      "lineId": "minato.join.line.003",
      "speakerId": "legacy.speaker.1vz3er0",
      "speakerName": "ミナト",
      "mode": "dialogue",
      "text": "……日替わりが、AとBある。Aは唐揚げ。Bは焼き魚。どちらを選んでも、誰も困らない。……その状況に、慣れていない。"
    },
    {
      "type": "line",
      "id": "minato.join.node.line.004",
      "lineId": "minato.join.line.004",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "魔王城の分かれ道は即断できたのに、唐揚げと焼き魚の分かれ道で四十分。この人の中で、選択とは常に世界の命運だったのだ。誰も困らない選択の手順だけ、装備されていない。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "minato.join.node.line.005",
      "lineId": "minato.join.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "しかも後ろの行列が、すごいことになっていた。三つ目の頭のお客様、鎧の幽霊、火を吹く鶏。誰も急かさない。むしろ全員、固唾を呑んで勇者の決断を見守っている。",
      "emotion": "comic"
    },
    {
      "type": "direction",
      "id": "minato.join.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "shake"
      }
    },
    {
      "type": "line",
      "id": "minato.join.node.line.006",
      "lineId": "minato.join.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "その時、券売機が音を立てた。ミナトの気配に反応したらしく、全ボタンの表示が勝手に切り替わる。「勇者定食」「勇者定食」「勇者定食」。——選択肢が、消えた。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "minato.join.node.line.007",
      "lineId": "minato.join.line.007",
      "speakerId": "legacy.speaker.1vz3er0",
      "speakerName": "ミナト",
      "mode": "dialogue",
      "text": "……世界は、俺に選ばせてくれない。"
    },
    {
      "type": "line",
      "id": "minato.join.node.line.008",
      "lineId": "minato.join.line.008",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "諦めないでください！　店主さーん、日替わりAとB、口頭注文いけますか！"
    },
    {
      "type": "line",
      "id": "minato.join.node.line.009",
      "lineId": "minato.join.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "結局、二人で入って、AとBを一つずつ頼んで、半分こにした。選ばなくていい解決策に、ミナトは雷に打たれたような顔をしていた。「その手が、あったのか」。なかったんですか。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "minato.join.node.line.010",
      "lineId": "minato.join.line.010",
      "speakerId": "legacy.speaker.1vz3er0",
      "speakerName": "ミナト",
      "mode": "dialogue",
      "text": "うまい。……唐揚げも、焼き魚も、両方うまい。こういう結末も、あるんだな。"
    },
    {
      "type": "line",
      "id": "minato.join.node.line.011",
      "lineId": "minato.join.line.011",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "食後のお茶で、私は例の話を切り出した。大会のこと、チームのこと、温泉のこと。ミナトは湯呑みを置いて、まっすぐ私を見た。まっすぐ見られると、こっちの心拍が困る。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "minato.join.node.line.012",
      "lineId": "minato.join.line.012",
      "speakerId": "legacy.speaker.1vz3er0",
      "speakerName": "ミナト",
      "mode": "dialogue",
      "text": "俺はこれまで、四十七件の依頼を受けてきた。全部「世界を救ってくれ」だった。……あなたの頼みは、依頼の顔をしていない。"
    },
    {
      "type": "line",
      "id": "minato.join.node.line.013",
      "lineId": "minato.join.line.013",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "だって、救ってほしいんじゃないです。一緒に温泉に行きたいだけなので。"
    },
    {
      "type": "line",
      "id": "minato.join.node.line.014",
      "lineId": "minato.join.line.014",
      "speakerId": "legacy.speaker.1vz3er0",
      "speakerName": "ミナト",
      "mode": "dialogue",
      "text": "…………四十八件目は、ずいぶん平和だ。"
    },
    {
      "type": "line",
      "id": "minato.join.node.line.015",
      "lineId": "minato.join.line.015",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "笑った。この人、笑うと年相応なのだ。世界を四十七回救った顔が、唐揚げの衣を一つ残して、少年みたいに笑っていた。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "minato.join.node.line.016",
      "lineId": "minato.join.line.016",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "あとは、受け方だ。四十八件目の依頼書を、どんな形にするか。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "minato.join.node.choice.001",
      "choices": [
        {
          "id": "minato.join.choice.001",
          "label": "返却窓口ごと、控室へ引っ越してもらう",
          "result": "「神器の返却、まだ途中ですよね。窓口ごとうちのチームに来ませんか」。かくして控室の隅に「臨時遺失物窓口」が開設された。剣たちは大喜びで引っ越してきて、ミナトは毎朝一本ずつ、別れの挨拶をしてから練習に出る。伝票の束は、四十七枚から少しずつ、減っていく予定である。",
          "intent": "終わった物語の後片付けごと、引き受ける",
          "promise": "登録は少し遅れるが、この人専用の成長ポイントを得る。",
          "memory": "窓口ごと引っ越した日のことを、剣たちも含めた全員が覚えている。",
          "tone": "tender",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "minato"
              },
              "mode": "add",
              "trust": 8,
              "ownership": -3
            },
            {
              "type": "fighterPoints",
              "target": {
                "type": "fighter",
                "fighterId": "minato"
              },
              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "minato",
              "decision": "join"
            }
          ],
          "goto": "minato.join.node.end.001"
        },
        {
          "id": "minato.join.choice.002",
          "label": "公式戦を四十八件目の依頼として受けてもらう",
          "result": "依頼書は私が書いた。依頼内容「公式戦に出ること」。報酬欄「温泉と、日替わり定食(半分こ可)」。ミナトは報酬欄を三回読み直して、署名した。「今までで、いちばん報酬が具体的だ」。プロは書式に厳しい。",
          "intent": "慣れた形式で、確実に頼む",
          "promise": "本人の流儀に合わせ、誰にでも使える成長ポイントを得る。",
          "memory": "報酬欄に定食と書いた依頼書を、ミナトは丁寧に保管している。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "minato"
              },
              "mode": "add",
              "trust": 0,
              "ownership": 8
            },
            {
              "type": "sharedPoints",
              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "minato",
              "decision": "join"
            }
          ],
          "goto": "minato.join.node.end.001"
        },
        {
          "id": "minato.join.choice.003",
          "label": "今回はミナトを誘わず、別の機会を待つ",
          "result": "「今日は、定食のお礼だけ受け取っておきます」。別れ際、ミナトは券売機を振り返って言った。「次に来た時は、三十分で選んでみせる」。目標の立て方が、いちいち勇者だった。",
          "intent": "今回はチームへ誘わない",
          "promise": "今回の所属は見送るが、人物の物語と再会の可能性は失わない。",
          "memory": "半分こにした定食の味を、二人とも覚えている。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "recruitmentDecision",
              "fighterId": "minato",
              "decision": "decline"
            }
          ],
          "goto": "minato.join.node.end.001"
        }
      ]
    },
    {
      "type": "end",
      "id": "minato.join.node.end.001",
      "mode": "return-to-week"
    }
  ],
