                "type": "fighter",
                "fighterId": "gidonozeaas"
              },
              "amount": 3
            }
          ],
          "goto": "gidonozeaas.bond.node.effect.001"
        },
        {
          "id": "gidonozeaas.bond.choice.002",
          "label": "ナプキンに次の試合手順を書く",
          "result": "ゆっくりの時間は、作戦会議にも最強だった。外の一分で、十五分ぶん話せる。ナプキン三枚の連携手順を、彼は「歴代一番ぜいたくな時間の使い方です」と評した。褒めているのか怒っているのか、揺れ方では分からなかった。",
          "intent": "守られた時間を、チームの勝ち筋に使う",
          "promise": "本人の流儀は崩すが、全員へ配れる成長ポイントを得る。",
          "memory": "時間の遅い窓際で立てた作戦を、チームは「窓際作戦」と呼んでいる。",
          "outcomeAssetId": "gidonozeaas.bond.asset.outcome.002",
          "tone": "heroic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "gidonozeaas"
              },
              "mode": "add",
              "trust": 2,
              "ownership": 7
            },
            {
              "type": "sharedPoints",
              "amount": 3
            }
          ],
          "goto": "gidonozeaas.bond.node.effect.001"
        }
      ]
    },
