  "nodes": [
    {
      "type": "direction",
      "id": "peony.join.node.direction.001",
      "command": { "type": "background", "assetId": "peony.join.asset.background.001", "transition": "dissolve" }
    },
    {
      "type": "line",
      "id": "peony.join.node.line.001",
      "lineId": "peony.join.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ピオニーの選手契約の面談は、従業員食堂で行うことになった。広い場所が必要だからだ。物理的に。"
    },
    {
      "type": "line",
      "id": "peony.join.node.line.002",
      "lineId": "peony.join.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "最初の難関は、椅子だった。彼女はこの世の椅子への着席を、極限まで警戒している。過去に三十七脚の犠牲があるらしい。今日は「そーっと」の最高記録に挑み——椅子は無事だった。代わりに、床が三センチ沈んだ。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "peony.join.node.line.003",
      "lineId": "peony.join.line.003",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "……いすは、まもった。"
    },
    {
      "type": "line",
      "id": "peony.join.node.line.004",
      "lineId": "peony.join.line.004",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "はい、椅子は守りました。床はあとで直しましょう。二人で。"
    },
    {
      "type": "line",
      "id": "peony.join.node.line.005",
      "lineId": "peony.join.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "第二の難関は、署名だった。契約書のサイン欄に、ボールペンが三本、次々と殉職した。「そーっと」握っても、彼女の指の中でペンは小枝である。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "peony.join.node.line.006",
      "lineId": "peony.join.line.006",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "……わたし、契約、むいてないのかも。……道具が、みんな、ちいさい。"
    },
    {
      "type": "line",
      "id": "peony.join.node.line.007",
      "lineId": "peony.join.line.007",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "しゅんとする巨人に、私は売店へ走った。買ってきたのは、園児用の特大クレヨン。太さ三センチ、折れる気配なし。彼女の手に、初めて「ちょうどいい」道具が渡った。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "peony.join.node.line.008",
      "lineId": "peony.join.line.008",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "桃色のクレヨンで書かれた「ピオニー」の署名は、契約書からちょっとはみ出して、世界一かわいい法的効力を持った。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "peony.join.node.line.009",
      "lineId": "peony.join.line.009",
      "speakerId": "legacy.speaker.1e9iq7o",
      "speakerName": "ピオニー",
      "mode": "dialogue",
      "text": "ねえ、ミミ。……ほんとうに、いいの？　わたし、つよすぎるよ。まもるつもりで、こわしちゃうこと、あるよ。"
    },
    {
      "type": "line",
      "id": "peony.join.node.line.010",
      "lineId": "peony.join.line.010",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "うちのチーム、壊れたら直す係がいます。私です。備品予算の管理も、私です。……つまり、壊していい環境を作るのが、私の仕事です。"
    },
    {
      "type": "line",
      "id": "peony.join.node.line.011",
      "lineId": "peony.join.line.011",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "彼女の目が、まん丸になった。「こわさないで」と言われ続けた人生に、「壊していい環境を作る」と言う奴が現れたのだ。角の先が、ぴこんと揺れた。うれしい時の癖だと、後で知る。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "peony.join.node.line.012",
      "lineId": "peony.join.line.012",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "契約の締めくくりに、面談らしいことを一つだけ聞くことにした。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "peony.join.node.choice.001",
      "choices": [
        {
          "id": "peony.join.choice.001",
          "label": "迷子係の仕事が終わるまで、一緒に紙の冠を折る",
          "result": "「案内所の仕事は、続けたい」と彼女は言った。なので契約書の特記事項に、クレヨンで一行足した。「迷子案内所の勤務を優先してよい」。以後、うちのエースは試合前でも、迷子の連絡が入ると全速力で案内所へ走る。対戦相手には申し訳ないが、うちの優先順位は、こうなっている。",
          "intent": "彼女の守りたいものごと、契約する",
          "promise": "登録は少し遅れるが、この人専用の成長ポイントを得る。",
          "memory": "特記事項のクレヨンの一行を、二人とも気に入っている。",
          "tone": "tender",
          "effects": [
            { "type": "relationship", "target": { "type": "fighter", "fighterId": "peony" }, "mode": "add", "trust": 8, "ownership": -3 },
            { "type": "fighterPoints", "target": { "type": "fighter", "fighterId": "peony" }, "amount": 2 },
            { "type": "recruitmentDecision", "fighterId": "peony", "decision": "join" }
          ],
          "goto": "peony.join.node.end.001"
        },
        {
          "id": "peony.join.choice.002",
          "label": "託児補助つきの選手契約を先に通す",
          "result": "契約と同時に、総務へ申請を一本出した。「試合日の迷子案内所・臨時託児補助」。ピオニーの試合の日は、案内所に補助員がつく。彼女が後ろを気にせず戦える体制だ。申請理由の欄には正直に書いた。「エースの全力には、留守番の安心が必要なため」。総務は一発で通した。",
          "intent": "守る人の背中を、制度で支える",
          "promise": "本人の甘えは後回しになるが、誰にでも使える成長ポイントを得る。",
          "memory": "託児補助の申請書を、案内所の壁に飾ってある。",
          "tone": "pragmatic",
          "effects": [
            { "type": "relationship", "target": { "type": "fighter", "fighterId": "peony" }, "mode": "add", "trust": 0, "ownership": 8 },
            { "type": "sharedPoints", "amount": 2 },
            { "type": "recruitmentDecision", "fighterId": "peony", "decision": "join" }
          ],
          "goto": "peony.join.node.end.001"
        },
        {
          "id": "peony.join.choice.003",
          "label": "今回はピオニーを誘わず、別の機会を待つ",
          "result": "「今回は、見送りましょう」。彼女はほっとした顔と、少し残念な顔を同時にした。帰り際、沈んだ床を、そーっと、そーっと、踏んで直そうとしてくれた。床はさらに二センチ沈んだ。直すのは、また今度二人で。",
          "intent": "今回はチームへ誘わない",
          "promise": "今回の所属は見送るが、人物の物語と再会の可能性は失わない。",
          "memory": "五センチ沈んだ床のことを、施設課はまだ知らない。",
          "tone": "pragmatic",
          "effects": [
            { "type": "recruitmentDecision", "fighterId": "peony", "decision": "decline" }
          ],
          "goto": "peony.join.node.end.001"
        }
      ]
    },
    {
      "type": "end",
      "id": "peony.join.node.end.001",
      "mode": "return-to-week"
    }
  ],
