{
  "schemaVersion": 1,
  "id": "main.s1.w10",
  "kind": "opening",
  "title": "黒い封筒は、よそのチームに",
  "summary": "掲示板前で見た黒い角封筒と、うちに届いた白い封筒",
  "ownership": {
