{
  "schemaVersion": 1,
  "id": "main.s2.w21",
  "kind": "opening",
  "title": "監督席のない週",
  "summary": "赤線四本目の夜に届いた報復——監督資格停止",
  "ownership": {
    "arcId": "main.stage2"
  },
