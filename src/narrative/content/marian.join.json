              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "marian",
              "decision": "join"
            }
          ],
          "goto": "marian.join.node.end.001"
        },
        {
          "id": "marian.join.choice.003",
          "label": "今回はマリアンを誘わず、別の機会を待つ",
          "result": "「今回は、見送りましょう」彼女は静かにうなずき、帰り際、私の右耳を見て言った。「今日は、早く帰ってください。これは診断でなく、お願いです」お願いの方が、効いた。その日は定時で帰った。",
          "intent": "今回はチームへ誘わない",
          "promise": "今回の所属は見送るが、人物の物語と再会の可能性は失わない。",
          "memory": "「診断ではなく、お願い」の言い方を、私は覚えている。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "recruitmentDecision",
              "fighterId": "marian",
              "decision": "decline"
            }
          ],
          "goto": "marian.join.node.end.001"
        }
      ]
