  "nodes": [
    {
      "type": "direction",
      "id": "night-eater.liberation.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "night-eater.liberation.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "night-eater.liberation.node.line.001",
      "lineId": "night-eater.liberation.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "閉店後のカフェ。契約を終わらせる夜に、彼女が指定した席は、いつもの隅の暗がりだった。机の上には解除届と、彼女がなぜか持参した小さな安全灯。"
    },
    {
      "type": "line",
      "id": "night-eater.liberation.node.line.002",
      "lineId": "night-eater.liberation.line.002",
      "speakerId": "legacy.speaker.ij983g",
      "speakerName": "夜を食べるもの",
      "mode": "dialogue",
      "text": "契約書の、ここ。「照明設備の管理権は所有者に帰属する」。……つまり今、私の夜は、書類の上ではあなたの持ち物なの。"
    },
    {
      "type": "line",
      "id": "night-eater.liberation.node.line.003",
      "lineId": "night-eater.liberation.line.003",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "夜の所有って、書類にすると急に、とんでもないことしてますね私。"
    },
    {
      "type": "line",
      "id": "night-eater.liberation.node.line.004",
      "lineId": "night-eater.liberation.line.004",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "解除届に、二人で判を押した。所有欄の彼女の名前が、すっと薄れて消える。その瞬間、店の窓の外で、夜が少しだけ濃くなった気がした。名前が、夜へ帰ったのだ。",
      "emotion": "tension"
    },
    {
      "type": "direction",
      "id": "night-eater.liberation.node.direction.002",
      "command": {
        "type": "still",
        "assetId": "night-eater.liberation.asset.still.001"
      }
    },
    {
      "type": "direction",
      "id": "night-eater.liberation.node.direction.003",
      "command": {
        "type": "effect",
        "effectId": "pulse"
      }
    },
    {
      "type": "line",
      "id": "night-eater.liberation.node.line.005",
      "lineId": "night-eater.liberation.line.005",
      "speakerId": "legacy.speaker.ij983g",
      "speakerName": "夜を食べるもの",
      "mode": "dialogue",
      "text": "……ひとつ、聞いても。契約が終わっても、私はまだ、ここで食べていい？"
    },
    {
      "type": "line",
      "id": "night-eater.liberation.node.line.006",
      "lineId": "night-eater.liberation.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "声が、少しだけ小さかった。夜そのものみたいな人が、閉店後の一席の心配をしている。私は笑いそうになって、やめて、店員の顔で答えた。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "night-eater.liberation.node.line.007",
      "lineId": "night-eater.liberation.line.007",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "当店、閉店後の常連様がお一人いらっしゃいます。契約書はなくても、指定席はなくなりません。"
    },
    {
      "type": "line",
      "id": "night-eater.liberation.node.line.008",
      "lineId": "night-eater.liberation.line.008",
      "speakerId": "legacy.speaker.ij983g",
      "speakerName": "夜を食べるもの",
      "mode": "dialogue",
      "text": "……常連。……いい言葉。所有より、ずっと上等。"
    },
    {
      "type": "line",
      "id": "night-eater.liberation.node.line.009",
      "lineId": "night-eater.liberation.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "それから彼女は、持参した安全灯を机の真ん中に置いた。小さな緑の灯り。彼女の世界で、唯一おいしそうに見えない光。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "night-eater.liberation.node.line.010",
      "lineId": "night-eater.liberation.line.010",
      "speakerId": "legacy.speaker.ij983g",
      "speakerName": "夜を食べるもの",
      "mode": "dialogue",
      "text": "これは、食べ残す灯り。私がどんなにお腹を空かせても、あなたの帰り道の分は、残す。……自由になった私の、最初の校則。"
    },
    {
      "type": "line",
      "id": "night-eater.liberation.node.line.011",
      "lineId": "night-eater.liberation.line.011",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "校則……規則、じゃなくてですか。"
    },
    {
      "type": "line",
      "id": "night-eater.liberation.node.line.012",
      "lineId": "night-eater.liberation.line.012",
      "speakerId": "legacy.speaker.ij983g",
      "speakerName": "夜を食べるもの",
      "mode": "dialogue",
      "text": "規則は、破りたくなる味がする。校則は……守ると、ちょっと誇らしい味がするの。"
    },
    {
      "type": "line",
      "id": "night-eater.liberation.node.line.013",
      "lineId": "night-eater.liberation.line.013",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "食レポの人の語彙は、最後まで食レポだった。緑の小さな灯りを挟んで、契約のなくなった夜と、閉店後の店員が座っている。この距離に名前はまだ無いけれど、常連と店員よりは、たぶんちょっと近い。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "night-eater.liberation.node.line.014",
      "lineId": "night-eater.liberation.line.014",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "帰り支度の前に、決めることが一つ。この夜の締め方だ。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "night-eater.liberation.node.choice.001",
      "choices": [
        {
          "id": "night-eater.liberation.choice.001",
          "label": "照明設備の所有欄を消し、夜へ名前を返す",
          "result": "解除届の控えと一緒に、私は施設の照明台帳も書き換えた。管理権の欄に「夜間はカフェ常連様の裁量に委ねる」。総務には怒られたが、撤回はしなかった。彼女はその一行を三回読んで、「この台帳、今まで読んだ書類でいちばおいしい」と評した。書類の食レポは初めて聞いた。",
          "intent": "書類の上でも、夜を本人へ返す",
          "promise": "所有者名を消し、本人が自分の名で次の試合を選べるようにする。",
          "memory": "照明台帳の一行を、彼女は宝物の判例だと思っている。",
          "tone": "defiant",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "night-eater"
              },
              "mode": "add",
              "trust": 10,
              "ownership": 0
            },
            {
              "type": "liberationDecision",
              "fighterId": "night-eater",
              "decision": "release"
            }
          ],
          "goto": "night-eater.liberation.node.effect.001"
        },
        {
          "id": "night-eater.liberation.choice.002",
          "label": "契約を解いたあと、閉店作業だけ改めて頼む",
          "result": "「契約じゃなくて、アルバイトとしてどうですか。閉店作業、時給は星空でお支払いします」。彼女は真剣に検討し(三十秒)、「前払いで」と答えた。その夜の閉店作業は、天の川の下で行われた。時給の相場としては、たぶん史上最高である。",
          "intent": "自由になった人へ、改めて仕事を頼む",
          "promise": "断る権利を返したうえで、閉店作業の新しい約束を結ぶ。",
          "memory": "時給が星空のアルバイト契約を、二人とも気に入っている。",
          "tone": "tender",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "night-eater"
              },
              "mode": "add",
              "trust": 6,
              "ownership": 0
            },
            {
              "type": "sharedPoints",
              "amount": 4
            },
            {
              "type": "liberationDecision",
              "fighterId": "night-eater",
              "decision": "release"
            }
          ],
          "goto": "night-eater.liberation.node.effect.001"
        }
      ]
    },
    {
