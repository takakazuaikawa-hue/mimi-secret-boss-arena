  "nodes": [
    {
      "type": "direction",
      "id": "sazanami.join.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "sazanami.join.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "sazanami.join.node.line.001",
      "lineId": "sazanami.join.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "さざなみの選手登録は、噴水広場で行うことになった。水があるから話しやすいだろうという私の配慮は、五分で裏目に出る。"
    },
    {
      "type": "line",
      "id": "sazanami.join.node.line.002",
      "lineId": "sazanami.join.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "影の一部が噴水へ移った途端、噴水の水位が三倍になった。広場の鳩が避難する。私は端末を開き、平常心で登録を始めた。接客業は、平常心の商売である。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "sazanami.join.node.line.003",
      "lineId": "sazanami.join.line.003",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "身長欄……えっと、さざなみさん、身長は。"
    },
    {
      "type": "line",
      "id": "sazanami.join.node.line.004",
      "lineId": "sazanami.join.line.004",
      "speakerId": "legacy.speaker.we7zqt",
      "speakerName": "さざなみ",
      "mode": "dialogue",
      "text": "……どこからどこまでを、私と数えるかによる。潮なら、月まで届く日もある。"
    },
    {
      "type": "line",
      "id": "sazanami.join.node.line.005",
      "lineId": "sazanami.join.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "身長欄に「満潮時、月まで」と書いたら端末が再起動した。体重欄は自動計測に切り替わり、三十秒考えた末に「海溝」と表示して沈黙した。単位ですらない。",
      "emotion": "comic"
    },
    {
      "type": "direction",
      "id": "sazanami.join.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "shake"
      }
    },
    {
      "type": "line",
      "id": "sazanami.join.node.line.006",
      "lineId": "sazanami.join.line.006",
      "speakerId": "legacy.speaker.we7zqt",
      "speakerName": "さざなみ",
      "mode": "dialogue",
      "text": "……やはり、無理があるのでは。私が試合に出れば、会場が沈む。観客の靴が濡れる。売店の焼きそばが、しける。"
    },
    {
      "type": "line",
      "id": "sazanami.join.node.line.007",
      "lineId": "sazanami.join.line.007",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "心配の三つ目が焼きそばなのが、この人だった。規模は海溝、気遣いは売店単位。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "sazanami.join.node.line.008",
      "lineId": "sazanami.join.line.008",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "なら、影だけ登録しましょう。水槽一個ぶんの、あなたの影。本体は海でお留守番です。"
    },
    {
      "type": "line",
      "id": "sazanami.join.node.line.009",
      "lineId": "sazanami.join.line.009",
      "speakerId": "legacy.speaker.we7zqt",
      "speakerName": "さざなみ",
      "mode": "dialogue",
      "text": "影だけ。……そんな出場が、許されるのか。"
    },
    {
      "type": "line",
      "id": "sazanami.join.node.line.010",
      "lineId": "sazanami.join.line.010",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "うちには災害カテゴリを同伴客に書き直した前例と、応援席が上空の前例があります。影くらい、通ります。"
    },
    {
      "type": "line",
      "id": "sazanami.join.node.line.011",
      "lineId": "sazanami.join.line.011",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "前例の使い方が完全に悪い方の事務員だが、実際、通った。出場区分「影(水槽つき)」。端末もこのチームの登録には慣れてきたのか、今回は一度も煙を吹かなかった。成長している。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "sazanami.join.node.line.012",
      "lineId": "sazanami.join.line.012",
      "speakerId": "legacy.speaker.we7zqt",
      "speakerName": "さざなみ",
      "mode": "dialogue",
      "text": "……一つ、条件が。私の影が誰かの岸を揺らしたら、すぐに教えてほしい。私は、自分の大きさに、気づくのが遅い。"
    },
    {
      "type": "line",
      "id": "sazanami.join.node.line.013",
      "lineId": "sazanami.join.line.013",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "自分の大きさに気づくのが遅い。それは巨大な海の話であり、たぶん、優しさの話でもあった。この人の気遣いは、いつも本人が思うより大きく届く。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "sazanami.join.node.line.014",
      "lineId": "sazanami.join.line.014",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "登録の最後に、面談の締めをどうするか。聞きたい話は、まだあった。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "sazanami.join.node.choice.001",
      "choices": [
        {
          "id": "sazanami.join.choice.001",
          "label": "水槽越しに、寝返りで揺れた海岸の話を聞く",
          "result": "登録後、夜の水槽前で「揺らしてしまった岸」の話を聞いた。祭りの提灯を消した波。子どもの砂の城を崩した満ち潮。彼女は全部、覚えていた。「揺らした岸の数だけ、謝りたい相手がいる」。私は手帳に書いた。今度の休み、海岸清掃のボランティアにチームで参加する。謝り方は、一つじゃない。",
          "intent": "大きさの後悔を、最後まで聞く",
          "promise": "登録は少し遅れるが、この人専用の成長ポイントを得る。",
          "memory": "揺らした岸の一覧を、二人で「これから謝りに行く場所リスト」に変えた。",
          "tone": "tender",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "sazanami"
              },
              "mode": "add",
              "trust": 8,
              "ownership": -3
            },
            {
              "type": "fighterPoints",
              "target": {
                "type": "fighter",
                "fighterId": "sazanami"
              },
              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "sazanami",
              "decision": "join"
            }
          ],
          "goto": "sazanami.join.node.end.001"
        },
        {
          "id": "sazanami.join.choice.002",
          "label": "水槽の影だけを、出場者として登録する",
          "result": "出場区分「影(水槽つき)」は、その日のうちに受理された。運営から届いた注意書きは一行。「水槽の水は、こぼさないでください」。さざなみはそれを三回読んで、泡文字で返信を書いた。「善処します(波は、生き物なので)」。運営と海の文通が、こうして始まった。",
          "intent": "確実に出場できる形を先に固める",
          "promise": "本人の事情は後回しになるが、誰にでも使える成長ポイントを得る。",
          "memory": "運営との泡文字の文通を、チームの全員が楽しみにしている。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "sazanami"
              },
              "mode": "add",
              "trust": 0,
              "ownership": 8
            },
            {
              "type": "sharedPoints",
              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "sazanami",
              "decision": "join"
            }
          ],
          "goto": "sazanami.join.node.end.001"
        },
        {
          "id": "sazanami.join.choice.003",
          "label": "今回はさざなみを誘わず、別の機会を待つ",
          "result": "「今回は、見送りましょう」。影は静かに噴水から引いていった。水位が戻ったあと、噴水の底に泡文字がひとつ、ゆっくり消えずに残っていた。「誘ってくれたこと——百点」。採点の人の百点は、重い。",
          "intent": "今回はチームへ誘わない",
          "promise": "今回の所属は見送るが、人物の物語と再会の可能性は失わない。",
          "memory": "噴水の底の百点を、私は誰にも言わずに覚えている。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "recruitmentDecision",
              "fighterId": "sazanami",
              "decision": "decline"
            }
          ],
          "goto": "sazanami.join.node.end.001"
        }
      ]
    },
    {
