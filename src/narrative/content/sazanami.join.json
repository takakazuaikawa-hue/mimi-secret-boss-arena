              "decision": "join"
            }
          ],
          "goto": "sazanami.join.node.end.001"
        },
        {
          "id": "sazanami.join.choice.002",
          "label": "水槽の影だけを、出場者として登録する",
          "result": "体重欄は『沿岸三県』、身長欄は『干潮時参照』で受理された。受付の理解が追いつく前に背番号が出た。",
          "intent": "次の公式戦へ間に合わせる",
          "promise": "本人の詳細は後回しになるが、誰にでも使える成長ポイントを得る。",
          "memory": "先に席を確保した判断は、チームの始まり方として記録に残る。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
