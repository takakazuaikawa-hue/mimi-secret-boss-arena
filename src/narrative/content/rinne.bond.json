  "nodes": [
    {
      "type": "direction",
      "id": "rinne.bond.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "rinne.bond.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "rinne.bond.node.line.001",
      "lineId": "rinne.bond.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "試合のない雨の午後、賭場でリンネに捕まった。「雨、あと四十分で上がる。上がったら夜市が出る。付き合って」。未来視の使い方が、完全に天気予報とお出かけの誘いだった。世界を左右する力の、正しい浪費だと思う。"
    },
    {
      "type": "line",
      "id": "rinne.bond.node.line.002",
      "lineId": "rinne.bond.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "予報どおり雨は上がり、闘技場の裏通りに夜市が伸びた。提灯、揚げ物の湯気、くじ屋の口上。リンネは屋台の間を、店が損をする未来だけ器用に避けながら歩く。だから彼女の通った後は、なぜかどの店主も機嫌がいい。",
      "emotion": "comic"
    },
    {
      "type": "direction",
      "id": "rinne.bond.node.direction.003",
      "command": { "type": "still", "assetId": "rinne.bond.asset.still.001" }
    },
    {
      "type": "line",
      "id": "rinne.bond.node.line.003",
      "lineId": "rinne.bond.line.003",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "事件は射的屋で起きた。リンネは五発撃って、五発とも外した。全部、狙って外した。景品の兎のぬいぐるみの、周りの空白だけを正確に撃ち続けたのだ。六発目を構えたところで、店主が根負けした。「もう持ってけ! 頼むから他の店に行ってくれ!」。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "rinne.bond.node.line.004",
      "lineId": "rinne.bond.line.004",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "未来が見えるなら、一発で当てた方が早くないですか。"
    },
    {
      "type": "line",
      "id": "rinne.bond.node.line.005",
      "lineId": "rinne.bond.line.005",
      "speakerId": "legacy.speaker.1vpt9ol",
      "speakerName": "リンネ",
      "mode": "dialogue",
      "text": "当たる未来は退屈なんだよ。結果が最初から見えてる的を撃つのは、答えを写すのと同じ。外しながら別の勝ち方を探す方が、ずっと面白い。"
    },
    {
      "type": "direction",
      "id": "rinne.bond.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "pulse"
      }
    },
    {
      "type": "direction",
      "id": "rinne.bond.node.direction.004",
      "command": { "type": "still", "assetId": "rinne.bond.asset.still.002" }
    },
    {
      "type": "line",
      "id": "rinne.bond.node.line.006",
      "lineId": "rinne.bond.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "彼女は戦利品の兎を、当然のように私へ渡した。「はい。あんたの」。自分は何も得ていないのに、今夜いちばん楽しそうな顔で笑う。提灯の灯りの下でそれを見て、私は兎を受け取る手が少し遅れた。心の準備というものがある。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "rinne.bond.node.line.007",
      "lineId": "rinne.bond.line.007",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "帰り道、屋台のくじ屋の前で、彼女がふと立ち止まった。「私さ、負けを笑って次へ行くの、得意でしょ。あれ、特技じゃないよ。失くしたものを惜しむ時間を、自分にあげないだけ」。声は軽かった。軽い声で言う練習を、たくさんしてきた軽さだった。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "rinne.bond.node.line.008",
      "lineId": "rinne.bond.line.008",
      "speakerId": "legacy.speaker.1vpt9ol",
      "speakerName": "リンネ",
      "mode": "dialogue",
      "text": "だからね、ほしいものは実は、ずっと一つだけ。当たり外れのない約束を、一度だけ信じて、待ってみること。……ほら、笑って。今の、たぶんこの夜市で一番地味な願い事だから。"
    },
    {
      "type": "line",
      "id": "rinne.bond.node.line.009",
      "lineId": "rinne.bond.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "笑えなかった。代わりに、それは私が叶えるものではないけれど、叶うまで隣にいることならできる——と言いかけて、揚げ物の屋台の煙に、盛大にむせた。人生で一番大事な台詞の、一番ひどい中断だった。リンネは今度こそ、声を上げて笑った。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "rinne.bond.node.line.010",
      "lineId": "rinne.bond.line.010",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "夜市の終わりに、くじ屋の前で締めを決める。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "rinne.bond.node.choice.001",
      "choices": [
        {
          "id": "rinne.bond.choice.001",
          "label": "当たりを聞かず、夜市のくじを一枚ずつ引く",
          "result": "「見ないでよ」と釘を刺して、二人で一枚ずつ引いた。結果、二人とも外れ。景品はティッシュ一つずつ。なのにリンネは、外れくじを大事そうに財布へしまった。「初めてだ。結果を知らないまま引いて、知らないまま外れた。……くじって、こんなにドキドキするんだね」。未来の見える人の初めての外れくじが、今夜の夜市の、一番の当たりだった。",
          "intent": "相手の秘密の勝ち方を試す",
          "promise": "読みにくい作戦になる代わりに、この人だけの成長を大きく進める。",
          "memory": "任せた一戦の手応えが、次に力を見せる理由になる。",
          "tone": "wild",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "rinne"
              },
              "mode": "add",
              "trust": 9,
              "ownership": -2
            },
            {
              "type": "fighterPoints",
              "target": {
                "type": "fighter",
                "fighterId": "rinne"
              },
              "amount": 3
            }
          ],
          "goto": "rinne.bond.node.effect.001"
        },
        {
          "id": "rinne.bond.choice.002",
          "label": "次戦の勝率を、三人の役割ごとに計算する",
          "result": "夜市の帰りに賭場へ寄って、次戦の役割別勝率をリンネと計算した。数字は綺麗に上がった。ただ、最良の組み合わせだけが、彼女の見た未来と食い違った。「面白い。私の見てない未来を、あんたの計算が指してる」。予知と算数の隙間から、新しい作戦がひとつ生まれた。",
          "intent": "チームの新しい連携を試す",
          "promise": "本人の流儀は崩すが、全員へ配れる成長ポイントを得る。",
          "memory": "成功した作戦と短くなった会話の両方が、次の判断まで残る。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "rinne"
              },
              "mode": "add",
              "trust": 1,
              "ownership": 7
            },
            {
              "type": "sharedPoints",
              "amount": 3
            }
          ],
          "goto": "rinne.bond.node.effect.001"
        }
      ]
    },
    {
      "type": "effect",
