  "nodes": [
    {
      "type": "direction",
      "id": "shahar.power.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "shahar.power.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "shahar.power.node.line.001",
      "lineId": "shahar.power.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "次の相手は空中戦を得意とする強敵らしい。作戦会議の結論は一つ。「一度、本気のシャハルを見ておく必要がある」。かくして深夜、閉場後の闘技場に、関係者だけが集まった。"
    },
    {
      "type": "line",
      "id": "shahar.power.node.line.002",
      "lineId": "shahar.power.line.002",
      "speakerId": "legacy.speaker.bkqdo1",
      "speakerName": "シャハル",
      "mode": "dialogue",
      "text": "本体で降ります。念のため、三県に天気予報の訂正を出しておいてください。"
    },
    {
      "type": "line",
      "id": "shahar.power.node.line.003",
      "lineId": "shahar.power.line.003",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "予報の訂正から始まる登場を、私は初めて見た。計測係の新人くんが、もう震えている。彼はうちの規格外たちの測定で、たぶん今月一番働いている。",
      "emotion": "comic"
    },
    {
      "type": "direction",
      "id": "shahar.power.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "flash"
      }
    },
    {
      "type": "line",
      "id": "shahar.power.node.line.004",
      "lineId": "shahar.power.line.004",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "夜の雲が、真上で割れた。月光を背に、銀白の山脈が降りてくる。翼の一打ちで観客席の旗が全部同じ向きに揃い、二打ち目で夜雲が渦を巻いた。着地はしない。闘技場の上空で、都市より大きい体が、静かにホバリングしている。",
      "emotion": "tension"
    },
    {
      "type": "direction",
      "id": "shahar.power.node.direction.003",
      "command": {
        "type": "still",
        "assetId": "shahar.power.asset.still.001"
      }
    },
    {
      "type": "direction",
      "id": "shahar.power.node.direction.004",
      "command": {
        "type": "effect",
        "effectId": "pulse"
      }
    },
    {
      "type": "line",
      "id": "shahar.power.node.line.005",
      "lineId": "shahar.power.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "新人くんの計測器は、三秒で「規格外」、五秒で煙。彼は今夜、記録板に「そら、ぜんぶ」と書いた。詩人になってきた。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "shahar.power.node.line.006",
      "lineId": "shahar.power.line.006",
      "speakerId": "legacy.speaker.bkqdo1",
      "speakerName": "シャハル",
      "mode": "dialogue",
      "text": "ミミさん。あなたに、見せたい景色があります。——背に、専用席を作りました。"
    },
    {
      "type": "line",
      "id": "shahar.power.node.line.007",
      "lineId": "shahar.power.line.007",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "せ、専用席？　……安全帯は？"
    },
    {
      "type": "line",
      "id": "shahar.power.node.line.008",
      "lineId": "shahar.power.line.008",
      "speakerId": "legacy.speaker.bkqdo1",
      "speakerName": "シャハル",
      "mode": "dialogue",
      "text": "四百年ぶんの流行を研究して、最新式を編みました。座り心地には、自信があります。"
    },
    {
      "type": "line",
      "id": "shahar.power.node.line.009",
      "lineId": "shahar.power.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "鱗のエレベーターで背中へ上がると、本当に席があった。銀の留め飾りつきの、一人ぶんの座席。安全帯を締める手が、少し震える。武者震いだと思いたい。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "shahar.power.node.line.010",
      "lineId": "shahar.power.line.010",
      "speakerId": "legacy.speaker.bkqdo1",
      "speakerName": "シャハル",
      "mode": "dialogue",
      "text": "行きます。——今夜の飛行は、一度きり。二度と同じ空はありません。"
    },
    {
      "type": "line",
      "id": "shahar.power.node.line.011",
      "lineId": "shahar.power.line.011",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "浮遊感。夜景が沈む。雲を一枚抜けるたび、世界が静かになっていく。月が近い。街の灯が、テーブルの上のろうそくみたいに小さい。風は強いのに、専用席の周りだけ、そよ風だった。翼が、私のぶんだけ風を割いてくれている。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "shahar.power.node.line.012",
      "lineId": "shahar.power.line.012",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "……シャハルさん、これ、毎晩見てたんですか。一人で。"
    },
    {
      "type": "line",
      "id": "shahar.power.node.line.013",
      "lineId": "shahar.power.line.013",
      "speakerId": "legacy.speaker.bkqdo1",
      "speakerName": "シャハル",
      "mode": "dialogue",
      "text": "ええ。四百年。……今夜、初めて、隣の席が埋まりました。"
    },
    {
      "type": "line",
      "id": "shahar.power.node.line.014",
      "lineId": "shahar.power.line.014",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "心臓が跳ねた。高度のせいにしておく。眼下では、街の光が瞬きながら色を変えていた。看板の灯、閉店の灯、誰かの家の灯。長い人は、この移り変わりを、ずっと一人の席から見送ってきたのだ。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "shahar.power.node.line.015",
      "lineId": "shahar.power.line.015",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "降下しながら、本題を思い出す。この力を、試合でどう使うか。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "shahar.power.node.choice.001",
      "choices": [
        {
          "id": "shahar.power.choice.001",
          "label": "本体へ名前を呼び、雲の切れ間から降りてもらう",
          "result": "決めたのは「名前で呼んだ時だけ、本体が来る」という型だった。試合中、私が「シャハル！」と呼ぶと、会場の空が割れて翼の影が差す。降りる必要すらない。影だけで、相手の陣形が崩れる。「呼ばれて出てくるのは、四百年ぶりです」と本人はうれしそうだった。呼ばれ待ちだったらしい。",
          "intent": "本気の登場を、二人の合図にする",
          "promise": "失敗時の危険を引き受け、この人専用の成長を最大まで進める。",
          "memory": "名前を呼べば空が割れることを、チームの全員が知っている。",
          "tone": "heroic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "shahar"
              },
              "mode": "add",
              "trust": 10,
              "ownership": -4
            },
            {
              "type": "fighterPoints",
              "target": {
                "type": "fighter",
                "fighterId": "shahar"
              },
              "amount": 5
            }
          ],
          "goto": "shahar.power.node.effect.001"
        },
        {
          "id": "shahar.power.choice.002",
          "label": "鱗一枚で起こせる風だけを測る",
          "result": "本体は温存し、鱗一枚の風力を深夜まで計測した。結論、鱗一枚で送風機百台ぶん。「そよ風」から「看板が飛ぶ」まで七段階に調整できるようになり、新人くんの報告書には「風力、七段階。やさしさ、無段階」と書かれていた。彼の報告書は、最近文学になってきた。",
          "intent": "安全に使える出力の目盛りを作る",
          "promise": "本来の力は一部に留め、チーム全体の成長へ成果を持ち帰る。",
          "memory": "風力七段階の目盛りを、チームは「シャハルの風速計」と呼ぶ。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "shahar"
              },
              "mode": "add",
              "trust": 0,
              "ownership": 9
            },
            {
              "type": "sharedPoints",
              "amount": 5
            }
          ],
          "goto": "shahar.power.node.effect.001"
        }
      ]
    },
    {
      "type": "effect",
      "id": "shahar.power.node.effect.001",
      "effects": [
        {
          "type": "setStoryStage",
          "fighterId": "shahar",
          "stage": 4
        }
      ]
    },
    {
