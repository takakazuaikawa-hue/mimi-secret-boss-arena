  "nodes": [
    {
      "type": "direction",
      "id": "gidonozeaas.meet.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "gidonozeaas.meet.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "direction",
      "id": "gidonozeaas.meet.node.direction.002",
      "command": {
        "type": "clearSprites"
      }
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.001a",
      "lineId": "gidonozeaas.meet.line.001a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "閉店五分前。レジを締めて、看板を仕舞う。"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.001b",
      "lineId": "gidonozeaas.meet.line.001b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "耳は、もう半分寝ていた。あと五分の、はずだった。"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.002a",
      "lineId": "gidonozeaas.meet.line.002a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "窓際に、お客さまが一人。黒い星を抱いた、つやつやのスライム。"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.002b",
      "lineId": "gidonozeaas.meet.line.002b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "机の上に、几帳面に畳まれた整理券。番号は「一番」"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.003a",
      "lineId": "gidonozeaas.meet.line.003a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "お客様、まもなく閉店です。ご注文は、お済みですか?"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.004a",
      "lineId": "gidonozeaas.meet.line.004a",
      "speakerId": "legacy.speaker.1jmq03z",
      "speakerName": "ギドノゼアース",
      "mode": "dialogue",
      "text": "限定パフェを。……三百年、待ちました。"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.005a",
      "lineId": "gidonozeaas.meet.line.005a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "三百年? 待ち時間の単位が、根本からおかしい。"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.005b",
      "lineId": "gidonozeaas.meet.line.005b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "厨房から来た伝票を見て、血の気が引いた。本日の限定パフェ、たった今、売り切れ。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.006a",
      "lineId": "gidonozeaas.meet.line.006a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "大変申し訳ございません。限定パフェ、本日……売り切れです……"
    },
    {
      "type": "direction",
      "id": "gidonozeaas.meet.node.direction.003",
      "command": {
        "type": "show",
        "assetId": "gidonozeaas.meet.asset.sprite.002",
        "actorId": "gidonozeaas",
        "slot": "right",
        "scale": "compact"
      }
    },
    {
      "type": "direction",
      "id": "gidonozeaas.meet.node.direction.004",
      "command": {
        "type": "effect",
        "effectId": "shake"
      }
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.007a",
      "lineId": "gidonozeaas.meet.line.007a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "黒い星が、ぐらりと揺れた。夕焼けが、濃くなる。"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.007b",
      "lineId": "gidonozeaas.meet.line.007b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "砂糖壺が、一斉に蓋を閉めた。世界の終わりって、食器から始まるらしい。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.008a",
      "lineId": "gidonozeaas.meet.line.008a",
      "speakerId": "legacy.speaker.1jmq03z",
      "speakerName": "ギドノゼアース",
      "mode": "dialogue",
      "text": "……大丈夫。慣れています。"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.008b",
      "lineId": "gidonozeaas.meet.line.008b",
      "speakerId": "legacy.speaker.1jmq03z",
      "speakerName": "ギドノゼアース",
      "mode": "dialogue",
      "text": "私が並ぶと、だいたい世界の方が先に終わろうとするので。"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.009a",
      "lineId": "gidonozeaas.meet.line.009a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ぜんぜん大丈夫じゃない。でも、聞き逃さなかった。"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.009b",
      "lineId": "gidonozeaas.meet.line.009b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "この人、怒るより先に「慣れ」を出した。三百年の売り切れに、もう慣れている。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.010a",
      "lineId": "gidonozeaas.meet.line.010a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "——お客様。再販日は、来週の火曜日です。"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.010b",
      "lineId": "gidonozeaas.meet.line.010b",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "取り置き票を書きます。お名前、いいですか。"
    },
    {
      "type": "direction",
      "id": "gidonozeaas.meet.node.direction.005",
      "command": {
        "type": "still",
        "assetId": "gidonozeaas.meet.asset.still.001"
      }
    },
    {
      "type": "direction",
      "id": "gidonozeaas.meet.node.direction.006",
      "command": {
        "type": "effect",
        "effectId": "pulse"
      }
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.011a",
      "lineId": "gidonozeaas.meet.line.011a",
      "speakerId": "legacy.speaker.1jmq03z",
      "speakerName": "ギドノゼアース",
      "mode": "dialogue",
      "text": "……取り置き。並ばなくても、いいのですか。"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.012a",
      "lineId": "gidonozeaas.meet.line.012a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "三百年並んだお客様を、これ以上並ばせたら、うちの店の名折れです。"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.013a",
      "lineId": "gidonozeaas.meet.line.013a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "窓ガラスの影が揺れた。スライムが一瞬、銀髪の男に見えた。"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.013b",
      "lineId": "gidonozeaas.meet.line.013b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "まばたきの間に、戻ってしまう。今の、何?",
      "emotion": "tension"
    },
    {
      "type": "direction",
      "id": "gidonozeaas.meet.node.direction.007",
      "command": {
        "type": "show",
        "assetId": "gidonozeaas.meet.asset.sprite.001",
        "actorId": "gidonozeaas",
        "slot": "right",
        "scale": "compact"
      }
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.014a",
      "lineId": "gidonozeaas.meet.line.014a",
      "speakerId": "legacy.speaker.1jmq03z",
      "speakerName": "ギドノゼアース",
      "mode": "dialogue",
      "text": "見ましたね。……今のは、封印の継ぎ目です。"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.014b",
      "lineId": "gidonozeaas.meet.line.014b",
      "speakerId": "legacy.speaker.1jmq03z",
      "speakerName": "ギドノゼアース",
      "mode": "dialogue",
      "text": "安いガラスには、映ってしまうので。"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.015a",
      "lineId": "gidonozeaas.meet.line.015a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "うち、ガラスだけは高級なんですけど……"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.016a",
      "lineId": "gidonozeaas.meet.line.016a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "心臓が、うるさいくらい。耳の先まで、熱くなる。"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.016b",
      "lineId": "gidonozeaas.meet.line.016b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "きれいな人のせいか、世界の終わりのせいか、分からない。私は、名前欄を差し出した。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.017a",
      "lineId": "gidonozeaas.meet.line.017a",
      "speakerId": "legacy.speaker.1jmq03z",
      "speakerName": "ギドノゼアース",
      "mode": "dialogue",
      "text": "ギドノゼアース。——滅ぼす予定だった世界が、先に平和になってしまった者です。"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.017b",
      "lineId": "gidonozeaas.meet.line.017b",
      "speakerId": "legacy.speaker.1jmq03z",
      "speakerName": "ギドノゼアース",
      "mode": "dialogue",
      "text": "以来、待つのが仕事のようなもので。"
    },
    {
      "type": "direction",
      "id": "gidonozeaas.meet.node.direction.008",
      "command": {
        "type": "show",
        "assetId": "gidonozeaas.meet.asset.sprite.003",
        "actorId": "gidonozeaas",
        "slot": "right",
        "scale": "compact"
      }
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.018a",
      "lineId": "gidonozeaas.meet.line.018a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "物語が終わった人の顔を、初めて見た気がした。"
    },
    {
      "type": "line",
      "id": "gidonozeaas.meet.node.line.018b",
      "lineId": "gidonozeaas.meet.line.018b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "閉店五分前の窓際で、帰り支度より先に、やることができた。",
      "emotion": "tender"
    },
    {
      "type": "choice",
      "id": "gidonozeaas.meet.node.choice.001",
      "choices": [
        {
          "id": "gidonozeaas.meet.choice.001",
          "label": "休憩扱いにして、向かいへ座る",
          "result": "「休憩中」の札を立てて、向かいに座った。三百年の暇つぶし話を聞いた。星の数え方、行列の礼儀、売り切れの飲み込み方。蛍の光が三回流れても、誰も立たなかった。帰り際、彼は控えを宝物みたいに二回折った。",
          "intent": "登録の前に、目の前の相手と席を分ける",
          "promise": "目先の報酬は得ない代わりに、相手が何を待っているかを知る。",
          "memory": "三百年で初めて「取り置き」を提案した店員として、ギドノゼアースは私を覚えている。",
          "tone": "tender",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "gidonozeaas"
              },
              "mode": "add",
              "trust": 8,
              "ownership": -2
            }
          ],
          "goto": "gidonozeaas.meet.node.effect.001"
        },
        {
          "id": "gidonozeaas.meet.choice.002",
          "label": "今日はギドノゼアースを誘わず、用事へ戻る",
          "result": "取り置き票だけ渡して、閉店作業へ戻った。翌朝、窓際の席に整理券が一枚。番号は「二番」で、裏に小さな字で「一番は、あなたの休憩に譲ります」誰が置いたかは、考えるまでもなかった。",
          "intent": "今日は仕事へ戻り、距離を保つ",
          "promise": "所属選手にはならないが、後の出来事で再会できる。",
          "memory": "取り置き票を書いた店員のことを、ギドノゼアースは整理券と一緒に覚えている。",
          "tone": "pragmatic",
          "effects": [],
          "goto": "gidonozeaas.meet.node.effect.001"
        }
      ]
    },
    {
      "type": "effect",
      "id": "gidonozeaas.meet.node.effect.001",
      "effects": [
        {
          "type": "markEncountered",
          "fighterId": "gidonozeaas",
          "encountered": true
        },
        {
          "type": "setStoryStage",
          "fighterId": "gidonozeaas",
          "stage": 1
        }
      ]
    },
    {
      "type": "end",
      "id": "gidonozeaas.meet.node.end.001",
      "mode": "return-to-week"
    }
  ],
