        "type": "clearSprites"
      }
    },
    {
      "type": "direction",
      "id": "main.s2.w11.node.direction.mimi.opening",
      "command": {
        "type": "show",
        "assetId": "main.s2.w11.asset.sprite.mimi.tsukkomi",
        "actorId": "mimi",
        "slot": "left",
        "scale": "tall"
      }
    },
    {
      "type": "line",
      "id": "main.s2.w11.node.line.001a",
      "lineId": "main.s2.w11.line.001a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "広場に、貼り紙。"
    },
    {
      "type": "line",
      "id": "main.s2.w11.node.line.001b",
      "lineId": "main.s2.w11.line.001b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「世界滅亡ショー・エキストラ大募集(日当・弁当つき)」滅亡の、エキストラ。"
    },
    {
      "type": "line",
      "id": "main.s2.w11.node.line.001c",
      "lineId": "main.s2.w11.line.001c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "字面だけで、眩暈がする。この街は、その求人を「弁当つき」の四文字で読む。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "main.s2.w11.node.line.002a",
      "lineId": "main.s2.w11.line.002a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "練習は、広場で公開だった。演出係が、拡声器で叫ぶ。"
    },
    {
      "type": "line",
      "id": "main.s2.w11.node.line.002b",
      "lineId": "main.s2.w11.line.002b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「避難の皆さーん、もっと慌てて! 去年はもっと必死でしたよね!?」"
    },
    {
      "type": "line",
      "id": "main.s2.w11.node.line.002c",
      "lineId": "main.s2.w11.line.002c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "……去年、本当に必死だった人たちに、向かって。"
    },
    {
      "type": "line",
      "id": "main.s2.w11.node.line.003a",
      "lineId": "main.s2.w11.line.003a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "剣士さんが、いた。エキストラの列で、自分の避難を演技指導されていた。"
    },
    {
      "type": "line",
      "id": "main.s2.w11.node.line.003b",
      "lineId": "main.s2.w11.line.003b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「おじいさん、そこはもっと絶望的に!」「……わしは去年、絶望はしとらんのじゃが」"
    },
    {
      "type": "line",
      "id": "main.s2.w11.node.line.003c",
      "lineId": "main.s2.w11.line.003c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「台本では絶望です!」台本では、絶望。耳が、笑いをこらえて震えた。",
      "emotion": "comic"
    },
    {
      "type": "direction",
      "id": "main.s2.w11.node.direction.mimi.shift.001",
      "command": {
        "type": "show",
        "assetId": "main.s2.w11.asset.sprite.mimi.serious",
        "actorId": "mimi",
        "slot": "left",
        "scale": "tall"
      }
    },
    {
      "type": "line",
      "id": "main.s2.w11.node.line.004a",
      "lineId": "main.s2.w11.line.004a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「はい次ー、『英雄たちの覚醒』! 代役の皆さん、屋上セットへ!」うちの三人の、あの一斉解放が、代役で再現されていく。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "main.s2.w11.node.line.005a",
      "lineId": "main.s2.w11.line.005a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "代役さんたちは、上手かった。構えの角度も、合図の間も、よく研究してある。"
    },
    {
      "type": "line",
      "id": "main.s2.w11.node.line.005b",
      "lineId": "main.s2.w11.line.005b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ただ一つ、どうしても再現できないものがある。"
    },
    {
      "type": "line",
      "id": "main.s2.w11.node.line.005c",
      "lineId": "main.s2.w11.line.005c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "あの日の三人は、楽しそうだった。台本は、楽しさを書き起こせない。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "main.s2.w11.node.line.006a",
      "lineId": "main.s2.w11.line.006a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "見学の輪で、誰かがぽつりと言った。「……なんか、違うよなあ」周りが、静かに頷いた。"
    },
    {
      "type": "line",
      "id": "main.s2.w11.node.line.006b",
      "lineId": "main.s2.w11.line.006b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "街は弁当で釣られても、目は誤魔化されない。この「なんか違う」が、いつか大きな声になる。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "main.s2.w11.node.line.007a",
      "lineId": "main.s2.w11.line.007a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "帰りぎわ、演出係に呼び止められた。「あ! 本物の監督さん!」"
    },
    {
      "type": "line",
      "id": "main.s2.w11.node.line.007b",
      "lineId": "main.s2.w11.line.007b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「よかったら本番、ご本人役で出ません? 説得力が段違いなので!」",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "main.s2.w11.node.line.008a",
      "lineId": "main.s2.w11.line.008a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「お断りします。私の役は、私が今年やるので」"
    },
    {
      "type": "line",
      "id": "main.s2.w11.node.line.008b",
      "lineId": "main.s2.w11.line.008b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "——言ってから、自分の言葉に気づく。そうか。再演に勝つ方法は、ひとつしかない。"
    },
    {
      "type": "line",
      "id": "main.s2.w11.node.line.008c",
      "lineId": "main.s2.w11.line.008c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "今年の本物を、去年より面白くすることだ。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "main.s2.w11.node.line.009a",
      "lineId": "main.s2.w11.line.009a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "契約者リーグ——審理の季節が、また来る。",
      "emotion": "resolve"
    },
    {
      "type": "effect",
      "id": "main.s2.w11.node.effect.001",
      "effects": [
        {
          "type": "sharedPoints",
          "amount": 2
        }
      ]
    },
    {
      "type": "end",
      "id": "main.s2.w11.node.end.001",
      "mode": "return-to-week"
    }
  ],
