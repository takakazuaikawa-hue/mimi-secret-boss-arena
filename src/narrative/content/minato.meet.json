  "nodes": [
    {
      "type": "direction",
      "id": "minato.meet.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "minato.meet.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "minato.meet.node.line.001",
      "lineId": "minato.meet.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "今日の担当は遺失物窓口。落とし物の傘が三本、手袋が片方、謎の卵がひとつ。平和な窓口である。午後二時までは、そうだった。"
    },
    {
      "type": "line",
      "id": "minato.meet.node.line.002",
      "lineId": "minato.meet.line.002",
      "speakerId": "legacy.speaker.1vz3er0",
      "speakerName": "ミナト",
      "mode": "dialogue",
      "text": "すみません。落とし物を、届けに来ました。……四十七本、あります。"
    },
    {
      "type": "direction",
      "id": "minato.meet.node.direction.002",
      "command": {
        "type": "still",
        "assetId": "minato.meet.asset.still.001"
      }
    },
    {
      "type": "direction",
      "id": "minato.meet.node.direction.003",
      "command": {
        "type": "effect",
        "effectId": "pulse"
      }
    },
    {
      "type": "line",
      "id": "minato.meet.node.line.003",
      "lineId": "minato.meet.line.003",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "銀青色の髪の人が、台車いっぱいの剣と杖と弓を窓口へ運び込んだ。全部、見るからに神器だった。刀身が勝手に光るし、一本は小声で聖歌を歌っている。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "minato.meet.node.line.004",
      "lineId": "minato.meet.line.004",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "お、落とし物というのは、その、どなたかが落とした物のことでして……これ、あなたの剣では？"
    },
    {
      "type": "line",
      "id": "minato.meet.node.line.005",
      "lineId": "minato.meet.line.005",
      "speakerId": "legacy.speaker.1vz3er0",
      "speakerName": "ミナト",
      "mode": "dialogue",
      "text": "俺のじゃない。世界のです。世界を救い終わったので、返します。"
    },
    {
      "type": "line",
      "id": "minato.meet.node.line.006",
      "lineId": "minato.meet.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "受理伝票の「拾得場所」欄に、彼は丁寧な字で書いた。「魔王城・玉座の間」。窓口の書式が、初めて物語の最終回を受け付けた瞬間だった。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "minato.meet.node.line.007",
      "lineId": "minato.meet.line.007",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "私が四十七枚目の伝票を書き終えた、その時。台車の剣が一本、ふわりと浮いた。まっすぐ、彼の背中の鞘へ帰ろうとする。"
    },
    {
      "type": "direction",
      "id": "minato.meet.node.direction.004",
      "command": {
        "type": "effect",
        "effectId": "shake"
      }
    },
    {
      "type": "line",
      "id": "minato.meet.node.line.008",
      "lineId": "minato.meet.line.008",
      "speakerId": "legacy.speaker.1vz3er0",
      "speakerName": "ミナト",
      "mode": "dialogue",
      "text": "また君か。だめだ。戻るな。俺はもう、勇者じゃ——うわ、全員来るな！"
    },
    {
      "type": "line",
      "id": "minato.meet.node.line.009",
      "lineId": "minato.meet.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "四十七本が、一斉に飛んだ。窓口が流星群の発着場になる。聖剣が私の頭上をかすめた瞬間——目の前に、彼の背中があった。片手で聖剣の柄を受け止めて、私を背にかばっている。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "minato.meet.node.line.010",
      "lineId": "minato.meet.line.010",
      "speakerId": "legacy.speaker.1vz3er0",
      "speakerName": "ミナト",
      "mode": "dialogue",
      "text": "——失礼。窓口の方に怪我をさせたら、返却どころじゃないので。"
    },
    {
      "type": "line",
      "id": "minato.meet.node.line.011",
      "lineId": "minato.meet.line.011",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "近い。背中が近い。心臓がうるさい。そして彼の背中越しに見えた。四十七本の神器が全部、捨てられた子犬の目(比喩)でこちらを見ている。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "minato.meet.node.line.012",
      "lineId": "minato.meet.line.012",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "……この子たち、あなたのことが大好きなんですね。"
    },
    {
      "type": "line",
      "id": "minato.meet.node.line.013",
      "lineId": "minato.meet.line.013",
      "speakerId": "legacy.speaker.1vz3er0",
      "speakerName": "ミナト",
      "mode": "dialogue",
      "text": "困るんです。俺が持っていると、世界がまだ終わっていない気がしてしまうから。……俺の物語は、もう終わったのに。"
    },
    {
      "type": "line",
      "id": "minato.meet.node.line.014",
      "lineId": "minato.meet.line.014",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "終わったのに、と言う声が、少しだけ迷子だった。世界を救い終えた人は、次の朝、何をすればいいんだろう。四十七本の剣と一緒に、その答えもここへ届いた気がした。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "minato.meet.node.line.015",
      "lineId": "minato.meet.line.015",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "とりあえず窓口として、聞くべきことは一つ。この四十七本の「持ち主不明期間」を、どう過ごしてもらうかだ。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "minato.meet.node.choice.001",
      "choices": [
        {
          "id": "minato.meet.choice.001",
          "label": "返した四十七本の由来を聞く",
          "result": "閉店まで、四十七本ぶんの物語を聞いた。竜を落とした弓、海を割った杖、最後まで抜かなかった剣。全部の話の終わりで、彼は同じことを言った。「よく働いてくれた」と。道具にねぎらいを言う勇者を、私は初めて見た。四十八枚目の伝票に、私は品名欄へ「疲れた勇者・一名」とこっそり書いて、すぐ消した。",
          "intent": "登録より先に、終わった物語を聞く",
          "promise": "目先の報酬は得ない代わりに、この人が何を終えてきたかを知る。",
          "memory": "四十七本の由来を最後まで聞いた窓口係として、ミナトは私を覚えている。",
          "tone": "tender",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "minato"
              },
              "mode": "add",
              "trust": 7,
              "ownership": -2
            }
          ],
          "goto": "minato.meet.node.effect.001"
        },
        {
          "id": "minato.meet.choice.002",
          "label": "今日はミナトを誘わず、用事へ戻る",
          "result": "伝票は四十七枚、正式に受理した。翌朝、遺失物棚の前で剣が二本、こっそり彼を追いかけようとしていたので、棚に「お迎えは順番に」と張り紙をした。夕方、様子を見に来たミナトがその張り紙を読んで、初めて声を出して笑ったらしい。窓口日誌に、そう書いておいた。",
          "intent": "今日は窓口業務に徹する",
          "promise": "所属選手にはならないが、後の出来事で再会できる。",
          "memory": "剣たちへの張り紙を書いた窓口係のことを、ミナトは覚えている。",
          "tone": "pragmatic",
          "effects": [],
          "goto": "minato.meet.node.effect.001"
        }
      ]
    },
    {
      "type": "effect",
      "id": "minato.meet.node.effect.001",
      "effects": [
        {
          "type": "markEncountered",
          "fighterId": "minato",
          "encountered": true
        },
        {
          "type": "setStoryStage",
          "fighterId": "minato",
          "stage": 1
        }
      ]
    },
    {
