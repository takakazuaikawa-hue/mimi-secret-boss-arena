  "nodes": [
    {
      "type": "line",
      "id": "marian.crisis.node.line.001",
      "lineId": "marian.crisis.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "アルデバラン社から届いた契約確認書には、マリアンの扱いを決める欄が残っていた。本人の意思を聞くため、使われない霊安室へ向かった。"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.002",
      "lineId": "marian.crisis.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "その週、相手は私を避けた。廊下の向こうに姿を見つけても、業務用の言葉だけを残して先に曲がる。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.003",
      "lineId": "marian.crisis.line.003",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "会社は倒れた選手を何度でも戻す契約を提示した。敗北も負傷もなくせる代わりに、本人が休む権利まで消える。"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.004",
      "lineId": "marian.crisis.line.004",
      "speakerId": "legacy.speaker.quc8xa",
      "speakerName": "マリアン",
      "mode": "dialogue",
      "text": "命令があれば禁じられた術を使えます。責任は所有者へ移る。"
    },
    {
      "type": "direction",
      "id": "marian.crisis.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "marian.crisis.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "direction",
      "id": "marian.crisis.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "shake"
      }
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.005",
      "lineId": "marian.crisis.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "マリアンの返事が短い。怒っている、と決めれば私の不安には名前がつく。でも以前の私も「救えるものを放っておけない優しい聖女なのだ」と決めつけた。また同じ読み違いをするところだった。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.006",
      "lineId": "marian.crisis.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "嫌われたのなら理由を聞けばいい。そう思うのに、治さずに残した契約印の薄い痕を見るたび、聞いた答えで今までの時間が変わるのが怖かった。"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.007",
      "lineId": "marian.crisis.line.007",
      "speakerId": "legacy.speaker.quc8xa",
      "speakerName": "マリアン",
      "mode": "dialogue",
      "text": "命じられれば、誰も死なせません。誰も終われなくなります。"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.008",
      "lineId": "marian.crisis.line.008",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "責任だけじゃなく、判断もあなたに返します。"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.009",
      "lineId": "marian.crisis.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ようやく追いついた場所で、マリアンは救える命を一つも見捨てず、終わりさえ治療する聖女に戻っていた。近づく前の、何も期待していなかった顔だ。"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.010",
      "lineId": "marian.crisis.line.010",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "勝つたび生き返らせるチームなんて、強いんじゃなくて帰れないだけです。"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.011",
      "lineId": "marian.crisis.line.011",
      "speakerId": "legacy.speaker.quc8xa",
      "speakerName": "マリアン",
      "mode": "dialogue",
      "text": "それは治療より難しい。"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.012",
      "lineId": "marian.crisis.line.012",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "原因は私への不信ではない。助ける力で、本人が終える権利や休む権利まで奪うことから私を遠ざけようとしている。そのやさしさを、やさしいまま受け入れてはいけない気がした。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.013",
      "lineId": "marian.crisis.line.013",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "彼女は包帯を握り、白い布へ初めて深い皺を作った。"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.014",
      "lineId": "marian.crisis.line.014",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "菓子の割れ目まで蘇生してしまい、休憩のおやつが永遠に食べ終わらない。別れ話のように静かな場面なのに、施設全体は最終災害手順へ移行している。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.015",
      "lineId": "marian.crisis.line.015",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "正しい答えを当てることより、間違えたまま命令しないことを選ぶ。私は逃げ道をふさがない位置で止まり、聞きたかったことを短い言葉にした。",
      "emotion": "resolve"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.016",
      "lineId": "marian.crisis.line.016",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "守るために離れるのは、残された側へ選択を渡さない。命令と同じだと告げると、初めて相手の表情が崩れた。",
      "emotion": "resolve"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.017",
      "lineId": "marian.crisis.line.017",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "勝つための答えと、あとで自分を嫌いにならない答えは、同じとは限らない。"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.018",
      "lineId": "marian.crisis.line.018",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "私は勝利を約束しない。安全も約束できない。ただ、治さない選択を怖がりながら、本人の返事を待てることを諦める判断だけは本人へ返すと決めた。"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.019",
      "lineId": "marian.crisis.line.019",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "並んで戻る廊下には、まだ一人分の距離がある。でも今度の沈黙は拒絶ではなく、同じ答えを考えるためのものだった。",
      "emotion": "tender"
    },
    {
      "type": "choice",
      "id": "marian.crisis.node.choice.001",
      "choices": [
        {
          "id": "marian.crisis.choice.001",
          "label": "味方の傷だけを正しく生へ戻す",
          "result": "マリアンは味方三人の名だけを呼び、傷を正しい生へ戻した。祈りの範囲を自分で止めたことが、新しい力になった。",
          "intent": "この人だけの突破法へ賭ける",
          "promise": "予測しにくい方法を試し、この人専用の成長を大きく進める。",
          "memory": "危機で選んだ方法は、契約を解く場面でも二人の共通の記憶として戻る。",
          "tone": "wild",
          "effects": [
            {
              "type": "relationship",
