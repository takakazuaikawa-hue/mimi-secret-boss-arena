  "nodes": [
    {
      "type": "direction",
      "id": "marian.crisis.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "marian.crisis.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.001",
      "lineId": "marian.crisis.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "救護室の扉に、見覚えのない張り紙が増えていた。『二十四時間・奇跡サービス窓口。予約不要、休診日なし』。マリアンさんが貼ったものではない。糊は、まだ乾いていなかった。——黒い角封筒は、その張り紙の下に画鋲で留めてあった。貼ってから、通告する。順番が逆である。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.002",
      "lineId": "marian.crisis.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "治療拒否権の廃止。つまり、「治しますか」と聞く権利の廃止だ。彼女がたった一つ持っている安全装置を、会社は事務用語一行で外そうとしていた。"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.003",
      "lineId": "marian.crisis.line.003",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "改組の告知が出た週、救護室には行列ができた。癖毛を直したい人。若返りたい人。古い思い出の品を直したい人。奇跡の無料販売所に、人は際限なく並ぶ。マリアンは三日間、休みなく治し続けた。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.004",
      "lineId": "marian.crisis.line.004",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "四日目の夜、彼女は霊安室にいた。花を活け替える手が、少し震えていた。診断するまでもない。休み不足。私が月一で判定される、あれの重症版だ。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.005",
      "lineId": "marian.crisis.line.005",
      "speakerId": "legacy.speaker.quc8xa",
      "speakerName": "マリアン",
      "mode": "dialogue",
      "text": "……並んでいる人を、断れないのです。私が断った次の一人が、あの空のベッドの人だったら。……その考えが、頭から、離れない。"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.006",
      "lineId": "marian.crisis.line.006",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "マリアンさん。列を、見てきました。並んでいるのは、癖毛と、若返りと、思い出の品です。……あの日のような誰かは、並んでいません。あなたの怖い記憶が、列の全員を、あの人に見せているだけです。"
    },
    {
      "type": "direction",
      "id": "marian.crisis.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "shake"
      }
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.007",
      "lineId": "marian.crisis.line.007",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "言いすぎたか、と思った。でも彼女は、長い沈黙のあと、初めて診断される側の顔で言った。「……そう、ですね。私は、列の顔を、見ていませんでした。傷しか、見ていなかった」。治している間は、傷しか見えない。彼女自身が言っていた言葉だった。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.008",
      "lineId": "marian.crisis.line.008",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "翌日、救護室に新しい札が掛かった。「本日の治療は、予約制です。緊急の方は、いつでも。緊急でない方は——まず、お話から」。会社の通告への、彼女なりの回答だった。",
      "emotion": "resolve"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.009",
      "lineId": "marian.crisis.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "そして、列の先頭の常連さん——毎週癖毛を直しに来ていたおじいさんに、彼女は初めて言った。「今日は、治しません。代わりに、教えてください。その癖毛、本当に、お嫌いですか」。おじいさんは十分話して、笑って、治さずに帰った。亡くなった奥さんが、その癖毛を好きだったそうだ。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.010",
      "lineId": "marian.crisis.line.010",
      "speakerId": "legacy.speaker.quc8xa",
      "speakerName": "マリアン",
      "mode": "dialogue",
      "text": "……治さないことで、守れるものが、本当にあるのですね。練習では、知っていました。今日、初めて、確かめました。"
    },
    {
      "type": "line",
      "id": "marian.crisis.node.line.011",
      "lineId": "marian.crisis.line.011",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "会社は「サービス低下」と通告してくるだろう。次の試合で、答えを形にする必要がある。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "marian.crisis.node.choice.001",
      "choices": [
        {
          "id": "marian.crisis.choice.001",
          "label": "味方の傷だけを正しく生へ戻す",
          "result": "次の試合、味方が大技を受けて倒れた。会場が静まる中、マリアンは駆け寄って、まず、聞いた。「治しますか」。タオルの端が、握り返される。それから、コイン一枚ぶんの小さな陣が、必要な傷だけを閉じた。過剰でも、無断でもない治療を、満員の観客が見た。翌日の新聞の見出しは「聞いてから治す聖女」。物語資産管理部は、二十四時間営業の稟議を取り下げた。聞く時間は、省略できないからだ。",
          "intent": "「聞いてから治す」を、満員の前で通す",
          "promise": "危険を引き受け、この人専用の成長を最大まで進める。",
          "memory": "満員の会場の「治しますか」を、チームの全員が覚えている。",
          "tone": "wild",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "marian"
              },
              "mode": "add",
              "trust": 12,
              "ownership": -10
            },
            {
              "type": "fighterPoints",
              "target": {
                "type": "fighter",
                "fighterId": "marian"
              },
              "amount": 6
            }
          ],
          "goto": "marian.crisis.node.effect.001"
        },
        {
          "id": "marian.crisis.choice.002",
          "label": "敵の大技を一度『死んだこと』にする",
          "result": "相手のエースの必殺技が放たれた瞬間、マリアンは静かに祈った。技の軌道だけが、生死の境の向こう側へ「亡くなった」。この世から一度だけ弔われた必殺技は、二度と戻らなかった。相手は真っ青になり、審判は前例集を三十分めくった。判定は「有効(ただし前例としない)」。会社はこの力の商品化を検討し、「弔いは売れない」という倫理部の一言で断念したという。",
          "intent": "境を扱う力の、静かな怖さを一度だけ見せる",
          "promise": "本人の重さは残るが、チーム全体へ使える成長を持ち帰る。",
          "memory": "弔われた必殺技の判定文を、審判部は今も保管している。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "marian"
              },
              "mode": "add",
              "trust": -2,
              "ownership": 10
            },
            {
              "type": "sharedPoints",
              "amount": 6
            }
          ],
          "goto": "marian.crisis.node.effect.001"
        }
      ]
    },
    {
