      "id": "cassim-bell.bond.node.choice.001",
      "choices": [
        {
          "id": "cassim-bell.bond.choice.001",
          "label": "倉庫から持ち主不明の弁当箱を探す",
          "result": "見つかったのは百年前の昼食だった。中身は温かく、持ち主は別世界でまだ昼休みを待っていた。",
          "intent": "相手の秘密の勝ち方を試す",
          "promise": "読みにくい作戦になる代わりに、この人だけの成長を大きく進める。",
          "memory": "任せた一戦の手応えが、次に力を見せる理由になる。",
          "tone": "wild",
