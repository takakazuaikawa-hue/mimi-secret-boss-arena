  "nodes": [
    {
      "type": "direction",
      "id": "cassim-bell.bond.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "cassim-bell.bond.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "cassim-bell.bond.node.line.001",
      "lineId": "cassim-bell.bond.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "雨の休日。カシム・ベルが「見せたい場所があります」と言うので、保管庫の奥へついて行った。第七十七棚区画。通称、持ち主不明の谷。"
    },
    {
      "type": "line",
      "id": "cassim-bell.bond.node.line.002",
      "lineId": "cassim-bell.bond.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "そこは、七世界の落とし物の山だった。巨大竜の長靴、海底王の冠、小国騎士の盾、月の傘が三本。全部、百年以上も持ち主が現れない品々らしい。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "cassim-bell.bond.node.line.003",
      "lineId": "cassim-bell.bond.line.003",
      "speakerId": "legacy.speaker.1wuvexi",
      "speakerName": "カシム・ベル",
      "mode": "dialogue",
      "text": "規則では、ここは立入禁止です。ただし——受付係が同伴する茶会は、規則に書かれていません。"
    },
    {
      "type": "line",
      "id": "cassim-bell.bond.node.line.004",
      "lineId": "cassim-bell.bond.line.004",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "カシムさんが規則の隙間を使うの、初めて見ました。"
    },
    {
      "type": "line",
      "id": "cassim-bell.bond.node.line.005",
      "lineId": "cassim-bell.bond.line.005",
      "speakerId": "legacy.speaker.1wuvexi",
      "speakerName": "カシム・ベル",
      "mode": "dialogue",
      "text": "求人票第二条。「休憩は業務」。……業務は、真面目にやる主義です。"
    },
    {
      "type": "direction",
      "id": "cassim-bell.bond.node.direction.003",
      "command": { "type": "still", "assetId": "cassim-bell.bond.asset.still.001" }
    },
    {
      "type": "line",
      "id": "cassim-bell.bond.node.line.006",
      "lineId": "cassim-bell.bond.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "屁理屈の使い方が、いい方向に壊れてきた。私たちは巨大竜の長靴(毛布つき)を椅子にして、月の傘を屋根にして、雨音の中でお茶会を始めた。世界で一番ぜいたくな雨宿りだと思う。",
      "emotion": "tender"
    },
    {
      "type": "direction",
      "id": "cassim-bell.bond.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "pulse"
      }
    },
    {
      "type": "line",
      "id": "cassim-bell.bond.node.line.007",
      "lineId": "cassim-bell.bond.line.007",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "カシムの淹れる紅茶は、受付仕込みの正確さだった。砂時計で蒸らし時間を計り、黒手袋で注ぎ、カップの取っ手を必ずこちらへ向けて出す。所作の一つずつが、七十二時間働く手と同じ手とは思えないほど、静かだ。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "cassim-bell.bond.node.line.008",
      "lineId": "cassim-bell.bond.line.008",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "……接客中じゃないあなたの顔、初めて見た気がします。"
    },
    {
      "type": "direction",
      "id": "cassim-bell.bond.node.direction.004",
      "command": { "type": "still", "assetId": "cassim-bell.bond.asset.still.002" }
    },
    {
      "type": "line",
      "id": "cassim-bell.bond.node.line.009",
      "lineId": "cassim-bell.bond.line.009",
      "speakerId": "legacy.speaker.1wuvexi",
      "speakerName": "カシム・ベル",
      "mode": "dialogue",
      "text": "……お互い様です。あなたも今、兎耳が、完全に休んでいる。"
    },
    {
      "type": "line",
      "id": "cassim-bell.bond.node.line.010",
      "lineId": "cassim-bell.bond.line.010",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "言われて気づいた。接客中の私の耳は、いつも音を拾って立っている。今は、雨音の方へ、くたっと倒れていた。接客者同士にしか見えない休みの形が、お互いの頭の上にあった。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "cassim-bell.bond.node.line.011",
      "lineId": "cassim-bell.bond.line.011",
      "speakerId": "legacy.speaker.1wuvexi",
      "speakerName": "カシム・ベル",
      "mode": "dialogue",
      "text": "この谷の品は、私が受付した子たちです。持ち主は、もう現れないかもしれない。それでも、埃を払って、雨漏りから守って——待つのが、私の仕事でした。"
    },
    {
      "type": "line",
      "id": "cassim-bell.bond.node.line.012",
      "lineId": "cassim-bell.bond.line.012",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "七世界の落とし物の谷は、つまり、この人が誰にも頼まれずに守ってきた、待合室だった。終わった物語の持ち物たちの。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "cassim-bell.bond.node.line.013",
      "lineId": "cassim-bell.bond.line.013",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "お茶のおかわりの前に、午後の過ごし方を決めることにした。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "cassim-bell.bond.node.choice.001",
      "choices": [
        {
          "id": "cassim-bell.bond.choice.001",
          "label": "倉庫から持ち主不明の弁当箱を探す",
          "result": "「そういえば、持ち主不明の弁当箱が三百年もの含めて六個あります」。午後は二人で弁当箱の捜索になった。見つけた六個は、洗って、干して、「本日の茶会用」の札をつけた。持ち主が現れたら返す。現れないうちは、茶会で現役。「保管より、使われる方が、道具は幸せです」とカシムは言った。受付係の哲学が、少し変わった午後だった。",
          "intent": "待つだけの品に、今日の出番を作る",
          "promise": "読みにくい作戦になる代わりに、この人だけの成長を大きく進める。",
          "memory": "茶会用の六個の弁当箱を、二人は「現役組」と呼んでいる。",
          "tone": "wild",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "cassim-bell"
              },
              "mode": "add",
              "trust": 9,
              "ownership": -2
            },
            {
              "type": "fighterPoints",
              "target": {
                "type": "fighter",
                "fighterId": "cassim-bell"
              },
              "amount": 3
            }
          ],
          "goto": "cassim-bell.bond.node.effect.001"
        },
        {
          "id": "cassim-bell.bond.choice.002",
          "label": "味方の大技を一度預かり、使う順番を変える",
          "result": "午後は作戦会議になった。カシムの受付能力は、実は戦術に使える。「味方の大技を、一時的に私が『お預かり』できます。お返しする瞬間を、私が選べる」。技の発動タイミングを受付係が管理するチームが、ここに誕生した。整理券方式の連携技は、リハーサルで新人くんの計測器を今週も煙にした。",
          "intent": "受付の力を、チームの新戦術にする",
          "promise": "茶会は短くなるが、全員へ配れる成長ポイントを得る。",
          "memory": "整理券方式の連携技を、チームは「番号札」と呼んでいる。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "cassim-bell"
              },
