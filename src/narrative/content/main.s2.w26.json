  "nodes": [
    {
      "type": "direction",
      "id": "main.s2.w26.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "main.s2.w26.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "direction",
      "id": "main.s2.w26.node.direction.002",
      "command": {
        "type": "clearSprites"
      }
    },
    {
      "type": "direction",
      "id": "main.s2.w26.node.direction.mimi.opening",
      "command": {
        "type": "show",
        "assetId": "main.s2.w26.asset.sprite.mimi.smile",
        "actorId": "mimi",
        "slot": "left",
        "scale": "tall"
      }
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.001a",
      "lineId": "main.s2.w26.line.001a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "決勝の朝は、約束どおり、まかないの朝ごはんから始めた。"
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.001b",
      "lineId": "main.s2.w26.line.001b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "いつもの席、いつもの味噌汁。二年目の儀式も、もう板についた。"
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.001c",
      "lineId": "main.s2.w26.line.001c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "緊張の量だけが、去年より一杯ぶん多い。味噌汁は、三杯飲んだ。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.002a",
      "lineId": "main.s2.w26.line.002a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "街の大通りは、二つの流れに割れていた。右へ行けば、うちの決勝。"
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.002b",
      "lineId": "main.s2.w26.line.002b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "左へ行けば、世界滅亡ショー。人の流れそのものが、今日の勝負らしい。"
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.002c",
      "lineId": "main.s2.w26.line.002c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "右の列の先頭には、夜明け前から並んだ白ひげの剣士さん。宣言どおり、当日いちばんだった。"
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.003a",
      "lineId": "main.s2.w26.line.003a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「両方は、中継できませんでしたが——わたくし、こちらを選びました!」彼の体は一つで、その一つが、ここにいる。",
      "emotion": "tender"
    },
    {
      "type": "direction",
      "id": "main.s2.w26.node.direction.mimi.shift.001",
      "command": {
        "type": "show",
        "assetId": "main.s2.w26.asset.sprite.mimi.serious",
        "actorId": "mimi",
        "slot": "left",
        "scale": "tall"
      }
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.004a",
      "lineId": "main.s2.w26.line.004a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "相手が、入場してきた。歴代王者選抜が、一列で歩いてくる。"
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.004b",
      "lineId": "main.s2.w26.line.004b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "場内が静まり、地鳴りのようなどよめきが来た。伝説が、目の前の砂を踏んでいるのだ。"
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.004c",
      "lineId": "main.s2.w26.line.004c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "監督席の向かいには、室長。「良い興行に、しましょう」",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.005a",
      "lineId": "main.s2.w26.line.005a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "手帳の一覧を、最後にもう一度開いた。赤線、五本。"
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.005b",
      "lineId": "main.s2.w26.line.005b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "六つ目の「台帳による再演の強制」には——条文が、無い。無いなら、引く場所は決まっている。"
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.005c",
      "lineId": "main.s2.w26.line.005c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "台帳そのものだ。史上最強の再演に、今日の新作で勝つ。"
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.005d",
      "lineId": "main.s2.w26.line.005d",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "記録より記憶が強いことを、満員の証人の前で見せる。",
      "emotion": "resolve"
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.006a",
      "lineId": "main.s2.w26.line.006a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "今日の一戦は——四百年の伝説たちへの、感謝の試合です。"
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.006b",
      "lineId": "main.s2.w26.line.006b",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "全力で勝って、みなさんを、思い出に返します!",
      "emotion": "resolve"
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.007a",
      "lineId": "main.s2.w26.line.007a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "うちの三人が、砂場へ歩き出す。向こうは、四百年ぶんの全盛期。"
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.007b",
      "lineId": "main.s2.w26.line.007b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "違いは、一つだけ。あちらの時間は、記録の日で止まっている。"
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.007c",
      "lineId": "main.s2.w26.line.007c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "こちらの時間は、今日も、明日へ動いている。"
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.007d",
      "lineId": "main.s2.w26.line.007d",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "その差を、これから見せる。耳が、ぴんと立った。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.008a",
      "lineId": "main.s2.w26.line.008a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "銅鑼の前の、最後の静寂。監督席の手すりを、握った。"
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.008b",
      "lineId": "main.s2.w26.line.008b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "フロア長の立ち方。腹から出す声。"
    },
    {
      "type": "line",
      "id": "main.s2.w26.node.line.008c",
      "lineId": "main.s2.w26.line.008c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "育つ手帳。二年ぶんの全部を、この一戦へ。——新作対再演、開演だ。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "main.s2.w26.node.choice.001",
      "choices": [
        {
          "id": "main.s2.w26.choice.001",
          "label": "伝説たちに、深く一礼してから始める",
          "result": "銅鑼の前に、一つだけ挟ませてもらった。うちの全員で、向かいの伝説たちへ、深く一礼。この街の四百年への、礼である。客席の年配の観客たちが、次々に立ち上がって、同じ礼をした。憧れて育った人たちの、四百年ぶんの礼。——再現体たちが、台帳に無いその光景に、ほんの一瞬、動きを止めた。記録の外から始まる試合。それが、こちらの初手である。",
          "intent": "対戦相手ではなく、街の憧れそのものに敬意を払う",
          "promise": "試合が敬意で始まる代わりに、感傷も一緒に背負って戦う",
          "memory": "客席ごと立ち上がった四百年の一礼が、語り草になる",
          "tone": "tender",
          "effects": [
            {
              "type": "sharedPoints",
              "amount": 3
            }
          ],
          "goto": "main.s2.w26.node.end.001"
        },
        {
          "id": "main.s2.w26.choice.002",
          "label": "いつも通り、笑って始める",
          "result": "特別なことは、しない。いつもの合図、いつもの並び、いつもの「さあ、行きましょう」。向こうは四百年の型の完成——こちらは、今日もまだ変わり続ける途中である。完成と、途中。記録と、続き。ガヤ氏が叫んだ。「両者、構えに——おや? 挑戦者の側、なんだか楽しそうだ!」。そう。それが、うちの型です。",
          "intent": "積み重ねた日常を、そのまま武器にする",
          "promise": "平常心で戦える代わりに、派手な立ち上がりは無い",
          "memory": "「今年の側、なんだか楽しそうだ」の実況が残った",
          "tone": "wild",
          "effects": [
            {
              "type": "sharedPoints",
              "amount": 3
            }
          ],
          "goto": "main.s2.w26.node.end.001"
        }
      ]
    },
    {
      "type": "end",
      "id": "main.s2.w26.node.end.001",
      "mode": "return-to-week"
    }
  ],
  "debug": {
