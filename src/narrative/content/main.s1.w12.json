  "title": "契約者リーグ、開廷",
  "summary": "出場資格に異議。何でも開廷する判事の前で、試合が審理になる",
  "ownership": {
    "arcId": "main.stage1"
  },
  "trigger": {
    "actions": ["work", "play", "rest", "search"],
    "when": { "all": [], "any": [], "none": [] },
    "repeat": { "mode": "once-per-run" },
    "priority": 900,
