  "nodes": [
    {
      "type": "direction",
      "id": "main.s3.w25.node.direction.001",
      "command": { "type": "background", "assetId": "main.s3.w25.asset.background.001", "transition": "dissolve" }
    },
    {
      "type": "direction",
