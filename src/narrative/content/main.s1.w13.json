{
  "schemaVersion": 1,
  "id": "main.s1.w13",
  "kind": "opening",
  "title": "封印、解いてみましょう",
  "summary": "中点。全力を出しても大丈夫な場所を、監督が作ると宣言する",
  "ownership": {
    "arcId": "main.stage1"
  },
  "trigger": {
