              },
              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "mumyo",
              "decision": "join"
            }
          ],
          "goto": "mumyo.join.node.end.001"
        },
        {
          "id": "mumyo.join.choice.002",
          "label": "景品番号のまま、展示ケースごと登録する",
          "result": "手続きを急ぎ、登録名は「景品番号・零」のまま、展示ケースごと選手登録した。ケースの鏡に映った顔が、少し呆れていた。「……番号で呼ばれるのは、慣れている」その言葉が、少し重かった。",
          "intent": "次の公式戦へ間に合わせる",
          "promise": "本人の詳細は後回しになるが、誰にでも使える成長ポイントを得る。",
          "memory": "先に席を確保した判断は、チームの始まり方として記録に残る。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "mumyo"
              },
              "mode": "add",
              "trust": 0,
              "ownership": 8
            },
            {
              "type": "sharedPoints",
              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "mumyo",
              "decision": "join"
            }
          ],
          "goto": "mumyo.join.node.end.001"
        },
        {
          "id": "mumyo.join.choice.003",
          "label": "今回は無銘を誘わず、別の機会を待つ",
          "result": "「今回は、見送りましょう」鏡の人物は頷いた。「構わない。待つのは、得意だ」四百年待った人の「得意」は、冗談にならない重さがあった。次は、お茶を持ってくると約束した。",
          "intent": "今回はチームへ誘わない",
          "promise": "今回の所属は見送るが、人物の物語と再会の可能性は失わない。",
          "memory": "勧誘しない選択も尊重されたことを、相手は覚えている。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "recruitmentDecision",
              "fighterId": "mumyo",
              "decision": "decline"
            }
          ],
          "goto": "mumyo.join.node.end.001"
        }
      ]
    },
    {
