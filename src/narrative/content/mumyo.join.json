              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "mumyo",
              "decision": "join"
            }
          ],
          "goto": "mumyo.join.node.end.001"
        },
        {
          "id": "mumyo.join.choice.003",
          "label": "今回は無銘を誘わず、別の機会を待つ",
          "result": "無銘の出場登録は行わなかった。相手は所属せず、それぞれの用事へ戻った。断る選択を残したことだけが、次に会う時まで静かに残った。",
          "intent": "今回はチームへ誘わない",
          "promise": "今回の所属は見送るが、人物の物語と再会の可能性は失わない。",
          "memory": "勧誘しない選択も尊重されたことを、相手は覚えている。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "recruitmentDecision",
              "fighterId": "mumyo",
              "decision": "decline"
            }
          ],
          "goto": "mumyo.join.node.end.001"
        }
      ]
    },
