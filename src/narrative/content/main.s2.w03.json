{
  "schemaVersion": 1,
  "id": "main.s2.w03",
  "kind": "opening",
  "title": "出会い直しの週",
  "summary": "砂の上では向かい合った。人としては、まだ一度も",
  "ownership": {
    "arcId": "main.stage2"
  },
  "trigger": {
