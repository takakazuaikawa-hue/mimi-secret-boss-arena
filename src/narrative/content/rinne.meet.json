  "nodes": [
    {
      "type": "direction",
      "id": "rinne.meet.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "rinne.meet.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "rinne.meet.node.line.001",
      "lineId": "rinne.meet.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "闘技場の裏口で、珍しい追放劇を見た。無一文の女性が、カジノの警備員に丁重に外へ出されている。おかしいのは表情の配役だ。追い出された本人は涼しい顔で、追い出した側の支配人が、真っ青だった。"
    },
    {
      "type": "line",
      "id": "rinne.meet.node.line.002",
      "lineId": "rinne.meet.line.002",
      "speakerId": "legacy.speaker.1vpt9ol",
      "speakerName": "リンネ",
      "mode": "dialogue",
      "text": "追い出された。今日はまだ、一度も賭けてないのに。"
    },
    {
      "type": "line",
      "id": "rinne.meet.node.line.003",
      "lineId": "rinne.meet.line.003",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "一度も賭けていない客を出禁にするカジノが、どこにある。気になって、裏口のベンチに座った彼女の隣、一人ぶん空けたところに腰を下ろした。彼女の手の中で、刻印のないコインが一枚、くるくる回っていた。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "rinne.meet.node.line.004",
      "lineId": "rinne.meet.line.004",
      "speakerId": "legacy.speaker.1vpt9ol",
      "speakerName": "リンネ",
      "mode": "dialogue",
      "text": "勝ちすぎたんじゃないよ。店が勝つ未来を、ひとつずつ避けただけ。"
    },
    {
      "type": "direction",
      "id": "rinne.meet.node.direction.002",
      "command": {
        "type": "still",
        "assetId": "rinne.meet.asset.still.001"
      }
    },
    {
      "type": "direction",
      "id": "rinne.meet.node.direction.003",
      "command": {
        "type": "effect",
        "effectId": "pulse"
      }
    },
    {
      "type": "line",
      "id": "rinne.meet.node.line.005",
      "lineId": "rinne.meet.line.005",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "……それを普通は、勝ちすぎたって言うんじゃないですか。"
    },
    {
      "type": "line",
      "id": "rinne.meet.node.line.006",
      "lineId": "rinne.meet.line.006",
      "speakerId": "legacy.speaker.1vpt9ol",
      "speakerName": "リンネ",
      "mode": "dialogue",
      "text": "違う。勝ってない。負けてもいない。店が勝つ台だけ避けて、一日歩いた。そしたら店の帳簿が、私の散歩に耐えられなくなった。"
    },
    {
      "type": "line",
      "id": "rinne.meet.node.line.007",
      "lineId": "rinne.meet.line.007",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "未来が、見えるのだ。この人には。賭ける前から、当たりも外れも全部。……だとしたら、この人の毎日は、答えを知っているテスト用紙を延々と配られるようなものではないのか。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "rinne.meet.node.line.008",
      "lineId": "rinne.meet.line.008",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "彼女が指で空の財布を弾くと、入っていないはずのコインの音がした。まだ投げていないコインの音、と本人は言った。意味は分からなかったが、その音は妙に澄んでいて、なぜか少し、寂しかった。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "rinne.meet.node.line.009",
      "lineId": "rinne.meet.line.009",
      "speakerId": "legacy.speaker.1vpt9ol",
      "speakerName": "リンネ",
      "mode": "dialogue",
      "text": "あんた、面白いね。私を見て、一歩も引かなかったのは久しぶり。……ああ、違うか。今、半歩引いた。半歩は、初めてだ。"
    },
    {
      "type": "line",
      "id": "rinne.meet.node.line.010",
      "lineId": "rinne.meet.line.010",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "半歩の距離まで数えられていた。心臓に悪い。しかも彼女は、私が次に何を言うかも、たぶんもう見えている。それなのに、私の口が開くのを、わざわざ待っている。答えを知っているのに、聞きたいらしい。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "rinne.meet.node.line.011",
      "lineId": "rinne.meet.line.011",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "別れ際、彼女はベンチに空のコインを一枚、置いていった。「次に会う口実。持ってて」。拾い上げたコインは軽くて、表にも裏にも、まだ何も刻まれていなかった。まだ何も決まっていない、ということらしい。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "rinne.meet.node.choice.001",
      "choices": [
        {
          "id": "rinne.meet.choice.001",
          "label": "賭けずに未来の見え方を聞く",
          "result": "「一つだけ教えて。私、この後どうなります?」。リンネは十二秒だけ遠くを見て、答えた。「勝ち筋は教えない。教えると、あんたの筋じゃなくなるから」。その代わり、と彼女は指を三本立てた。「今週の負け方を三つだけ消しといた。転ぶ廊下と、忘れる書類と、こぼす熱いお茶」。予言は三つとも、当たらなかった。避けられたので。",
          "intent": "登録の前に、目の前の相手を知る",
          "promise": "目先の報酬は得ない代わりに、相手が何を望んでいるかを確かめる。",
          "memory": "手続きより先に話を聞いたことを、相手は最初の印象として覚えている。",
          "tone": "tender",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "rinne"
              },
              "mode": "add",
              "trust": 7,
              "ownership": -2
            }
          ],
          "goto": "rinne.meet.node.effect.001"
        },
        {
          "id": "rinne.meet.choice.002",
          "label": "今日はリンネを誘わず、用事へ戻る",
          "result": "名前と、空のコインと、裏口のベンチ。今日はそれだけ持ち帰った。去り際、彼女は振り返らずに言った。「また会うよ。確率は——見ないでおく」。未来の見える人が、見ないでおくと言った。それが何かの始まりの合図に聞こえて、私はコインを強く握った。",
          "intent": "今は勧誘せず、相手との距離を保つ",
          "promise": "所属選手にはならないが、後の出来事で再会できる。",
          "memory": "最初の出会いで急いで仲間にしなかったことが、次の再会へ残る。",
          "tone": "pragmatic",
          "effects": [],
          "goto": "rinne.meet.node.effect.001"
        }
      ]
    },
    {
      "type": "effect",
      "id": "rinne.meet.node.effect.001",
