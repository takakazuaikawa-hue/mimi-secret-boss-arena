  "nodes": [
    {
      "type": "direction",
      "id": "night-eater.join.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "night-eater.join.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.001",
      "lineId": "night-eater.join.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "選手登録の夜。持ち物は携帯端末と、事情を分かってくれる心の広さ。相手はあの、夜を食べるものである。手続きが平和に終わる予感は、最初からなかった。"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.002",
      "lineId": "night-eater.join.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "まず、顔写真で詰まった。何度撮っても、画面は美しい真っ黒。フラッシュを焚いたら、フラッシュが食べられた。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.003",
      "lineId": "night-eater.join.line.003",
      "speakerId": "legacy.speaker.ij983g",
      "speakerName": "夜を食べるもの",
      "mode": "dialogue",
      "text": "……ごちそうさま。強い光だった。五つ星。"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.004",
      "lineId": "night-eater.join.line.004",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "証明写真を食べないでください！！"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.005",
      "lineId": "night-eater.join.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "端末も限界だった。種族欄に「夜」と入力したら、システムは彼女を従業員の夜勤枠として登録しようとした。夜が夜勤。間違ってはいない。間違ってはいないが。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.006",
      "lineId": "night-eater.join.line.006",
      "speakerId": "legacy.speaker.ij983g",
      "speakerName": "夜を食べるもの",
      "mode": "dialogue",
      "text": "夜勤。……悪くない響き。夜は、私の勤務地なので。"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.007",
      "lineId": "night-eater.join.line.007",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "本人が乗り気にならないでください。選手登録です、選手！"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.008",
      "lineId": "night-eater.join.line.008",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "手続きに行き詰まった私たちは、気分転換に遊歩道を歩いた。彼女は歩きながら、街灯を名残惜しそうに見上げる。お腹が空いているのだ。でも、営業中の光は食べない約束を、律儀に守っている。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.009",
      "lineId": "night-eater.join.line.009",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "……この遊歩道、閉園時間過ぎてますね。街灯、もう営業時間外です。"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.010",
      "lineId": "night-eater.join.line.010",
      "speakerId": "legacy.speaker.ij983g",
      "speakerName": "夜を食べるもの",
      "mode": "dialogue",
      "text": "………………いいの？"
    },
    {
      "type": "direction",
      "id": "night-eater.join.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "flash"
      }
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.011",
      "lineId": "night-eater.join.line.011",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "彼女は遊歩道の街灯を、端から一口ずつ、上品に味わっていった。ひとつ消えるたび、頭上に星が増える。全部食べ終わった時、遊歩道は満天の星の下にあった。——都会で、天の川が見えた。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.012",
      "lineId": "night-eater.join.line.012",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "帰り道のカップルが、立ち止まって空を見上げた。「すごい」「初めて見た」。誰かの迷惑だったはずの食事が、誰かの記念日を作っていた。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.013",
      "lineId": "night-eater.join.line.013",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "夜風が吹いて、私が小さくくしゃみをした。次の瞬間、肩にふわりと重みが乗った。星空の外套。内側は、真夏の夜みたいに暖かかった。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.014",
      "lineId": "night-eater.join.line.014",
      "speakerId": "legacy.speaker.ij983g",
      "speakerName": "夜を食べるもの",
      "mode": "dialogue",
      "text": "夜は冷える。……私の夜は、冷やさない。"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.015",
      "lineId": "night-eater.join.line.015",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "外套の内側で、心臓が二拍ぶん飛んだ。この人の夜は、確かに冷たくない。それどころか、ちょっと心臓に悪い。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.016",
      "lineId": "night-eater.join.line.016",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "星空の下で、私は登録画面をもう一度開いた。顔写真の欄には、さっき撮れた一枚を入れる。真っ黒な画面に、星がふたつ写っている写真だ。本人確認、これ以上なく本人である。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "night-eater.join.node.choice.001",
      "choices": [
        {
          "id": "night-eater.join.choice.001",
          "label": "照明を一列消し、影が話せる席を作る",
          "result": "登録の残りは、星明かりの下のベンチで済ませた。得意技の欄に、彼女は自分で「閉店」と書いた。「どんな相手の試合も、私が閉店させるので」。プロフィールとして満点だった。帰り際、外套を返そうとしたら「次の夜まで貸しておく」と言われた。次の夜の約束が、こうして一つできた。",
          "intent": "本人のままで登録できる形を作る",
          "promise": "登録は少し遅れるが、この人専用の成長ポイントを得る。",
          "memory": "星ふたつの証明写真を、二人ともお気に入りだと思っている。",
          "tone": "tender",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "night-eater"
              },
              "mode": "add",
              "trust": 8,
              "ownership": -3
            },
            {
              "type": "fighterPoints",
              "target": {
                "type": "fighter",
                "fighterId": "night-eater"
              },
              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "night-eater",
              "decision": "join"
            }
          ],
          "goto": "night-eater.join.node.end.001"
        },
        {
          "id": "night-eater.join.choice.002",
          "label": "閉店作業の担当として、勤務表へ影を登録する",
          "result": "選手登録と同時に、彼女は本当に夜勤の閉店担当にもなった(本人の強い希望)。以来、うちの閉店作業は三十分早く終わる。彼女が最後の照明を「いただきます」で消すと、フロアが一瞬で星空になり、お客様が自主的に帰り支度を始めるからだ。世界一美しい蛍の光である。",
          "intent": "本人の望む夜勤も、正式な仕事にする",
          "promise": "本人の詳細は後回しになるが、誰にでも使える成長ポイントを得る。",
          "memory": "閉店担当の辞令を、彼女は額に入れて夜空に飾っている。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "night-eater"
              },
              "mode": "add",
              "trust": 0,
              "ownership": 8
            },
            {
              "type": "sharedPoints",
              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "night-eater",
              "decision": "join"
            }
          ],
          "goto": "night-eater.join.node.end.001"
        },
        {
          "id": "night-eater.join.choice.003",
          "label": "今回は夜を食べるものを誘わず、別の機会を待つ",
          "result": "「登録は、またの機会にしましょう」。彼女は星空を見上げて、静かにうなずいた。「急がない。夜は、長いので」。別れ際、外套だけは肩に残された。「冷えるといけないから」。優しさの押し売りが、夜の色をしていた。",
          "intent": "今回はチームへ誘わない",
          "promise": "今回の所属は見送るが、人物の物語と再会の可能性は失わない。",
          "memory": "貸したままの外套を、二人とも返却期限なしだと思っている。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "recruitmentDecision",
              "fighterId": "night-eater",
              "decision": "decline"
            }
          ],
          "goto": "night-eater.join.node.end.001"
        }
      ]
    },
    {
