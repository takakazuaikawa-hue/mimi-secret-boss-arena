      }
    ]
  },
  "nodes": [
    {
      "type": "direction",
      "id": "night-eater.join.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "night-eater.join.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "direction",
      "id": "night-eater.join.node.direction.character.001",
      "command": {
        "type": "show",
        "assetId": "night-eater.join.asset.sprite.character",
        "actorId": "night-eater",
        "slot": "right",
        "scale": "standard"
      }
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.001a",
      "lineId": "night-eater.join.line.001a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "選手登録の夜。持ち物は携帯端末と、心の広さ。"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.001b",
      "lineId": "night-eater.join.line.001b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "相手は、あの夜を食べるもの。平和に終わる予感は、最初からなかった。"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.002a",
      "lineId": "night-eater.join.line.002a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "まず、顔写真で詰まった。何度撮っても、画面は美しい真っ黒。"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.002b",
      "lineId": "night-eater.join.line.002b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "フラッシュを焚いたら、フラッシュが食べられた。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.003a",
      "lineId": "night-eater.join.line.003a",
      "speakerId": "legacy.speaker.ij983g",
      "speakerName": "夜を食べるもの",
      "mode": "dialogue",
      "text": "……ごちそうさま。強い光だった。五つ星。"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.004a",
      "lineId": "night-eater.join.line.004a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "証明写真を食べないでください!!"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.005a",
      "lineId": "night-eater.join.line.005a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "端末も限界だった。種族欄に「夜」と入力してみた。"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.005b",
      "lineId": "night-eater.join.line.005b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "システムが、彼女を夜勤枠として登録しようとする。"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.005c",
      "lineId": "night-eater.join.line.005c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "夜が、夜勤。間違ってはいないけど。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.006a",
      "lineId": "night-eater.join.line.006a",
      "speakerId": "legacy.speaker.ij983g",
      "speakerName": "夜を食べるもの",
      "mode": "dialogue",
      "text": "夜勤。……悪くない響き。夜は、私の勤務地なので。"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.007a",
      "lineId": "night-eater.join.line.007a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "本人が乗り気にならないでください。選手登録です、選手!"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.008a",
      "lineId": "night-eater.join.line.008a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "行き詰まって、気分転換に遊歩道を歩いた。彼女は歩きながら、街灯を名残惜しそうに見上げる。"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.008b",
      "lineId": "night-eater.join.line.008b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "お腹が空いているくせに、営業中の光は食べない。律儀な人。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.009a",
      "lineId": "night-eater.join.line.009a",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "……この遊歩道、閉園時間過ぎてますね。街灯、もう営業時間外です。"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.010a",
      "lineId": "night-eater.join.line.010a",
      "speakerId": "legacy.speaker.ij983g",
      "speakerName": "夜を食べるもの",
      "mode": "dialogue",
      "text": "………………いいの?"
    },
    {
      "type": "direction",
      "id": "night-eater.join.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "flash"
      }
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.011a",
      "lineId": "night-eater.join.line.011a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "彼女は街灯を、端から一口ずつ、上品に味わっていった。ひとつ消えるたび、頭上に星が増える。"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.011b",
      "lineId": "night-eater.join.line.011b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "食べ終わる頃、遊歩道は満天の星の下——都会で、天の川が見えた。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.012a",
      "lineId": "night-eater.join.line.012a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "帰り道のカップルが、立ち止まって空を見上げた。「すごい」"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.012b",
      "lineId": "night-eater.join.line.012b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "「初めて見た」と、二人が言う。誰かの迷惑が、誰かの記念日になっていた。",
      "emotion": "tender"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.013a",
      "lineId": "night-eater.join.line.013a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "夜風が吹いて、耳が震えた。くしゃみが出た。"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.013b",
      "lineId": "night-eater.join.line.013b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "次の瞬間、肩に、ふわりと重みが乗った。"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.013c",
      "lineId": "night-eater.join.line.013c",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "星空の外套。内側は、真夏の夜みたいに暖かい。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.014a",
      "lineId": "night-eater.join.line.014a",
      "speakerId": "legacy.speaker.ij983g",
      "speakerName": "夜を食べるもの",
      "mode": "dialogue",
      "text": "夜は冷える。……私の夜は、冷やさない。"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.015a",
      "lineId": "night-eater.join.line.015a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "外套の内側で、心臓が、二拍ぶん飛んだ。"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.015b",
      "lineId": "night-eater.join.line.015b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "この人の夜は、確かに冷たくない。むしろ、心臓に悪い。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.016a",
      "lineId": "night-eater.join.line.016a",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "星空の下、登録画面をもう一度開いた。顔写真の欄に、さっき撮れた一枚を入れる。"
    },
    {
      "type": "line",
      "id": "night-eater.join.node.line.016b",
      "lineId": "night-eater.join.line.016b",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "真っ黒な画面に、星がふたつ。これ以上ないくらい、本人確認。",
      "emotion": "resolve"
    },
    {
      "type": "choice",
      "id": "night-eater.join.node.choice.001",
      "choices": [
        {
          "id": "night-eater.join.choice.001",
          "label": "照明を一列消し、影が話せる席を作る",
          "result": "登録の残りは星明かりのベンチで済ませた。得意技の欄に、彼女は「閉店」と自分で書いた。「どんな相手も、私が閉店させる」——満点の一行。外套を返そうとしたら「次の夜まで貸しておく」——約束が、また一つできた。",
          "intent": "本人のままで登録できる形を作る",
          "promise": "登録は少し遅れるが、この人専用の成長ポイントを得る。",
          "memory": "星ふたつの証明写真を、二人ともお気に入りだと思っている。",
          "tone": "tender",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "night-eater"
              },
              "mode": "add",
              "trust": 8,
              "ownership": -3
            },
            {
              "type": "fighterPoints",
              "target": {
                "type": "fighter",
                "fighterId": "night-eater"
              },
              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "night-eater",
              "decision": "join"
            }
          ],
          "goto": "night-eater.join.node.end.001"
        },
        {
          "id": "night-eater.join.choice.002",
          "label": "閉店作業の担当として、勤務表へ影を登録する",
          "result": "選手登録と同時に、夜勤の閉店担当にもなった（本人の強い希望）。以来、閉店作業は三十分早い。最後の照明を「いただきます」で消すと、フロアが星空になり、お客様が帰り支度を始める。世界一美しい蛍の光。",
          "intent": "本人の望む夜勤も、正式な仕事にする",
          "promise": "本人の詳細は後回しになるが、誰にでも使える成長ポイントを得る。",
          "memory": "閉店担当の辞令を、彼女は額に入れて夜空に飾っている。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "night-eater"
              },
              "mode": "add",
              "trust": 0,
              "ownership": 8
            },
            {
              "type": "sharedPoints",
              "amount": 2
            },
            {
              "type": "recruitmentDecision",
              "fighterId": "night-eater",
              "decision": "join"
            }
          ],
          "goto": "night-eater.join.node.end.001"
        },
        {
          "id": "night-eater.join.choice.003",
          "label": "今回は夜を食べるものを誘わず、別の機会を待つ",
          "result": "「登録は、またの機会に」——彼女は星空を見上げ、静かにうなずいた。急がない、夜は長いから、と。別れ際、外套だけ肩に残された。冷えるといけないから、と。優しさの押し売りが、夜の色をしていた。",
          "intent": "今回はチームへ誘わない",
          "promise": "今回の所属は見送るが、人物の物語と再会の可能性は失わない。",
          "memory": "貸したままの外套を、二人とも返却期限なしだと思っている。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "recruitmentDecision",
              "fighterId": "night-eater",
              "decision": "decline"
            }
          ],
          "goto": "night-eater.join.node.end.001"
        }
      ]
    },
    {
