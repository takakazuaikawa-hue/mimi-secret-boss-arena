{
  "schemaVersion": 1,
  "id": "sazanami.meet",
  "kind": "character",
  "title": "青のり、四十二点",
  "summary": "閉館後の館内水槽。弁当を採点する泡文字と、波浪注意報",
  "ownership": {
    "arcId": "character.sazanami",
    "characterId": "sazanami",
