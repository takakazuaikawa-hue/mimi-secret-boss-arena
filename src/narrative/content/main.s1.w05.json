{
  "schemaVersion": 1,
  "id": "main.s1.w05",
  "kind": "opening",
  "title": "速達は、湯より速い",
  "summary": "温泉への道中。最上級への異常昇格が、山道まで追いかけてくる",
  "ownership": {
    "arcId": "main.stage1"
  },
