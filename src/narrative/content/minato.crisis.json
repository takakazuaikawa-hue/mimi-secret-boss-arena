  "nodes": [
    {
      "type": "line",
      "id": "minato.crisis.node.line.001",
      "lineId": "minato.crisis.line.001",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "アルデバラン社から届いた契約確認書には、ミナトの扱いを決める欄が残っていた。本人の意思を聞くため、搬入口へ向かった。"
    },
    {
      "type": "line",
      "id": "minato.crisis.node.line.002",
      "lineId": "minato.crisis.line.002",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "その週、相手は私を避けた。廊下の向こうに姿を見つけても、業務用の言葉だけを残して先に曲がる。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "minato.crisis.node.line.003",
      "lineId": "minato.crisis.line.003",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "会社の命令書には『勇者機能の再開』とある。人を家電みたいに書く文字は、読んでいるだけで指が冷えた。"
    },
    {
      "type": "line",
      "id": "minato.crisis.node.line.004",
      "lineId": "minato.crisis.line.004",
      "speakerId": "legacy.speaker.1vz3er0",
      "speakerName": "ミナト",
      "mode": "dialogue",
      "text": "命令があれば戦えます。命令がなくても戦えるかは、まだ分からない。"
    },
    {
      "type": "direction",
      "id": "minato.crisis.node.direction.001",
      "command": {
        "type": "background",
        "assetId": "minato.crisis.asset.background.001",
        "transition": "dissolve"
      }
    },
    {
      "type": "direction",
      "id": "minato.crisis.node.direction.002",
      "command": {
        "type": "effect",
        "effectId": "shake"
      }
    },
    {
      "type": "line",
      "id": "minato.crisis.node.line.005",
      "lineId": "minato.crisis.line.005",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ミナトの返事が短い。怒っている、と決めれば私の不安には名前がつく。でも以前の私も「次の使命を渡せば迷わず立ち上がる人なのだ」と決めつけた。また同じ読み違いをするところだった。",
      "emotion": "tension"
    },
    {
      "type": "line",
      "id": "minato.crisis.node.line.006",
      "lineId": "minato.crisis.line.006",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "嫌われたのなら理由を聞けばいい。そう思うのに、柄に小さな花が彫られた短剣を見るたび、聞いた答えで今までの時間が変わるのが怖かった。"
    },
    {
      "type": "line",
      "id": "minato.crisis.node.line.007",
      "lineId": "minato.crisis.line.007",
      "speakerId": "legacy.speaker.1vz3er0",
      "speakerName": "ミナト",
      "mode": "dialogue",
      "text": "命じられれば抜ける。命じられた方が、理由を考えずに済む。"
    },
    {
      "type": "line",
      "id": "minato.crisis.node.line.008",
      "lineId": "minato.crisis.line.008",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "それを試すための試合じゃない。"
    },
    {
      "type": "line",
      "id": "minato.crisis.node.line.009",
      "lineId": "minato.crisis.line.009",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "ようやく追いついた場所で、ミナトは誰かに必要な役目があれば、迷わず正しい方を選べる人に戻っていた。近づく前の、何も期待していなかった顔だ。"
    },
    {
      "type": "line",
      "id": "minato.crisis.node.line.010",
      "lineId": "minato.crisis.line.010",
      "speakerId": "mimi",
      "speakerName": "ミミ",
      "mode": "dialogue",
      "text": "楽だからって、あなたの理由を会社へ預けないでください。私も預かりたくありません。"
    },
    {
      "type": "line",
      "id": "minato.crisis.node.line.011",
      "lineId": "minato.crisis.line.011",
      "speakerId": "legacy.speaker.1vz3er0",
      "speakerName": "ミナト",
      "mode": "dialogue",
      "text": "では、試合の外で答えを探します。"
    },
    {
      "type": "line",
      "id": "minato.crisis.node.line.012",
      "lineId": "minato.crisis.line.012",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "原因は私への不信ではない。勇者でなくなった自分には、帰る場所も選ぶ理由もないことから私を遠ざけようとしている。そのやさしさを、やさしいまま受け入れてはいけない気がした。",
      "emotion": "revelation"
    },
    {
      "type": "line",
      "id": "minato.crisis.node.line.013",
      "lineId": "minato.crisis.line.013",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "返事の代わりに、彼は鞘を机へ横たえた。剣を置く音が、初めて戦いを拒む音に聞こえた。"
    },
    {
      "type": "line",
      "id": "minato.crisis.node.line.014",
      "lineId": "minato.crisis.line.014",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "返却された神器が彼の迷いに反応し、倉庫一棟を戦場の空へ変えてしまう。別れ話のように静かな場面なのに、施設全体は最終災害手順へ移行している。",
      "emotion": "comic"
    },
    {
      "type": "line",
      "id": "minato.crisis.node.line.015",
      "lineId": "minato.crisis.line.015",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "正しい答えを当てることより、間違えたまま命令しないことを選ぶ。私は逃げ道をふさがない位置で止まり、聞きたかったことを短い言葉にした。",
      "emotion": "resolve"
    },
    {
      "type": "line",
      "id": "minato.crisis.node.line.016",
      "lineId": "minato.crisis.line.016",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "守るために離れるのは、残された側へ選択を渡さない。命令と同じだと告げると、初めて相手の表情が崩れた。",
      "emotion": "resolve"
    },
    {
      "type": "line",
      "id": "minato.crisis.node.line.017",
      "lineId": "minato.crisis.line.017",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "勝つための答えと、あとで自分を嫌いにならない答えは、同じとは限らない。"
    },
    {
      "type": "line",
      "id": "minato.crisis.node.line.018",
      "lineId": "minato.crisis.line.018",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "私は勝利を約束しない。安全も約束できない。ただ、誰にも急かされず、昼食と次の旅先を自分で決めることを諦める判断だけは本人へ返すと決めた。"
    },
    {
      "type": "line",
      "id": "minato.crisis.node.line.019",
      "lineId": "minato.crisis.line.019",
      "speakerId": "narrator",
      "mode": "thought",
      "text": "並んで戻る廊下には、まだ一人分の距離がある。でも今度の沈黙は拒絶ではなく、同じ答えを考えるためのものだった。",
      "emotion": "tender"
    },
    {
      "type": "choice",
      "id": "minato.crisis.node.choice.001",
      "choices": [
        {
          "id": "minato.crisis.choice.001",
          "label": "返却済みの四十七本から一振りだけ借り直す",
          "result": "借り直した一振りは、かつて返した時より軽かった。ミナトは救うためではなく、今いる仲間と勝つための一本として構え直した。",
          "intent": "この人だけの突破法へ賭ける",
          "promise": "予測しにくい方法を試し、この人専用の成長を大きく進める。",
          "memory": "危機で選んだ方法は、契約を解く場面でも二人の共通の記憶として戻る。",
          "tone": "wild",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "minato"
              },
              "mode": "add",
              "trust": 12,
              "ownership": -10
            },
            {
              "type": "fighterPoints",
              "target": {
                "type": "fighter",
                "fighterId": "minato"
              },
              "amount": 6
            }
          ],
          "goto": "minato.crisis.node.effect.001"
        },
        {
          "id": "minato.crisis.choice.002",
          "label": "剣を抜かず、鞘と足運びだけで勝つ",
          "result": "剣を抜かずに鞘で受け、足運びで敵の大技を外した。四十七本がなくても残った技を、三人の型へ分けられた。",
          "intent": "全員が使える安全な突破法を作る",
          "promise": "本人だけの切り札は抑え、チーム全体へ使える成長を持ち帰る。",
          "memory": "全員で組み直した手順は、契約を解く場面でも選んだ責任として戻る。",
          "tone": "pragmatic",
          "effects": [
            {
              "type": "relationship",
              "target": {
                "type": "fighter",
                "fighterId": "minato"
              },
              "mode": "add",
              "trust": -2,
              "ownership": 10
            },
            {
              "type": "sharedPoints",
              "amount": 6
            }
          ],
          "goto": "minato.crisis.node.effect.001"
        }
      ]
    },
